---
/** Posts as a reading list: title in the sans, the description in the text serif. */
import { localePath, type Locale } from "@/i18n";
import type { Post } from "@/lib/content";

import DateTime from "./DateTime.astro";

interface Props {
  items: { post: Post; slug: string }[];
  locale: Locale;
}
const { items, locale } = Astro.props;
---

<ul>
  {items.map(({ post, slug }) => (
    <li>
      <a href={localePath(locale, `/writing/${slug}`)} class="group block py-5">
        <DateTime date={post.data.date} locale={locale} class="eyebrow block" />
        <span
          class="mt-1 block text-[1.1875rem] leading-snug font-semibold tracking-[-0.012em] text-balance transition-colors group-hover:text-accent"
          transition:name={`post-title-${slug}`}
        >
          {post.data.title}
        </span>
        <span class="mt-1.5 block font-serif text-[0.98rem] leading-relaxed text-pretty text-muted">
          {post.data.description}
        </span>
      </a>
    </li>
  ))}
</ul>
