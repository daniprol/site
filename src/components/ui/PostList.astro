---
import { localePath, useTranslations, type Locale } from "@/i18n";
import { readingTime, type Post } from "@/lib/content";

import DateTime from "./DateTime.astro";

interface Props {
  items: { post: Post; slug: string }[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const t = useTranslations(locale);
---

<!-- Writing is the hero: title, one line of why, then quiet meta. -->
<ul class="-mx-3">
  {items.map(({ post, slug }) => (
    <li>
      <a
        href={localePath(locale, `/writing/${slug}`)}
        class="group block rounded-lg px-3 py-4 transition-colors hover:bg-surface"
      >
        <h3 class="text-[1.15rem] leading-snug font-bold tracking-tight text-balance sm:text-[1.2rem]">
          <span class="marker-hover" transition:name={`post-title-${slug}`}>
            {post.data.title}
          </span>
        </h3>
        <p class="mt-1 line-clamp-2 text-[0.98rem] text-muted">{post.data.description}</p>
        <p class="mt-2 flex gap-3 font-mono text-xs text-muted">
          <DateTime date={post.data.date} locale={locale} format="short" />
          <span aria-hidden="true">·</span>
          <span>{t("post.readingTime", { n: readingTime(post.body) })}</span>
        </p>
      </a>
    </li>
  ))}
</ul>
