---
import { localePath, type Locale } from "@/i18n";
import type { Post } from "@/lib/content";

import DateTime from "./DateTime.astro";

interface Props {
  items: { post: Post; slug: string }[];
  locale: Locale;
}
const { items, locale } = Astro.props;
---

<ul class="divide-y divide-border">
  {items.map(({ post, slug }) => (
    <li>
      <a
        href={localePath(locale, `/writing/${slug}`)}
        class="group flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
      >
        <span class="group-hover:text-accent" transition:name={`post-title-${slug}`}>
          {post.data.title}
        </span>
        <DateTime date={post.data.date} locale={locale} format="short" class="shrink-0 text-sm text-muted" />
      </a>
    </li>
  ))}
</ul>
