---
/** Posts as a wall of covers. Issue numbers count posts in publication order. */
import Cover from "@/components/cover/Cover.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { getPosts, readingTime, type Post } from "@/lib/content";
import { formatDate } from "@/lib/format";

interface Props {
  items: { post: Post; slug: string }[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const t = useTranslations(locale);
const all = await getPosts(locale);
const issue = (slug: string, date: Date) => {
  const n = all.length - all.findIndex((p) => p.slug === slug);
  return `${t("cover.issue", { n: String(n).padStart(2, "0") })} · ${formatDate(date, locale, "short").replace(/^\d+\s/, "")}`;
};
---

<ul class="wall">
  {items.map(({ post, slug }) => (
    <li>
      <Cover
        slug={slug}
        title={post.data.title}
        kicker={t("nav.writing")}
        issue={issue(slug, post.data.date)}
        lines={[
          t("post.readingTime", { n: readingTime(post.body) }),
          ...post.data.tags.slice(0, 2).map((x) => `#${x}`),
        ]}
        href={localePath(locale, `/writing/${slug}`)}
        transitionName={`cover-${slug}`}
      />
    </li>
  ))}
</ul>
