---
import { localePath, type Locale } from "@/i18n";
import type { Post } from "@/lib/content";

import DateTime from "./DateTime.astro";

interface Props {
  items: { post: Post; slug: string }[];
  locale: Locale;
}
const { items, locale } = Astro.props;
---

<ul class="rows">
  {items.map(({ post, slug }) => (
    <li class="reveal">
      <a href={localePath(locale, `/writing/${slug}`)} class="row grid gap-1 sm:grid-cols-[1fr_auto] sm:gap-6">
        <span class="font-medium tracking-[-0.011em] text-pretty" transition:name={`post-title-${slug}`}>
          {post.data.title}
        </span>
        <span class="meta row-end self-start sm:pt-1">
          <DateTime date={post.data.date} locale={locale} format="short" />
          <span class="row-arrow max-sm:hidden" aria-hidden="true">
            →
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>
