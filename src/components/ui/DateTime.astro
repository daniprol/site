---
/** A date as a <time> element: "20 October 2026" (long) or "20 Oct 2026" (short) in the page's language. */
import type { Locale } from "@/i18n";
import { formatDate, isoDate } from "@/lib/format";

interface Props {
  date: Date;
  locale: Locale;
  format?: "long" | "short";
  class?: string;
}
const { date, locale, format = "long", class: className } = Astro.props;
---

<time datetime={isoDate(date)} class:list={["tabular-nums", className]}>
  {formatDate(date, locale, format)}
</time>
