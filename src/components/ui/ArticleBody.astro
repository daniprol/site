---
/**
 * Long-form layout on the grid: metadata hangs in columns 1–3 (sticky on wide screens),
 * text takes columns 4–10, capped at a 38rem measure so sidenotes fit in the right-hand columns.
 */
interface Props {
  lang?: string;
}
const { lang } = Astro.props;
---

<div class="grid-page mt-10 lg:mt-14">
  <aside class="mb-10 md:col-span-12 lg:col-span-3 lg:mb-0">
    <div class="lg:sticky lg:top-8">
      <slot name="aside" />
    </div>
  </aside>
  <div class="prose-site prose md:col-span-12 lg:col-span-7" {lang}>
    <slot />
  </div>
  <slot name="after" />
</div>
