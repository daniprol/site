---
/** Article metadata as mono values: a wrapped row on phones, a stacked column in the rail on wide screens. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<ul
  class:list={[
    "meta-list flex flex-wrap gap-x-4 gap-y-1 font-mono text-data text-muted tabular-nums lg:flex-col lg:gap-y-2",
    className,
  ]}
>
  <slot />
</ul>
