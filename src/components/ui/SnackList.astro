---
import { render } from "astro:content";

import type { Locale } from "@/i18n";
import type { Snack } from "@/lib/content";

import DateTime from "./DateTime.astro";
import Verdict from "./Verdict.astro";

interface Props {
  items: Snack[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const entries = await Promise.all(items.map(async (snack) => ({ snack, Content: (await render(snack)).Content })));
---

<ol class="flex flex-col">
  {entries.map(({ snack, Content }) => (
    <li
      id={snack.id}
      class="grid gap-1 border-t border-border py-4 first:border-t-0 sm:grid-cols-[6.5rem_1fr] sm:gap-4"
    >
      <DateTime date={snack.data.date} locale={locale} format="iso" class="meta sm:pt-[0.3rem]" />
      <div>
        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          {snack.data.url ? (
            <a href={snack.data.url} data-nav-item class="font-semibold hover:text-accent">
              {snack.data.title}
            </a>
          ) : (
            <span class="font-semibold">{snack.data.title}</span>
          )}
          <Verdict verdict={snack.data.verdict} locale={locale} />
          <span class="meta">{snack.data.kind}</span>
        </p>
        <div class="snack-body mt-1 text-[0.9375rem] leading-relaxed text-muted">
          <Content />
        </div>
      </div>
    </li>
  ))}
</ol>
