---
import type { Locale } from "@/i18n";
import type { Snack } from "@/lib/content";

import SnackCard from "./SnackCard.astro";

interface Props {
  items: Snack[];
  locale: Locale;
}
const { items, locale } = Astro.props;
---

<ol class="grid gap-3 sm:grid-cols-2 sm:gap-4">
  {items.map((snack) => (
    <SnackCard snack={snack} locale={locale} />
  ))}
</ol>
