---
import { render } from "astro:content";

import type { Locale } from "@/i18n";
import type { Snack } from "@/lib/content";

import DateTime from "./DateTime.astro";
import VerdictStamp from "./VerdictStamp.astro";

interface Props {
  items: Snack[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const entries = await Promise.all(items.map(async (snack) => ({ snack, Content: (await render(snack)).Content })));
---

<ol>
  {entries.map(({ snack, Content }) => (
    <li id={snack.id} class="border-t border-border">
      <div class="wrap grid grid-cols-[1fr_auto] gap-x-4 gap-y-2 py-5 sm:grid-cols-[8rem_minmax(0,16rem)_1fr_auto] sm:gap-x-8 sm:py-6">
        <p class="label col-span-2 flex gap-3 sm:col-span-1 sm:flex-col sm:gap-1 sm:pt-1">
          <DateTime date={snack.data.date} locale={locale} format="iso" />
          <span>{snack.data.kind}</span>
        </p>
        <h3 class="snack-title">
          {snack.data.url ? (
            <a href={snack.data.url} class="snack-link">
              {snack.data.title}
              <span aria-hidden="true">↗</span>
            </a>
          ) : (
            snack.data.title
          )}
        </h3>
        <div class="snack-body col-span-2 max-w-[60ch] sm:order-none sm:col-span-1">
          <Content />
        </div>
        <span class="col-start-2 row-start-2 justify-self-end sm:col-start-4 sm:row-start-1 sm:pt-0.5">
          <VerdictStamp verdict={snack.data.verdict} locale={locale} />
        </span>
      </div>
    </li>
  ))}
</ol>

<style>
  .snack-title {
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 105%;
    font-size: 1.375rem;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .snack-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  @media (hover: hover) {
    .snack-link:hover {
      background: var(--color-invert);
      color: var(--color-invert-fg);
      text-decoration: none;
    }
  }
  .snack-body {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
</style>
