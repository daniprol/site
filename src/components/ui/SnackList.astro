---
/** Snacks: a dense log. Date, name, kind and verdict on one line; the note underneath. */
import { render } from "astro:content";

import type { Locale } from "@/i18n";
import type { Snack } from "@/lib/content";

import DateTime from "./DateTime.astro";
import Verdict from "./Verdict.astro";

interface Props {
  items: Snack[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const entries = await Promise.all(items.map(async (snack) => ({ snack, Content: (await render(snack)).Content })));
---

<ol>
  {entries.map(({ snack, Content }) => (
    <li
      id={snack.id}
      class="grid scroll-mt-24 grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-1 border-b border-border py-4 last:border-b-0 md:grid-cols-[7.5rem_minmax(0,1fr)_auto] md:py-5"
    >
      <DateTime
        date={snack.data.date}
        locale={locale}
        format="iso"
        class="label col-span-2 text-muted md:col-span-1 md:row-span-2 md:pt-1.5"
      />
      <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        {snack.data.url ? (
          <a href={snack.data.url} class="text-lg font-semibold tracking-tight transition-colors hover:text-accent">
            <span class="wipe">{snack.data.title}</span>
          </a>
        ) : (
          <span class="text-lg font-semibold tracking-tight">{snack.data.title}</span>
        )}
        <span class="label text-muted">{snack.data.kind}</span>
      </p>
      <div class="pt-0.5 text-right">
        <Verdict verdict={snack.data.verdict} locale={locale} />
      </div>
      <div class="snack-note col-span-2 max-w-[60ch] text-muted md:col-span-1 md:col-start-2">
        <Content />
      </div>
    </li>
  ))}
</ol>
