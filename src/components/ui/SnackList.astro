---
/**
 * Snacks as a datasheet: date · kind · item · verdict.
 * Phones: a meta line (date, kind, verdict) above the item. From sm: four aligned columns with a header row.
 */
import { render } from "astro:content";

import { useTranslations, type Locale } from "@/i18n";
import type { Snack } from "@/lib/content";

import DateTime from "./DateTime.astro";
import VerdictLamp from "./VerdictLamp.astro";

interface Props {
  items: Snack[];
  locale: Locale;
  /** Show the column header row (on wide screens). */
  header?: boolean;
}
const { items, locale, header = false } = Astro.props;
const t = useTranslations(locale);
const entries = await Promise.all(items.map(async (snack) => ({ snack, Content: (await render(snack)).Content })));
const columns = "sm:grid-cols-[7.5rem_5.5rem_minmax(0,1fr)_7rem] sm:gap-x-6";
---

<div>
  {header && (
    <div class:list={["label hidden border-b border-rule py-2.5 text-muted sm:grid", columns]} aria-hidden="true">
      <span>{t("snacks.colDate")}</span>
      <span>{t("snacks.colKind")}</span>
      <span>{t("snacks.colItem")}</span>
      <span class="text-right">{t("snacks.colVerdict")}</span>
    </div>
  )}
  <ol class="divide-y divide-rule">
    {entries.map(({ snack, Content }) => (
      <li id={snack.id} class:list={["tick-row grid grid-cols-[auto_1fr_auto] items-baseline gap-x-3 py-4", columns]}>
        <DateTime
          date={snack.data.date}
          locale={locale}
          format="iso"
          class="font-mono text-data text-muted sm:col-start-1"
        />
        <span class="font-mono text-data text-muted sm:col-start-2">{snack.data.kind}</span>
        <div class="col-span-3 row-start-2 mt-1.5 sm:col-span-1 sm:col-start-3 sm:row-start-1 sm:mt-0">
          {snack.data.url ? (
            <a
              href={snack.data.url}
              class="font-medium underline decoration-rule-strong underline-offset-4 transition-colors duration-(--duration-fast) hover:text-signal hover:decoration-signal"
            >
              {snack.data.title}
            </a>
          ) : (
            <span class="font-medium">{snack.data.title}</span>
          )}
          <div class="snack-body mt-1 text-[0.9375rem] leading-relaxed text-muted">
            <Content />
          </div>
        </div>
        <span class="col-start-3 row-start-1 text-right sm:col-start-4">
          <VerdictLamp verdict={snack.data.verdict} locale={locale} />
        </span>
      </li>
    ))}
  </ol>
</div>
