---
import { render } from "astro:content";

import type { Locale } from "@/i18n";
import type { Snack } from "@/lib/content";

import DateTime from "./DateTime.astro";
import Verdict from "./Verdict.astro";

interface Props {
  items: Snack[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const entries = await Promise.all(items.map(async (snack) => ({ snack, Content: (await render(snack)).Content })));
---

<ol class="border-b border-border">
  {entries.map(({ snack, Content }) => (
    <li id={snack.id} class="snack">
      <p class="snack__meta label text-muted">
        <DateTime date={snack.data.date} locale={locale} format="iso" />
        <span class="uppercase">{snack.data.kind}</span>
      </p>
      <p class="snack__head">
        {snack.data.url ? (
          <a href={snack.data.url} class="snack__title hover:text-accent">
            {snack.data.title}
            <span aria-hidden="true" class="text-muted">
              ↗
            </span>
          </a>
        ) : (
          <span class="snack__title">{snack.data.title}</span>
        )}
        <Verdict verdict={snack.data.verdict} locale={locale} />
      </p>
      <div class="snack__body text-muted">
        <Content />
      </div>
    </li>
  ))}
</ol>

<style>
  .snack {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 48rem) {
    .snack {
      grid-template-columns: 9rem minmax(0, 18rem) minmax(0, 1fr);
      column-gap: 2rem;
      align-items: baseline;
    }
  }
  .snack__meta {
    display: flex;
    gap: 1rem;
  }
  @media (min-width: 48rem) {
    .snack__meta {
      flex-direction: column;
      gap: 0;
    }
  }
  .snack__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
  @media (min-width: 48rem) {
    .snack__head {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
  .snack__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    font-stretch: 90%;
    line-height: 1.1;
  }
  .snack__body {
    max-width: 40rem;
    font-size: 0.96875rem;
    line-height: 1.55;
  }
  .snack__body :global(p + p) {
    margin-top: 0.5em;
  }
</style>
