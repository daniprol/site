---
import { localePath, useTranslations, type Locale } from "@/i18n";
import type { ShelvedSnack } from "@/lib/content";

import DateTime from "./DateTime.astro";
import Verdict from "./Verdict.astro";

interface Props {
  items: ShelvedSnack[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const t = useTranslations(locale);
---

<!-- Compact and calm: verdict glyph in the gutter, title, the one-line take, date. Each row opens the snack. -->
<ol class="-mx-3" data-pagefind-ignore>
  {items.map(({ snack, slug }) => (
    <li>
      <a
        href={localePath(locale, `/snacks/${slug}`)}
        class="group grid grid-cols-[1.9rem_1fr] items-start gap-x-3 rounded-lg px-3 py-3 transition-colors hover:bg-surface"
      >
        <Verdict verdict={snack.data.verdict} locale={locale} variant="symbol" />
        <span class="min-w-0">
          <span class="flex flex-wrap items-baseline gap-x-2.5 gap-y-0.5 pt-0.5">
            <span class="font-bold tracking-tight">
              <span class="marker-hover">{snack.data.title}</span>
            </span>
            <Verdict verdict={snack.data.verdict} locale={locale} />
            <span class="ml-auto font-mono text-xs text-muted">
              {t(`kind.${snack.data.kind}`)} · <DateTime date={snack.data.date} locale={locale} format="short" />
            </span>
          </span>
          {snack.data.take && (
            <span class="mt-0.5 block text-[0.98rem] leading-snug text-muted" lang="en">
              {snack.data.take}
            </span>
          )}
        </span>
      </a>
    </li>
  ))}
</ol>
