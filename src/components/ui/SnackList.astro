---
/** The snacks wall: every snack as a sticky note with its verdict stamped on. */
import { render } from "astro:content";

import type { Locale } from "@/i18n";
import type { Snack } from "@/lib/content";

import DateTime from "./DateTime.astro";
import Stamp from "./Stamp.astro";

interface Props {
  items: Snack[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const entries = await Promise.all(items.map(async (snack) => ({ snack, Content: (await render(snack)).Content })));
const tones = ["yellow", "pink", "sky", "orange"];
const tilts = [-1.6, 1.2, -0.8, 2, -2.2, 0.9];
---

<ol class="wall">
  {entries.map(({ snack, Content }, i) => (
    <li
      id={snack.id}
      class="note sticky"
      data-tone={tones[i % tones.length]}
      style={`--r:${tilts[i % tilts.length]}deg`}
    >
      <p class="meta label">
        <span>{snack.data.kind}</span>
        <DateTime date={snack.data.date} locale={locale} format="iso" />
      </p>
      <h2 class="title">{snack.data.url ? <a href={snack.data.url}>{snack.data.title}</a> : snack.data.title}</h2>
      <div class="text">
        <Content />
      </div>
      <p class="verdict">
        <Stamp verdict={snack.data.verdict} locale={locale} />
      </p>
    </li>
  ))}
</ol>

<style>
  .wall {
    display: grid;
    gap: 1.25rem;
    max-width: 64rem;
    margin-inline: auto;
    padding: 0 0.5rem;
  }
  .note {
    rotate: var(--r);
    padding: 1rem 1.1rem 1rem;
    scroll-margin-top: 2rem;
  }
  /* Phone: notes stagger left and right instead of stacking flush. */
  .note:nth-child(odd) {
    margin-right: 1.5rem;
  }
  .note:nth-child(even) {
    margin-left: 1.5rem;
  }
  .note:target {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    color: var(--color-sticky-ink-soft);
  }
  .title {
    margin-top: 0.5rem;
    font-size: 1.6rem;
    font-weight: 750;
    font-stretch: 88%;
  }
  .title a {
    color: inherit;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .text {
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.45;
  }
  .verdict {
    margin-top: 0.75rem;
    text-align: right;
  }
  @media (min-width: 48rem) {
    .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
    .note:nth-child(odd),
    .note:nth-child(even) {
      margin: 0;
    }
    .note:nth-child(3n + 2) {
      margin-top: 2rem;
    }
  }
</style>
