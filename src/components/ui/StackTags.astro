---
/** A project's stack as small boxed mono values. */
interface Props {
  stack: readonly string[];
  class?: string;
}
const { stack, class: className } = Astro.props;
---

<ul class:list={["flex flex-wrap gap-1.5", className]}>
  {stack.map((item) => (
    <li class="border border-rule px-1.5 py-0.5 font-mono text-[0.75rem] leading-4 text-muted">{item}</li>
  ))}
</ul>
