---
/**
 * A titled block on an index page. A heavy rule spans the grid; the title hangs in
 * columns 1–3 like a running head, the content takes columns 4–12.
 */
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
  /** Optional index shown above the title, e.g. "01". */
  index?: string;
}
const { title, href, linkLabel, index } = Astro.props;
---

<section class="grid-page mt-20 lg:mt-32">
  <div class="border-t-2 border-fg md:col-span-12"></div>
  <header class="flex items-baseline justify-between gap-4 pt-4 pb-2 md:col-span-3 md:block md:pb-0">
    <div>
      {index && <p class="label mb-2 text-accent tabular-nums">{index}</p>}
      <h2 class="text-title font-bold tracking-(--tracking-title)">{title}</h2>
    </div>
    {href && (
      <a href={href} class="group label inline-flex h-11 items-center gap-1.5 text-muted hover:text-fg md:mt-4">
        <span class="wipe">{linkLabel}</span>
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">
          →
        </span>
      </a>
    )}
  </header>
  <div class="md:col-span-9 md:pt-1">
    <slot />
  </div>
</section>
