---
/** A titled block on an index page, with an optional "view all" link. */
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel } = Astro.props;
---

<section class="mt-16 sm:mt-20">
  <div class="mb-2 flex items-baseline justify-between gap-4 border-b border-border pb-2">
    <h2 class="text-[0.9375rem] font-semibold">{title}</h2>
    {href && (
      <a
        href={href}
        class="-my-3 inline-flex min-h-11 items-center text-sm text-muted transition-colors hover:text-accent"
      >
        {linkLabel}{" "}
        <span aria-hidden="true" class="ml-1">
          →
        </span>
      </a>
    )}
  </div>
  <slot />
</section>
