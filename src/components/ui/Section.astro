---
/** A titled block on an index page, with an optional "view all" link. */
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel } = Astro.props;
---

<section class="mt-16 sm:mt-20">
  <div class="mb-2 flex items-baseline justify-between gap-4">
    <h2 class="text-[1.05rem] font-bold tracking-tight">{title}</h2>
    {href && (
      <a href={href} class="group -mr-2 inline-flex min-h-11 items-center px-2 text-sm text-muted hover:text-fg">
        <span class="marker-hover">{linkLabel}</span>
        <span aria-hidden="true" class="ml-1 transition-transform group-hover:translate-x-0.5">
          →
        </span>
      </a>
    )}
  </div>
  <slot />
</section>
