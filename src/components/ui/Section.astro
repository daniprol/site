---
/** A titled block on an index page, with an optional "view all" link. */
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel } = Astro.props;
---

<section class="mt-16">
  <div class="mb-4 flex items-baseline justify-between">
    <h2 class="text-sm font-medium text-muted">{title}</h2>
    {href && (
      <a href={href} class="text-sm text-muted hover:text-fg">
        {linkLabel} →
      </a>
    )}
  </div>
  <slot />
</section>
