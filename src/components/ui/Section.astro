---
/** A titled block on an index page, with an optional "view all" link. */
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel } = Astro.props;
---

<section class="section column">
  <div class="label meta">
    <h2>{title}</h2>
    {href && <a href={href}>{linkLabel}&thinsp;→</a>}
  </div>
  <slot />
</section>

<style>
  .section {
    margin-top: calc(var(--spacing-line) * 2);
  }
  .label {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
  }
  .label h2 {
    font-weight: 400;
  }
  .label a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    margin-block: -8px;
    transition: color 160ms var(--ease-quiet);
  }
  .label a:hover {
    color: var(--color-accent);
  }
</style>
