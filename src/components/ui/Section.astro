---
/**
 * A titled block on an index page, with an optional "view all" link.
 * Left out of search: it only repeats content that has its own page.
 */
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel } = Astro.props;
---

<section class="mt-14 sm:mt-16" data-pagefind-ignore>
  <div class="mb-2 flex items-baseline justify-between gap-4">
    <h2 class="text-[0.9375rem] font-semibold">{title}</h2>
    {href && (
      <a href={href} class="text-[0.9375rem] text-muted hover:text-accent">
        {linkLabel} <span aria-hidden="true">→</span>
      </a>
    )}
  </div>
  <slot />
</section>
