---
import { localePath, useTranslations, type Locale } from "@/i18n";
import type { Project } from "@/lib/content";

interface Props {
  items: Project[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const t = useTranslations(locale);
---

<ul>
  {items.map((project) => (
    <li class="border-t border-border">
      <a href={localePath(locale, `/projects/${project.id}`)} class="inv block" data-cursor={t("cursor.open")}>
        <span class="wrap grid gap-x-10 gap-y-4 py-7 md:grid-cols-[1fr_minmax(16rem,26rem)] md:items-end md:py-10">
          <span class="project-fit">
            <span class="project-name" style={`--chars:${Math.max(project.data.title.length, 5)}`}>
              {project.data.title}
            </span>
          </span>
          <span class="flex flex-col gap-3">
            <span class="max-w-[38ch] text-[1.0625rem] leading-snug">{project.data.summary}</span>
            <span class="label flex flex-wrap gap-x-3">
              <span>{project.data.year}</span>
              {project.data.stack.map((tech) => (
                <span>/ {tech}</span>
              ))}
            </span>
          </span>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* Names fit their column on one line, capped so short ones don't become billboards. */
  .project-fit {
    display: block;
    container-type: inline-size;
  }
  .project-name {
    display: block;
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 118%;
    font-size: min(8.5rem, calc(100cqi / var(--chars) * 1.22));
    line-height: 0.82;
    letter-spacing: -0.035em;
  }
</style>
