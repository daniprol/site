---
import { localePath, type Locale } from "@/i18n";
import type { Project } from "@/lib/content";

interface Props {
  items: Project[];
  locale: Locale;
}
const { items, locale } = Astro.props;
---

<ul class="rows">
  {items.map((project) => (
    <li class="reveal">
      <a href={localePath(locale, `/projects/${project.id}`)} class="row">
        <span class="flex items-baseline justify-between gap-4">
          <span class="font-medium tracking-[-0.011em]">{project.data.title}</span>
          <span class="meta row-end">
            <span>{project.data.year}</span>
            <span class="row-arrow max-sm:hidden" aria-hidden="true">
              →
            </span>
          </span>
        </span>
        <span class="mt-1 block text-[0.9375rem] text-pretty text-muted">{project.data.summary}</span>
        <span class="meta mt-2 flex flex-wrap gap-1.5">
          {project.data.stack.map((tech) => (
            <span class="tag">{tech}</span>
          ))}
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .tag {
    padding: 0.0625rem 0.4375rem;
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
</style>
