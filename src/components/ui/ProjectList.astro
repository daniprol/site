---
/** Projects as a wall of covers, numbered by their order. */
import Cover from "@/components/cover/Cover.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import type { Project } from "@/lib/content";

interface Props {
  items: Project[];
  locale: Locale;
}
const { items, locale } = Astro.props;
const t = useTranslations(locale);
---

<ul class="wall">
  {items.map((project) => (
    <li>
      <Cover
        slug={project.id}
        title={project.data.title}
        kicker={t("cover.project")}
        issue={`${t("cover.issue", { n: String(project.data.order).padStart(2, "0") })} · ${project.data.year}`}
        dek={project.data.summary}
        lines={[project.data.stack.join(" · ")]}
        href={localePath(locale, `/projects/${project.id}`)}
        transitionName={`cover-${project.id}`}
      />
    </li>
  ))}
</ul>
