---
import ProjectSpecimen from "@/components/desk/ProjectSpecimen.astro";
import type { Locale } from "@/i18n";
import type { Project } from "@/lib/content";

interface Props {
  items: Project[];
  locale: Locale;
}
const { items, locale } = Astro.props;
---

<ul class="projects">
  {items.map((project, i) => (
    <li style={`--r:${[-1.4, 1.2, -0.6, 1.8][i % 4]}deg`}>
      <ProjectSpecimen project={project} index={i} locale={locale} />
    </li>
  ))}
</ul>

<style>
  .projects {
    display: grid;
    gap: 2rem 1.5rem;
    max-width: 64rem;
    margin-inline: auto;
    padding: 0.5rem 0.5rem 0;
  }
  li {
    rotate: var(--r);
  }
  @media (min-width: 40rem) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    li:nth-child(even) {
      margin-top: 2.5rem;
    }
  }
</style>
