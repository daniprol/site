---
import { localePath, type Locale } from "@/i18n";
import type { Project } from "@/lib/content";

interface Props {
  items: Project[];
  locale: Locale;
}
const { items, locale } = Astro.props;
---

<ul>
  {items.map((project) => (
    <li class="border-t border-border first:border-t-0">
      <a href={localePath(locale, `/projects/${project.id}`)} class="group block py-5">
        <span class="flex items-baseline justify-between gap-4">
          <span class="text-[1.15rem] font-[650] group-hover:text-accent" style="font-family: var(--font-display)">
            {project.data.title}
          </span>
          <span class="meta">{project.data.year}</span>
        </span>
        <span class="mt-1 block text-muted">{project.data.summary}</span>
        <span class="meta mt-2.5 block">{project.data.stack.join(" · ")}</span>
      </a>
    </li>
  ))}
</ul>
