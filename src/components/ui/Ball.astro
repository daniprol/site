---
/**
 * A tiny basketball: orange disc with seams. Purely decorative.
 * Used for the brand mark and the back-to-top dribble.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 16, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  class:list={["ball", className]}
  fill="none"
  stroke="var(--color-seam)"
  stroke-width="1.4"
>
  <circle cx="12" cy="12" r="10.3" fill="var(--color-ball)"></circle>
  <path d="M12 1.7v20.6M1.7 12h20.6M5 4.8c3.6 3.9 3.6 10.5 0 14.4M19 4.8c-3.6 3.9-3.6 10.5 0 14.4"></path>
</svg>
