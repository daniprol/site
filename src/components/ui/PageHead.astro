---
/** The opening of an index page: a huge department title and a one-line deck. */
interface Props {
  title: string;
  description?: string;
  /** e.g. a count, shown beside the title. */
  aside?: string;
}
const { title, description, aside } = Astro.props;
// Size the title so its longest word fills the phone width without breaking (≈0.98em per extended capital).
const longest = Math.max(...title.split(/\s+/).map((word) => word.length));
const fit = `min(12rem, ${(88 / (longest * 0.98)).toFixed(2)}vw)`;
---

<header class="wrap page-head">
  <div class="border-b-2 border-fg pb-3">
    {aside && <span class="page-aside">{aside}</span>}
    <h1 class="page-title display" style={{ "--fit": fit }}>
      {title}
    </h1>
  </div>
  {description && <p class="page-dek">{description}</p>}
</header>

<style>
  .page-head {
    padding-top: 2.5rem;
    margin-bottom: 2rem;
  }
  .page-title {
    --wdth: 150;
    font-size: var(--fit);
    font-weight: 900;
    line-height: 0.8;
    text-transform: uppercase;
    letter-spacing: -0.04em;
  }
  .page-aside {
    display: block;
    margin-bottom: 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .page-dek {
    max-width: 36ch;
    margin-top: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-style: italic;
    line-height: 1.15;
  }
</style>
