---
/** A snack's verdict: a small chip with a coloured dot. */
import type { Snack } from "@/lib/content";

interface Props {
  verdict: Snack["data"]["verdict"];
  label: string;
}
const { verdict, label } = Astro.props;
---

<span class="verdict" data-verdict={verdict}>
  {label}
</span>

<style>
  .verdict {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.0625rem 0.5rem 0.0625rem 0.4375rem;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    line-height: 1.125rem;
    color: var(--color-muted);
    background: var(--color-surface);
    box-shadow:
      inset 0 0 0 1px var(--color-border),
      inset 0 1px 0 var(--color-highlight);
  }
  .verdict::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--dot);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--dot) 22%, transparent);
  }
  [data-verdict="keep"] {
    --dot: var(--color-keep);
  }
  [data-verdict="maybe"] {
    --dot: var(--color-maybe);
  }
  [data-verdict="drop"] {
    --dot: var(--color-drop);
  }
</style>
