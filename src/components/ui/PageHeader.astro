---
/** Title block for index pages: kinetic display title over a short description. */
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<header class="frame pt-12 pb-10 md:pt-20 md:pb-16">
  <h1 class="page-title display">{title}</h1>
  {description && <p class="mt-6 max-w-xl text-lg text-muted md:ml-[11rem] md:text-xl">{description}</p>}
</header>

<style>
  .page-title {
    font-size: clamp(3rem, 15.5vw, 13rem);
    overflow-wrap: anywhere;
  }
  @keyframes enter {
    from {
      font-stretch: 50%;
      font-weight: 300;
      opacity: 0;
    }
  }
  /* Index titles sit at the top, so they settle on load instead of on scroll. */
  @media (prefers-reduced-motion: no-preference) {
    .page-title {
      animation: enter 1.1s var(--ease-out-expo) both;
    }
  }
</style>
