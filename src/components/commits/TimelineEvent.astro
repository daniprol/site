---
/**
 * A one-line event in an entry's timeline (snacks/[slug].astro): a badge with the state's icon on the thread
 * line, then "merged try/x into toolbox · 3 Nov". Marks the first verdict and every later change.
 */
import DateTime from "@/components/ui/DateTime.astro";
import type { Locale } from "@/i18n";
import type { Verdict } from "@/lib/commits";

import StateIcon from "./StateIcon.astro";

interface Props {
  verdict: Verdict;
  /** The sentence, as trusted build-time HTML from fillHtml. */
  sentenceHtml: string;
  date: Date;
  locale: Locale;
  /** Optional text after the date, e.g. the reading time. */
  extra?: string;
}
const { verdict, sentenceHtml, date, locale, extra } = Astro.props;
---

<p class="pr-event" data-verdict={verdict}>
  <span class="pr-badge" aria-hidden="true">
    <StateIcon verdict={verdict} />
  </span>
  <span>
    <Fragment set:html={sentenceHtml} />
    <span aria-hidden="true"> · </span>
    <DateTime date={date} locale={locale} format="short" />
    {extra && (
      <>
        <span aria-hidden="true"> · </span>
        {extra}
      </>
    )}
  </span>
</p>
