---
/**
 * The three states, drawn as tiny pieces of the history graph: a branch that rejoins the trunk
 * (merged), one that is still out (open), and one that was cut (reverted).
 */
import type { Verdict } from "@/lib/commits";

interface Props {
  verdict: Verdict;
}
const { verdict } = Astro.props;
---

<svg class="cm-icon" viewBox="0 0 16 16" aria-hidden="true">
  <path d="M4.5 1.5v13"></path>
  {verdict === "keep" && (
    <>
      <path d="M11.5 14C11.5 10 4.5 10.5 4.5 6.5" />
      <circle class="solid" cx="4.5" cy="4.6" r="2.5" />
    </>
  )}
  {verdict === "maybe" && (
    <>
      <path d="M4.5 13.5C4.5 10.5 11 11.5 11 8.5" />
      <circle cx="11" cy="6.4" r="2.1" />
    </>
  )}
  {verdict === "drop" && (
    <>
      <path d="M4.5 13.5C4.5 10.5 11 11.5 11 9.5" />
      <path d="M9 4.5l4 4m0-4l-4 4" />
    </>
  )}
</svg>
