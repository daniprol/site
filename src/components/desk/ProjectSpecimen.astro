---
/** A project as a specimen card: cut-paper "screenshot", number, name, one line. */
import { localePath, type Locale } from "@/i18n";
import type { Project } from "@/lib/content";

import CutoutArt from "./CutoutArt.astro";

interface Props {
  project: Project;
  index: number;
  locale: Locale;
}
const { project, index, locale } = Astro.props;
const { title, summary, stack, year } = project.data;
const tapes = ["tape", "tape tape-pink", "tape tape-sky"];
---

<article class:list={["specimen paper", tapes[index % tapes.length]]}>
  <CutoutArt seed={project.id} />
  <div class="body">
    <p class="meta label">
      <span>No. {String(index + 1).padStart(2, "0")}</span>
      <span>{year}</span>
    </p>
    <h3 class="title">
      <a href={localePath(locale, `/projects/${project.id}`)} class="stretched">
        {title}
      </a>
    </h3>
    <p class="summary">{summary}</p>
    <ul class="stack" aria-label="Stack">
      {stack.map((s) => (
        <li class="label">{s}</li>
      ))}
    </ul>
  </div>
</article>

<style>
  .specimen {
    --tape-x: 30%;
    position: relative;
    padding: 0.625rem;
  }
  /* Phone: a letterboxed crop of the picture keeps three specimens from towering. */
  .specimen :global(.art) {
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 64rem) {
    .specimen :global(.art) {
      aspect-ratio: 4 / 3;
    }
  }
  .body {
    padding: 0.875rem 0.375rem 0.375rem;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    color: var(--color-ink-soft);
  }
  .title {
    margin-top: 0.4rem;
    font-size: 2rem;
    font-weight: 750;
    font-stretch: 85%;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .specimen:hover .title a {
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-stamp);
  }
  .summary {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--color-ink-soft);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.875rem;
  }
  .stack li {
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--color-paper-edge);
    color: var(--color-ink-soft);
    font-size: 0.625rem;
  }
</style>
