---
/** A handwritten note on the mat with a drawn arrow. With href it links to the section. */
interface Props {
  text: string;
  href?: string;
  more?: string;
  /** Which way the arrow points. */
  arrow?: "down" | "down-left" | "down-right";
}
const { text, href, more, arrow = "down-right" } = Astro.props;
const paths = {
  down: "M10 4c4 10 3 20-2 30m-6-8 6 8 7-7",
  "down-right": "M4 4c14 2 24 12 26 28m-9-5 9 6 4-10",
  "down-left": "M34 4C20 6 10 16 8 32m-4-10 4 10 9-5",
};
const Tag = href ? "a" : "p";
---

<Tag class="desk-label" href={href}>
  <span class="text hand">{text}</span>
  {more && <span class="more label">{more} →</span>}
  <svg class="arrow" width="40" height="40" viewBox="0 0 40 40" aria-hidden="true">
    <path d={paths[arrow]}></path>
  </svg>
</Tag>

<style>
  .desk-label {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    min-height: 2.75rem;
    color: var(--color-mat-ink);
    text-decoration: none;
  }
  .text {
    font-size: 2rem;
  }
  .more {
    padding: 0.35rem 0.5rem;
    color: var(--color-mat-ink);
    border: 1px solid var(--color-mat-ink-soft);
    border-radius: 2px;
  }
  a.desk-label:hover .more {
    background: var(--color-mat-ink);
    color: var(--color-mat);
  }
  .arrow {
    align-self: flex-end;
    translate: 0 0.9rem;
  }
  .arrow path {
    fill: none;
    stroke: var(--color-mat-ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  @media (min-width: 64rem) {
    .text {
      font-size: 2.4rem;
    }
  }
</style>
