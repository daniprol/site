---
/** A post as an index card. The title morphs into the post header on navigation. */
import DateTime from "@/components/ui/DateTime.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { readingTime, type Post } from "@/lib/content";

interface Props {
  post: Post;
  slug: string;
  index: number;
  locale: Locale;
}
const { post, slug, index, locale } = Astro.props;
const t = useTranslations(locale);
const stocks = ["paper paper-ruled", "paper paper-blue paper-grid", "paper paper-kraft"];
---

<article class:list={["card", stocks[index % stocks.length]]}>
  <span class="clip" aria-hidden="true"></span>
  <p class="meta label">
    <DateTime date={post.data.date} locale={locale} format="short" />
    <span>{t("post.readingTime", { n: readingTime(post.body) })}</span>
  </p>
  <h3 class="title" transition:name={`post-title-${slug}`}>
    <a href={localePath(locale, `/writing/${slug}`)} class="stretched">
      {post.data.title}
    </a>
  </h3>
  <p class="desc">{post.data.description}</p>
</article>

<style>
  .card {
    position: relative;
    padding: 0.95rem 1.1rem 1.25rem;
  }
  .clip {
    position: absolute;
    top: -0.7rem;
    right: 1.5rem;
    width: 0.9rem;
    height: 2.4rem;
    border: 2px solid var(--color-ink-soft);
    border-radius: 999px;
    border-bottom-color: transparent;
    opacity: 0.8;
  }
  .meta {
    display: flex;
    gap: 1rem;
    height: 1.7rem;
    color: var(--color-ink-soft);
  }
  .title {
    margin-top: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    font-stretch: 90%;
    line-height: 1.04;
    text-wrap: balance;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .card:hover .title a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-stamp);
  }
  .desc {
    margin-top: 0.55rem;
    font-size: 0.9375rem;
    line-height: 1.6rem;
    color: var(--color-ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  @media (min-width: 64rem) {
    .title {
      font-size: 1.65rem;
    }
  }
</style>
