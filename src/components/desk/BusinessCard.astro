---
/** Contact details on a business card. */
import { useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
const links = [
  { label: "GitHub", href: site.socials.github },
  { label: "LinkedIn", href: site.socials.linkedin },
  { label: t("footer.rss"), href: "/rss.xml" },
];
---

<article class="bcard paper" aria-label={t("about.contact")}>
  <p class="name">{site.name}</p>
  <p class="role label">{site.role}</p>
  <a class="email" href={`mailto:${site.email}`}>
    {site.email}
  </a>
  <ul class="links">
    {links.map(({ label, href }) => (
      <li>
        <a href={href}>{label} ↗</a>
      </li>
    ))}
  </ul>
</article>

<style>
  .bcard {
    position: relative;
    padding: 1.1rem 1.2rem 0.6rem;
    border-top: 0.5rem solid var(--color-stamp);
  }
  .name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 750;
    font-stretch: 85%;
    letter-spacing: -0.02em;
  }
  .role {
    color: var(--color-ink-soft);
    margin-top: 0.15rem;
  }
  .email {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-link);
    overflow-wrap: anywhere;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    border-top: 1px dashed var(--color-paper-edge);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--color-link);
    text-decoration: underline;
  }
</style>
