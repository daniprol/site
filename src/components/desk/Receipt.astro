---
/** The CV as a till receipt: experience and education, printed in mono. */
import { localePath, useTranslations, type Locale } from "@/i18n";
import { education, experience, site } from "@/site.config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<article class="receipt paper">
  <header class="head">
    <p class="shop">{site.shortName}</p>
    <p>{site.location}</p>
  </header>
  <p class="rule" aria-hidden="true">
    ********************************
  </p>
  <h3 class="section">{t("about.experience")}</h3>
  <ul>
    {experience.map((job) => (
      <li>
        <span>{job.company}</span>
        <span>{job.period}</span>
      </li>
    ))}
  </ul>
  <h3 class="section">{t("about.education")}</h3>
  <ul>
    {education.map((item) => (
      <li>
        <span>{item.degree.replace(/^Degree in /, "")}</span>
        <span>{item.period || "✓"}</span>
      </li>
    ))}
  </ul>
  <p class="rule" aria-hidden="true">
    --------------------------------
  </p>
  <p class="total">
    <a href={localePath(locale, "/about")} class="stretched">
      {t("about.title")} →
    </a>
  </p>
  <p class="barcode" aria-hidden="true"></p>
</article>

<style>
  .receipt {
    position: relative;
    padding: 1.25rem 1.1rem 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.6;
    text-transform: uppercase;
    /* Torn, zig-zag bottom edge. */
    mask:
      linear-gradient(black 0 0) top / 100% calc(100% - 8px) no-repeat,
      conic-gradient(from -45deg at bottom, transparent, black 1deg 89deg, transparent 90deg) bottom / 12px 8px repeat-x;
    filter: drop-shadow(0 10px 12px var(--color-shadow));
    box-shadow: none;
  }
  .head {
    text-align: center;
  }
  .shop {
    font-size: 0.875rem;
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: 0.12em;
  }
  .rule {
    overflow: hidden;
    white-space: nowrap;
    color: var(--color-ink-soft);
    margin-block: 0.5rem;
  }
  .section {
    font-family: var(--font-mono);
    font-size: inherit;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-top: 0.5rem;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
  }
  li span:last-child {
    white-space: nowrap;
  }
  .total {
    font-weight: 800;
    font-size: 0.8125rem;
  }
  .total a {
    color: inherit;
    text-decoration: none;
  }
  .receipt:hover .total a {
    text-decoration: underline;
  }
  .barcode {
    height: 2rem;
    margin-top: 0.75rem;
    background: repeating-linear-gradient(
      90deg,
      var(--color-ink) 0 2px,
      transparent 2px 3px,
      var(--color-ink) 3px 4px,
      transparent 4px 7px,
      var(--color-ink) 7px 10px,
      transparent 10px 11px
    );
  }
</style>
