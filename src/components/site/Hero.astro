---
/**
 * Home poster: role and coordinates up top, the name set edge to edge, and the "now" line.
 * Phones stack the name on two lines that each fill the width; wider screens set it on one.
 * The name's width axis is tied to page scroll (static under reduced motion).
 */
import { useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LocalClock from "../ui/LocalClock.astro";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
const [first = "", last = ""] = site.name.split(" ");
---

<section class="hero">
  <div class="wrap label flex flex-wrap justify-between gap-x-6 gap-y-1 pt-5">
    <span>{site.role}</span>
    <span>{site.location}</span>
    <span class="w-full sm:w-auto">
      <LocalClock />
    </span>
  </div>

  <div class="hero-now wrap">
    <p class="label mb-3">{t("home.now")}</p>
    <p class="now-text text-balance">{site.now}</p>
  </div>

  <h1 class="hero-name" aria-label={site.name}>
    <span class="hero-first" style={`--n:${first.length}`} aria-hidden="true">
      {first}
    </span>
    <span class="hero-last" style={`--n:${last.length}`} aria-hidden="true">
      {last}
    </span>
  </h1>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--spacing-header) - 3.25rem);
    container-type: inline-size;
    overflow: clip;
  }
  .hero-now {
    margin-block: auto 1.75rem;
    padding-top: 3rem;
  }
  .now-text {
    max-width: 22ch;
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 92%;
    font-size: clamp(1.5rem, 6.4cqi, 3.25rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }
  .hero-name {
    font-family: var(--font-display);
    font-weight: 900;
    line-height: 0.76;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    color: var(--color-signal);
    white-space: nowrap;
  }
  .hero-name span {
    display: block;
    font-stretch: 100%;
  }
  /* Each line fills the width on phones; PROL ends up bigger than DANIEL, on purpose. */
  .hero-first {
    font-size: calc(100cqi / var(--n) * 1.36);
    margin-inline-start: -0.06em;
  }
  .hero-last {
    font-size: calc(100cqi / var(--n) * 1.3);
    text-align: end;
    margin-inline-end: -0.07em;
    margin-bottom: -0.1em;
  }
  @media (min-width: 48rem) {
    .hero-name {
      display: flex;
      gap: 0.18em;
      font-size: calc(100cqi / 11 * 1.8);
      margin-inline-start: -0.05em;
      margin-bottom: -0.11em;
    }
    .hero-name span {
      font-size: inherit;
      margin: 0;
    }
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero-first {
        animation: hero-squeeze linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70svh;
      }
      .hero-last {
        animation: hero-widen linear both;
        animation-timeline: scroll(root);
        animation-range: 0 70svh;
      }
    }
  }
  @keyframes hero-squeeze {
    to {
      font-stretch: 60%;
    }
  }
  @keyframes hero-widen {
    to {
      font-stretch: 140%;
    }
  }
</style>
