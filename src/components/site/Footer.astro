---
/** Ink band with the email set huge and cropped: the one call to action on the site. */
import { useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
const [user, domain] = site.email.split("@");
const links = [
  { label: "GitHub", href: site.socials.github },
  { label: "LinkedIn", href: site.socials.linkedin },
  { label: t("footer.rss"), href: "/rss.xml" },
];
---

<footer class="tone-band relative z-10 border-t border-border">
  <div class="wrap pt-14 pb-6 sm:pt-20">
    <p class="label">{t("about.contact")}</p>
  </div>
  <a href={`mailto:${site.email}`} class="mail inv block py-4" data-cursor={t("about.contact")}>
    <span class="wrap block">
      <span class="mail-user">{user}</span>
      <span class="mail-domain">@{domain}</span>
    </span>
  </a>
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-6">
    <p class="label">
      © {new Date().getFullYear()} {site.name} · {site.location}
    </p>
    <nav aria-label="Elsewhere" class="-mx-3 flex">
      {links.map((link) => (
        <a href={link.href} class="label inv flex h-11 items-center px-3">
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .mail {
    container-type: inline-size;
    overflow: clip;
    font-family: var(--font-display);
    font-weight: 850;
    line-height: 0.9;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  /* Fit the local part to the width; the domain follows smaller, like a caption. */
  .mail-user {
    display: block;
    font-stretch: 70%;
    font-size: min(17.5cqi, 13rem);
  }
  .mail-domain {
    display: block;
    font-stretch: 140%;
    font-size: min(7.2cqi, 5.35rem);
    font-weight: 500;
  }
</style>
