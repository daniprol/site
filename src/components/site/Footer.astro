---
import { useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
const links = [
  { label: "GitHub", href: site.socials.github },
  { label: "LinkedIn", href: site.socials.linkedin },
  { label: "Email", href: `mailto:${site.email}` },
  { label: t("footer.rss"), href: "/rss.xml" },
];
---

<footer class="site-footer sheet">
  <div class="rule meta">
    <nav aria-label="Elsewhere" class="links">
      {links.map(({ label, href }) => (
        <a href={href}>{label}</a>
      ))}
    </nav>
    <p class="imprint">
      <span>
        © {new Date().getFullYear()} {site.name}.
      </span>
      <span class="colophon">{t("footer.colophon")}</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: calc(var(--spacing-line) * 4);
  }
  .rule {
    border-top: 1px solid var(--color-border);
    padding-block: 0.75rem 2.5rem;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    margin-left: -0.25rem;
  }
  .links a {
    min-height: 44px;
    display: flex;
    align-items: center;
    padding-inline: 0.25rem;
  }
  .links a:hover {
    color: var(--color-fg);
  }
  .imprint {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.5rem;
  }
  .colophon {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-small);
  }
  @media (min-width: 40rem) {
    .rule {
      display: flex;
      flex-direction: row-reverse;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
