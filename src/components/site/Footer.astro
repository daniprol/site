---
import { useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LanguagePicker from "./LanguagePicker.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const links = [
  { label: "GitHub", href: site.socials.github },
  { label: "LinkedIn", href: site.socials.linkedin },
  { label: "Email", href: `mailto:${site.email}` },
  { label: t("footer.rss"), href: "/rss.xml" },
];
---

<footer class="column mt-24 mb-6">
  <div class="flex flex-col gap-2 border-t border-border pt-4 sm:flex-row sm:items-center sm:justify-between">
    <nav aria-label="Elsewhere" class="-ml-2 flex flex-wrap">
      {links.map(({ label, href }) => (
        <a href={href} class="flex min-h-11 items-center px-2 text-[0.9375rem] text-muted hover:text-fg">
          {label}
        </a>
      ))}
    </nav>
    <LanguagePicker locale={locale} />
  </div>
  <p class="meta mt-2">
    © {new Date().getFullYear()} {site.name}
  </p>
</footer>
