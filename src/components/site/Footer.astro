---
import { useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
const links = [
  { label: "GitHub", href: site.socials.github },
  { label: "LinkedIn", href: site.socials.linkedin },
  { label: "Email", href: `mailto:${site.email}` },
  { label: t("footer.rss"), href: "/rss.xml" },
];
---

<footer class="shell site-footer">
  <div class="rail border-t border-border pt-6">
    <p class="meta rail-label flex min-h-11 items-center">
      © {new Date().getFullYear()} {site.shortName}
    </p>
    <nav aria-label="Elsewhere" class="-ml-3 flex flex-wrap">
      {links.map(({ label, href }) => (
        <a href={href} class="press px-3 text-sm">
          {label}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 6rem;
    /* Room for the floating dock on phones. */
    padding-bottom: calc(var(--dock-h) + 2.5rem + env(safe-area-inset-bottom));
  }
  @media (min-width: 48rem) {
    .site-footer {
      padding-bottom: 3rem;
    }
  }
  .rail > .rail-label {
    position: static;
  }
</style>
