---
import { useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import SantiagoClock from "./SantiagoClock.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const links = [
  { label: "GitHub", href: site.socials.github },
  { label: "LinkedIn", href: site.socials.linkedin },
  { label: "Email", href: `mailto:${site.email}` },
  { label: t("footer.rss"), href: "/rss.xml" },
];
---

<footer class="mx-auto mt-24 w-full max-w-column px-5 pb-10 text-sm text-muted">
  <span class="tide mb-8" aria-hidden="true"></span>
  <SantiagoClock locale={locale} />
  <p class="mt-1 font-mono text-xs">42.88° N, 8.54° W</p>
  <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
    <nav aria-label="Elsewhere" class="-ml-2 flex flex-wrap">
      {links.map(({ label, href }) => (
        <a href={href} class="inline-flex min-h-11 items-center px-2 transition-colors hover:text-fg">
          {label}
        </a>
      ))}
    </nav>
    <p>
      © {new Date().getFullYear()} {site.name}
    </p>
  </div>
</footer>
