---
import { localePath, stripLocale, useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LanguagePicker from "./LanguagePicker.astro";
import MobileMenu from "./MobileMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
---

<header class="site-header">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={localePath(locale)} class="wordmark display">
      {site.name.split(" ")[0]}
      <span>{site.name.split(" ").slice(1).join(" ")}</span>
    </a>
    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {site.nav.map(({ key, href }) => (
          <li>
            <a
              href={localePath(locale, href)}
              aria-current={current.startsWith(href) ? "page" : undefined}
              class="nav-link"
            >
              {t(key)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="hidden items-center gap-2 md:flex">
      <LanguagePicker locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
    <MobileMenu locale={locale} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 2px solid var(--color-fg);
  }
  .wordmark {
    --wdth: 125;
    display: inline-flex;
    gap: 0.22em;
    min-height: 44px;
    align-items: center;
    font-size: 1.25rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .wordmark span {
    color: var(--color-accent);
  }
  .nav-link {
    --wdth: 110;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding-inline: 0.85rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    font-variation-settings: "wdth" var(--wdth);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .nav-link:hover {
    color: var(--color-accent);
  }
  .nav-link[aria-current="page"] {
    background: var(--color-fg);
    color: var(--color-bg);
  }
</style>
