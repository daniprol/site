---
/**
 * Masthead. From 64rem the nav sits inline on the grid; below that a "Menu" button opens
 * a full-screen popover (native popover API, no JS).
 */
import { localePath, stripLocale, useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LanguagePicker from "./LanguagePicker.astro";
import MobileMenu from "./MobileMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
---

<header class="grid-page h-16 items-center lg:h-20">
  <div class="flex items-center justify-between md:col-span-12 lg:col-span-3">
    <Wordmark locale={locale} />
    <button
      type="button"
      popovertarget="site-menu"
      class="label -mr-3 flex h-11 cursor-pointer items-center gap-2 px-3 text-fg lg:hidden"
    >
      <span aria-hidden="true" class="flex w-4 flex-col gap-1">
        <span class="h-0.5 bg-current"></span>
        <span class="h-0.5 bg-current"></span>
      </span>
      {t("nav.menu")}
    </button>
  </div>

  <nav aria-label="Main" class="hidden lg:col-span-6 lg:block">
    <ul class="flex gap-8">
      {site.nav.map(({ key, href }, i) => {
        const active = current.startsWith(href);
        return (
          <li>
            <a
              href={localePath(locale, href)}
              aria-current={active ? "page" : undefined}
              class:list={[
                "group flex h-11 items-baseline gap-2 pt-3 text-[0.9375rem] font-medium",
                active ? "text-accent" : "text-fg hover:text-accent",
              ]}
            >
              <span class="font-mono text-[0.6875rem] text-muted tabular-nums">{String(i + 1).padStart(2, "0")}</span>
              <span class="wipe">{t(key)}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>

  <div class="hidden items-center justify-end gap-6 lg:col-span-3 lg:flex">
    <LanguagePicker locale={locale} />
    <ThemeToggle locale={locale} />
  </div>
</header>

<MobileMenu locale={locale} current={current} />
