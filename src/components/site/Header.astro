---
import { localePath, stripLocale, useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LanguagePicker from "./LanguagePicker.astro";
import MobileMenu from "./MobileMenu.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  locale: Locale;
  overlay?: boolean;
}
const { locale, overlay = false } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
---

<header class:list={["site-header", { "site-header--overlay": overlay }]}>
  <div class="frame flex h-(--header-h) items-center justify-between gap-6">
    <Wordmark href={localePath(locale)} />
    <nav aria-label="Main" class="hidden items-center gap-7 md:flex">
      {site.nav.map(({ key, href }) => (
        <a
          href={localePath(locale, href)}
          aria-current={current.startsWith(href) ? "page" : undefined}
          class="nav-link"
        >
          {t(key)}
        </a>
      ))}
    </nav>
    <div class="flex items-center gap-1 md:gap-5">
      <div class="hidden md:block">
        <LanguagePicker locale={locale} />
      </div>
      <ThemeToggle locale={locale} />
      <MobileMenu locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--color-border);
  }
  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
    color: var(--color-on-field);
    border-color: color-mix(in oklab, var(--color-on-field) 30%, transparent);
    --color-muted: color-mix(in oklab, var(--color-on-field) 78%, transparent);
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease-out-expo);
  }
  .nav-link:hover::after {
    transform: scaleX(1);
  }
  .nav-link[aria-current="page"]::before {
    content: "";
    width: 7px;
    height: 7px;
    margin-right: 0.5rem;
    background: var(--color-flare);
  }
</style>
