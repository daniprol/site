---
import { localePath, stripLocale, useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LanguagePicker from "./LanguagePicker.astro";
import Logo from "./Logo.astro";
import SearchButton from "./SearchButton.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
---

<!--
  Phones: wordmark and controls on one row, the four sections as a row of tabs below, each as wide as its label.
  From 48rem: everything on one line.
-->
<header class="mx-auto w-full max-w-column px-4 pt-3 sm:px-6 md:flex md:items-center md:gap-6 md:pt-8">
  <div class="flex items-center justify-between gap-1 md:contents">
    <a href={localePath(locale)} class="-ml-1 flex min-h-11 items-center rounded-md px-1">
      <Logo class="h-[23px] w-auto min-[400px]:h-[26px] md:h-7" />
    </a>
    <div class="flex items-center md:order-last">
      <SearchButton locale={locale} />
      <LanguagePicker locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
  <nav
    aria-label="Main"
    class="mt-1 grid grid-cols-[repeat(4,auto)] border-y border-border md:mt-0 md:ml-auto md:flex md:gap-1 md:border-0"
  >
    {site.nav.map(({ key, href }) => {
      const active = current.startsWith(href);
      return (
        <a
          href={localePath(locale, href)}
          aria-current={active ? "page" : undefined}
          class:list={[
            "group flex min-h-11 items-center justify-center px-0.5 text-[0.875rem] whitespace-nowrap transition-colors min-[360px]:px-1 min-[360px]:text-[0.95rem] md:px-3",
            active ? "font-semibold text-fg" : "text-muted hover:text-fg",
          ]}
        >
          <span class:list={[active ? "marker" : "marker-hover"]}>{t(key)}</span>
        </a>
      );
    })}
  </nav>
</header>
