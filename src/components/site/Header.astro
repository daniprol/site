---
/**
 * Site header. Phones get two rows: name and controls on top, the four sections spread
 * across a full-width row of 44px targets below. From sm up it collapses into one line.
 */
import { localePath, stripLocale, useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LanguagePicker from "./LanguagePicker.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
---

<header class="mx-auto w-full max-w-column px-5 pt-4 sm:pt-8">
  <div class="flex flex-wrap items-center justify-between gap-x-6">
    <a
      href={localePath(locale)}
      class="-ml-1 inline-flex min-h-11 items-center px-1 text-[1.0625rem] font-semibold tracking-[-0.01em]"
    >
      {site.name}
    </a>
    <nav
      aria-label="Main"
      class="order-last -mx-2 mt-1 flex w-[calc(100%+1rem)] justify-between border-y border-border sm:order-none sm:mx-0 sm:mt-0 sm:ml-auto sm:w-auto sm:justify-start sm:gap-1 sm:border-0"
    >
      {site.nav.map(({ key, href }) => {
        const active = current.startsWith(href);
        return (
          <a
            href={localePath(locale, href)}
            aria-current={active ? "page" : undefined}
            class:list={[
              "nav-link inline-flex min-h-11 items-center px-2 text-[0.9375rem] transition-colors hover:text-fg",
              active ? "text-fg" : "text-muted",
            ]}
          >
            {t(key)}
          </a>
        );
      })}
    </nav>
    <div class="-mr-2 flex items-center">
      <LanguagePicker locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  /* The current section gets a short sea-coloured underline. */
  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
</style>
