---
/** A small cut-paper shape that marks each nav section: half circle, square, circle, triangle. */
interface Props {
  index: number;
}
const shapes = [
  { d: "M2 13a8 8 0 0 1 16 0Z", fill: "var(--color-cobalt)" },
  { d: "M4 4h12v12H4Z", fill: "var(--color-sticky-orange)" },
  { d: "M10 2a8 8 0 1 1 0 16a8 8 0 0 1 0-16Z", fill: "var(--color-stamp)" },
  { d: "M10 3l8 14H2Z", fill: "var(--color-link)" },
];
const shape = shapes[Astro.props.index % shapes.length];
---

<svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true">
  <path d={shape?.d} fill={shape?.fill}></path>
</svg>
