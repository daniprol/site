---
/**
 * The phone menu: a full-screen colour field opened with the native popover API, so it needs no JS.
 * Hidden from md up, where the header shows the links inline.
 */
import { localePath, stripLocale, useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LanguagePicker from "./LanguagePicker.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
---

<div class="md:hidden">
  <button type="button" popovertarget="site-menu" class="menu-button">
    <span class="dot" aria-hidden="true"></span>
    {t("menu.open")}
  </button>
</div>

<div id="site-menu" popover class="menu" data-palette="vermilion">
  <div class="flex h-16 items-center justify-between px-4">
    <span class="menu-mast display" aria-hidden="true">
      Prol
    </span>
    <button type="button" popovertarget="site-menu" popovertargetaction="hide" class="menu-button">
      {t("menu.close")}
    </button>
  </div>
  <nav aria-label="Main" class="px-4">
    <ol>
      <li>
        <a href={localePath(locale)} class="menu-link" aria-current={current === "/" ? "page" : undefined}>
          <span class="menu-no">00</span>
          {t("nav.home")}
        </a>
      </li>
      {site.nav.map(({ key, href }, i) => (
        <li>
          <a
            href={localePath(locale, href)}
            class="menu-link"
            aria-current={current.startsWith(href) ? "page" : undefined}
          >
            <span class="menu-no">{String(i + 1).padStart(2, "0")}</span>
            {t(key)}
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="mt-auto flex items-center justify-between border-t-2 border-current px-4 py-3">
    <LanguagePicker locale={locale} />
    <ThemeToggle locale={locale} />
  </div>
</div>

<style>
  .menu-button {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 0.5rem;
    padding-inline: 0.9rem;
    border: 2px solid currentColor;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    flex-direction: column;
    background: var(--field);
    color: var(--ink);
    opacity: 0;
    translate: 0 -2rem;
    transition:
      opacity 0.35s var(--ease-out-expo),
      translate 0.5s var(--ease-out-expo),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }
  .menu:popover-open {
    display: flex;
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
      translate: 0 -2rem;
    }
  }
  .menu-mast {
    --wdth: 150;
    font-size: 1.6rem;
    font-weight: 900;
    text-transform: uppercase;
  }
  .menu-link {
    --wdth: 100;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-block: 0.4rem;
    border-bottom: 2px solid var(--ink);
    font-family: var(--font-display);
    font-size: min(11vw, 4.5rem);
    font-weight: 900;
    font-variation-settings: "wdth" var(--wdth);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }
  .menu-link[aria-current="page"] {
    font-style: normal;
    -webkit-text-stroke: 2px var(--ink);
    color: transparent;
  }
  .menu-no {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    -webkit-text-stroke: 0;
    color: var(--ink);
    align-self: center;
  }
  .menu :global(.lang-link),
  .menu :global([data-theme-toggle]) {
    color: var(--ink);
  }
  .menu :global(.lang-link[aria-current="true"]) {
    background: var(--ink);
    color: var(--field);
    text-decoration: none;
  }
</style>
