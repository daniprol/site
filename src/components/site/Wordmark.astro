---
/** The name as a wordmark. Each letter widens in turn on hover: Anybody's width axis, staggered. */
import { site } from "@/site.config";

interface Props {
  href: string;
}
const { href } = Astro.props;
const letters = [...site.shortName.toUpperCase()];
---

<a {href} class="wordmark" aria-label={site.name}>
  <span aria-hidden="true">
    {letters.map((ch, i) => (
      <span style={`--i:${i}`}>{ch === " " ? " " : ch}</span>
    ))}
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.01em;
  }
  .wordmark span span {
    display: inline-block;
    font-stretch: 100%;
    transition: font-stretch 0.5s var(--ease-out-expo) calc(var(--i) * 28ms);
  }
  .wordmark:hover span span,
  .wordmark:focus-visible span span {
    font-stretch: 150%;
  }
</style>
