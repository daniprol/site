---
/**
 * The comments section under posts and snacks. The conversation itself is the React island in
 * src/components/comments, which loads it from the site's Worker (/api/*) once it scrolls into view.
 *
 * Each page's thread is keyed on its path without base or locale ("writing/<slug>"), so every language
 * shares one. Builds without the Worker (GitHub Pages) set COMMENTS=false and get no section at all.
 */
import { COMMENTS } from "astro:env/server";

import CommentsIsland from "@/components/comments/Comments";
import { LABEL_KEYS, type Labels } from "@/components/comments/labels";
import { stripLocale, useTranslations, type Locale } from "@/i18n";
import { LOCALE_TAGS } from "@/lib/format";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const term = stripLocale(Astro.url.pathname).replace(/^\/+|\/+$/g, "") || "index";
// Placeholders such as {n} stay in; the island fills them.
const labels = Object.fromEntries(LABEL_KEYS.map((key) => [key, t(`comments.${key}`)])) as Labels;
---

{COMMENTS && (
  <section id="comments" class="mt-16 scroll-mt-6 sm:mt-20" aria-labelledby="comments-title" data-pagefind-ignore>
    <h2 id="comments-title" class="text-[1.05rem] font-bold tracking-tight">
      {t("comments.title")}
    </h2>
    <div class="mt-4 min-h-40">
      <CommentsIsland client:visible term={term} localeTag={LOCALE_TAGS[locale]} labels={labels} />
    </div>
  </section>
)}
