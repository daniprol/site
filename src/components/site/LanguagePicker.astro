---
import { getRelativeLocaleUrl } from "astro:i18n";

import { LOCALE_NAMES, LOCALES, stripLocale, useTranslations, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const path = stripLocale(Astro.url.pathname);
---

<nav aria-label={t("language")} class="flex font-mono text-xs">
  {LOCALES.map((l) => (
    <a
      href={getRelativeLocaleUrl(l, path)}
      hreflang={l}
      lang={l}
      title={LOCALE_NAMES[l]}
      aria-current={l === locale ? "true" : undefined}
      class:list={[
        "flex size-11 items-center justify-center rounded-md transition-colors hover:text-fg md:size-9",
        l === locale
          ? "font-semibold text-fg underline decoration-accent decoration-2 underline-offset-4"
          : "text-muted",
      ]}
    >
      {l}
    </a>
  ))}
</nav>
