---
/**
 * The en / es / gl links in the header. Each points at the same page in that language; getRelativeLocaleUrl
 * (from Astro's i18n support) adds the right prefix and base path.
 */
import { getRelativeLocaleUrl } from "astro:i18n";

import { LOCALE_NAMES, LOCALES, stripLocale, useTranslations, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const stripped = stripLocale(Astro.url.pathname);
// The 404 page only exists in English, so its language links go to each locale's home page.
const path = /^\/404(\.html)?\/?$/.test(stripped) ? "/" : stripped;
---

<nav aria-label={t("language")} class="flex font-mono text-xs">
  {LOCALES.map((l) => (
    <a
      href={getRelativeLocaleUrl(l, path)}
      hreflang={l}
      lang={l}
      title={LOCALE_NAMES[l]}
      aria-current={l === locale ? "true" : undefined}
      class:list={[
        "flex h-11 w-9 items-center justify-center rounded-md transition-colors hover:text-fg min-[400px]:w-11 md:size-9",
        l === locale
          ? "font-semibold text-fg underline decoration-accent decoration-2 underline-offset-4"
          : "text-muted",
      ]}
    >
      {l}
    </a>
  ))}
</nav>
