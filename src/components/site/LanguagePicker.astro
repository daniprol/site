---
import { getRelativeLocaleUrl } from "astro:i18n";

import { LOCALE_NAMES, LOCALES, stripLocale, useTranslations, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className } = Astro.props;
const t = useTranslations(locale);
const path = stripLocale(Astro.url.pathname);
---

<nav aria-label={t("language")} class:list={["flex items-center font-mono text-xs uppercase", className]}>
  {LOCALES.map((l) => (
    <a
      href={getRelativeLocaleUrl(l, path)}
      hreflang={l}
      lang={l}
      title={LOCALE_NAMES[l]}
      aria-current={l === locale ? "true" : undefined}
      class:list={[
        "inline-flex min-h-11 min-w-9 items-center justify-center rounded-full hover:text-fg",
        l === locale ? "font-semibold text-fg" : "text-muted",
      ]}
    >
      {l}
    </a>
  ))}
</nav>
