---
/**
 * "Written in Santiago de Compostela, {time} there now, probably drizzling."
 * The clock part is hidden until a few lines of inline JS fill in the local time,
 * so without JS the sentence still reads correctly.
 */
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
const [before, after] = t("footer.clock").split("{time}");
---

<p class="text-fg">
  {t("footer.written")}
  <span data-santiago-clock hidden>
    , {before}
    <time class="font-mono text-[0.92em] tabular-nums"></time>
    {after}
  </span>
  .
</p>

<script is:inline>
  (() => {
    const format = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/Madrid",
      hour: "2-digit",
      minute: "2-digit",
    });
    const tick = () => {
      document.querySelectorAll("[data-santiago-clock]").forEach((el) => {
        el.querySelector("time").textContent = format.format(new Date());
        el.hidden = false;
      });
    };
    tick();
    document.addEventListener("astro:after-swap", tick);
    setInterval(tick, 30_000);
  })();
</script>
