---
/**
 * Phone navigation: a Menu button that opens a full-screen index of huge, tappable words.
 * Uses <dialog> for focus handling and Escape-to-close; hidden from lg up.
 */
import { localePath, stripLocale, useTranslations, type Locale } from "@/i18n";
import { site } from "@/site.config";

import LanguagePicker from "./LanguagePicker.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const current = stripLocale(Astro.url.pathname);
const items = [{ key: "nav.home", href: "/" } as const, ...site.nav];
---

<button type="button" class="label inv -mr-3 flex h-11 items-center gap-2 px-3 text-xs lg:hidden" data-menu-open>
  <span aria-hidden="true" class="menu-glyph"></span>
  {t("menu.open")}
</button>

<dialog class="site-menu tone-band" data-menu aria-label={t("menu.open")}>
  <div class="flex h-full flex-col">
    <div class="wrap flex h-(--spacing-header) shrink-0 items-center justify-between border-b border-border">
      <span class="label">{site.name}</span>
      <button type="button" class="label inv -mr-3 flex h-11 items-center px-3 text-xs" data-menu-close>
        {t("menu.close")}
      </button>
    </div>
    <nav aria-label="Main" class="wrap flex grow flex-col justify-end pb-8">
      {items.map(({ key, href }, i) => {
        const active = href === "/" ? current === "/" : current.startsWith(href);
        return (
          <a
            href={localePath(locale, href)}
            aria-current={active ? "page" : undefined}
            class="menu-item inv -mx-(--spacing-gutter) flex items-baseline gap-3 px-(--spacing-gutter)"
            style={`--i:${i}`}
          >
            <span class="label w-6 shrink-0">{String(i).padStart(2, "0")}</span>
            <span class="menu-word">{t(key)}</span>
          </a>
        );
      })}
    </nav>
    <div class="wrap flex shrink-0 items-center justify-between border-t border-border py-2">
      <LanguagePicker locale={locale} />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</dialog>

<style>
  .menu-glyph {
    width: 1rem;
    height: 0.5rem;
    border-block: 2px solid currentColor;
  }
  .site-menu {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .site-menu[open] {
    animation: wipe 380ms var(--ease-snap);
  }
  .site-menu::backdrop {
    background: transparent;
  }
  .menu-word {
    font-family: var(--font-display);
    font-weight: 850;
    font-stretch: 100%;
    font-size: clamp(2.25rem, 11.5vw, 5rem);
    line-height: 1.02;
    text-transform: uppercase;
  }
  .site-menu[open] .menu-item {
    animation: rise 420ms var(--ease-snap) backwards;
    animation-delay: calc(var(--i) * 40ms + 80ms);
  }
  @keyframes wipe {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }
  @keyframes rise {
    from {
      translate: 0 40%;
      opacity: 0;
    }
  }
</style>

<script>
  const bind = () => {
    const dialog = document.querySelector<HTMLDialogElement>("[data-menu]");
    if (!dialog) return;
    document.querySelector("[data-menu-open]")?.addEventListener("click", () => dialog.showModal());
    dialog.querySelector("[data-menu-close]")?.addEventListener("click", () => dialog.close());
  };
  document.addEventListener("astro:page-load", bind);
</script>
