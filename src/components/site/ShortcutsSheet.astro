---
/** The `?` sheet: every keyboard shortcut on one card. Opened by KeyboardNav or the statusline. */
import { useTranslations, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
const rows: { keys: string[][]; label: string }[] = [
  { keys: [["j"], ["k"]], label: t("keys.move") },
  { keys: [["↵"]], label: t("keys.open") },
  { keys: [["/"]], label: t("keys.search") },
  { keys: [["g", "h"]], label: t("keys.home") },
  {
    keys: [
      ["g", "w"],
      ["g", "s"],
      ["g", "p"],
      ["g", "a"],
    ],
    label: t("keys.goto"),
  },
  { keys: [["g", "g"], ["G"]], label: t("keys.ends") },
  { keys: [["t"]], label: t("keys.theme") },
  { keys: [["?"]], label: t("keys.help") },
];
---

<dialog class="panel" data-keys aria-labelledby="keys-title" tabindex="-1">
  <div class="flex items-center justify-between border-b border-border py-2 pr-2 pl-5">
    <h2 id="keys-title" class="font-semibold">
      {t("keys.title")}
    </h2>
    <form method="dialog">
      <button
        class="grid size-11 cursor-pointer place-items-center rounded text-muted hover:text-fg"
        aria-label={t("keys.close")}
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </form>
  </div>
  <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-3 px-5 py-5 text-[0.9375rem]">
    {rows.map(({ keys, label }) => (
      <>
        <dt class="flex flex-wrap items-center gap-1.5">
          {keys.map((chord, i) => (
            <>
              {i > 0 && <span class="text-muted">·</span>}
              <span class="flex gap-0.5">
                {chord.map((k) => (
                  <kbd>{k}</kbd>
                ))}
              </span>
            </>
          ))}
        </dt>
        <dd class="text-muted">{label}</dd>
      </>
    ))}
  </dl>
</dialog>

<script>
  const bind = () => {
    const sheet = document.querySelector<HTMLDialogElement>("[data-keys]");
    if (!sheet) return;
    sheet.onclick = (e) => e.target === sheet && sheet.close();
    document.querySelectorAll<HTMLButtonElement>("[data-keys-open]").forEach((button) => {
      button.onclick = () => {
        sheet.showModal();
        // Focus the sheet itself, not the close button, so no focus ring flashes on open.
        sheet.focus();
      };
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
