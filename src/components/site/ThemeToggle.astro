---
import type { Locale } from "@/i18n";
import { useTranslations } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---

<button type="button" data-theme-toggle aria-label={t("theme.toggle")} class="toggle">
  <svg
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="8.5"></circle>
    <path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .toggle {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    cursor: pointer;
    color: var(--color-muted);
    transition: color 160ms var(--ease-quiet);
  }
  .toggle:hover {
    color: var(--color-fg);
  }
  .toggle svg {
    transition: transform 320ms var(--ease-quiet);
  }
  :global([data-theme="dark"]) .toggle svg {
    transform: rotate(180deg);
  }
</style>

<script>
  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      button.onclick = () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage can be blocked (private mode); fall back to the OS preference.
        }
      };
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
