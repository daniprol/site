---
/**
 * Sun / moon toggle. The icon morphs in CSS from html[data-theme]: the rays fold in and
 * a shadow disc slides across the sun to leave a crescent.
 */
import type { Locale } from "@/i18n";
import { useTranslations } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---

<button type="button" data-theme-toggle aria-label={t("theme.toggle")} class="press toggle">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <mask id="theme-toggle-mask">
      <rect width="24" height="24" fill="white"></rect>
      <circle class="toggle-shade" cx="20" cy="4" r="7" fill="black"></circle>
    </mask>
    <circle class="toggle-core" cx="12" cy="12" r="5" fill="currentColor" mask="url(#theme-toggle-mask)"></circle>
    <g class="toggle-rays" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
      <path d="M12 2.5v1.5M12 20v1.5M2.5 12H4M20 12h1.5M5.3 5.3l1 1M17.7 17.7l1 1M5.3 18.7l1-1M17.7 6.3l1-1"></path>
    </g>
  </svg>
</button>

<style>
  .toggle svg * {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition:
      transform var(--duration-spring) var(--ease-spring),
      opacity var(--duration-base) var(--ease-out);
  }
  /* Light: the shade disc waits off the corner. */
  .toggle-shade {
    transform: translate(9px, -9px);
  }
  /* Dark: the sun swells into a moon, the shade moves in, the rays fold away. */
  :global([data-theme="dark"]) .toggle-core {
    transform: scale(1.55);
  }
  :global([data-theme="dark"]) .toggle-shade {
    transform: translate(-2px, 2px);
  }
  :global([data-theme="dark"]) .toggle-rays {
    transform: rotate(-60deg) scale(0.4);
    opacity: 0;
  }
  @media (hover: hover) {
    .toggle:hover .toggle-rays {
      transform: rotate(30deg);
    }
  }
</style>

<script>
  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      button.onclick = () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage can be blocked (private mode); fall back to the OS preference.
        }
      };
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
