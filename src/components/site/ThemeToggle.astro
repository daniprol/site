---
import type { Locale } from "@/i18n";
import { useTranslations } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---

<button
  type="button"
  data-theme-toggle
  aria-label={t("theme.toggle")}
  class="inv flex size-11 cursor-pointer items-center justify-center"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <rect x="4" y="4" width="16" height="16"></rect>
    <path d="M4 20 20 4v16Z" fill="currentColor"></path>
  </svg>
</button>

<script>
  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      button.onclick = () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage can be blocked (private mode); fall back to the OS preference.
        }
      };
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
