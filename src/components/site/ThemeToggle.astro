---
import type { Locale } from "@/i18n";
import { useTranslations } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---

<button
  type="button"
  data-theme-toggle
  aria-label={t("theme.toggle")}
  class="-mr-3 grid size-11 cursor-pointer place-items-center text-muted transition-colors duration-(--duration-fast) hover:text-fg"
>
  <!-- A dial: half-filled disc with a zero tick, rotating 180° between modes. -->
  <svg
    class="dial"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="8"></circle>
    <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"></path>
    <path d="M12 1.5v2" stroke-linecap="square"></path>
  </svg>
</button>

<style>
  .dial {
    transition: transform var(--duration-base) var(--ease-instrument);
  }
  :global([data-theme="dark"]) .dial {
    transform: rotate(180deg);
  }
</style>

<script>
  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      button.onclick = () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage can be blocked (private mode); fall back to the OS preference.
        }
      };
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
