---
import type { Locale } from "@/i18n";
import { useTranslations } from "@/i18n";

interface Props {
  locale: Locale;
}
const t = useTranslations(Astro.props.locale);
---

<button type="button" data-theme-toggle aria-label={t("theme.toggle")} class="toggle">
  <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path>
  </svg>
</button>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
    background: var(--color-paper);
    color: var(--color-ink);
    box-shadow: var(--shadow-paper);
    border-radius: 2px;
  }
  .toggle svg {
    transition: rotate 0.5s var(--ease-out-soft);
  }
  :global([data-theme="dark"]) .toggle svg {
    rotate: 180deg;
  }
</style>

<script>
  const bind = () => {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
      button.onclick = () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {
          // Storage can be blocked (private mode); fall back to the OS preference.
        }
      };
    });
  };
  bind();
  document.addEventListener("astro:page-load", bind);
</script>
