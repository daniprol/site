---
/** Numbered figure with a caption. Numbers come from a CSS counter on the article. */
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="figure not-prose">
  <slot />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  :global(article) {
    counter-reset: figure;
  }
  .figure {
    counter-increment: figure;
    margin-block: 2.5rem;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink-soft);
  }
  figcaption::before {
    content: "Fig. " counter(figure);
    margin-right: 0.6rem;
    padding: 0.15rem 0.4rem;
    background: var(--color-ink);
    color: var(--color-paper);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    text-transform: uppercase;
  }
</style>
