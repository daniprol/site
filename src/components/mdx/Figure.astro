---
/** Numbered figure with a caption. Numbers come from a CSS counter on the article. */
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="figure not-prose my-10">
  <slot />
  {caption && <figcaption class="mt-3 text-sm">{caption}</figcaption>}
</figure>

<style>
  :global(article) {
    counter-reset: figure;
  }
  .figure {
    counter-increment: figure;
  }
  figcaption {
    color: var(--color-sheet-muted);
  }
  figcaption::before {
    content: "Fig. " counter(figure, decimal-leading-zero) "  ";
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-accent);
  }
</style>
