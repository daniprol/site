---
/** Numbered figure with a caption. Numbers come from a CSS counter on the article. */
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="figure not-prose my-10">
  <slot />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  :global(article) {
    counter-reset: figure;
  }
  .figure {
    counter-increment: figure;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-muted);
  }
  figcaption::before {
    content: "Fig. " counter(figure);
    margin-right: 0.5em;
    padding: 0.1em 0.45em;
    background: var(--field, var(--color-fg));
    color: var(--ink, var(--color-bg));
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>
