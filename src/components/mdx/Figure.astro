---
/**
 * Numbered figure, set like a paper: the content sits on a graph-paper plate,
 * the caption below it on phones and in the margin column on wide screens.
 * Numbers come from a CSS counter on the article.
 */
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<figure class="figure">
  <div class="figure-plate">
    <slot />
  </div>
  {caption && (
    <figcaption>
      <span class="number meta"></span>
      {caption}
    </figcaption>
  )}
</figure>

<style>
  :global(article) {
    counter-reset: figure;
  }
  .figure {
    counter-increment: figure;
    margin-block: calc(var(--spacing-line) * 1.5);
  }
  .figure-plate {
    padding: 1rem 0.75rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg);
    background-image:
      linear-gradient(var(--color-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-faint) 1px, transparent 1px);
    background-size: 14px 14px;
    background-position: -1px -1px;
  }
  figcaption {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.4375rem;
    font-style: italic;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .number::before {
    content: "Figure " counter(figure);
    font-style: normal;
    color: var(--color-fg);
    margin-right: 0.5em;
  }
  @media (min-width: 40rem) {
    .figure-plate {
      padding: 1.75rem 1.5rem;
    }
  }
  /* Wide: the caption moves into the margin, aligned with the bottom of the plate. */
  @media (min-width: 64rem) {
    .figure {
      display: grid;
      grid-template-columns: var(--spacing-measure) var(--spacing-margin);
      column-gap: var(--spacing-gap);
      align-items: end;
      margin-right: calc((var(--spacing-margin) + var(--spacing-gap)) * -1);
    }
    figcaption {
      margin-top: 0;
    }
    .number {
      display: block;
    }
  }
</style>
