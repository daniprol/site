---
/**
 * A margin note. On wide screens it floats into the right margin; on narrow screens
 * it collapses to a numbered note the reader can toggle. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  :global(.prose-site) {
    counter-reset: sidenote;
  }
  .sidenote-ref {
    counter-increment: sidenote;
    cursor: pointer;
  }
  /* The reference: a small sea-coloured numeral with a generous hit area on phones. */
  .sidenote-ref::after {
    content: counter(sidenote);
    font-family: var(--font-sans);
    font-size: 0.68em;
    font-weight: 600;
    vertical-align: super;
    line-height: 0;
    color: var(--color-accent);
    padding: 0.6em 0.3em;
  }
  .sidenote-toggle {
    display: none;
  }
  .sidenote {
    display: none;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .sidenote::before {
    content: counter(sidenote) "  ";
    font-weight: 600;
    color: var(--color-accent);
  }
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin: 0.75rem 0 1rem;
    padding: 0.6rem 0.85rem;
    background: var(--color-surface);
    border-left: 2px solid var(--color-accent);
    border-radius: 0 0.25rem 0.25rem 0;
  }
  /* Wide screens: the note sits in the right margin, level with its reference. */
  @media (min-width: 80rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      width: 14rem;
      margin: 0.3rem -17rem 1rem 0;
      padding: 0 0 0 0.85rem;
      background: none;
      border-left: 1px solid var(--color-border);
      border-radius: 0;
      font-size: 0.8125rem;
    }
  }
</style>
