---
/**
 * A margin note. On wide screens it floats into the right margin; on narrow screens
 * it collapses to a numbered note the reader can toggle. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  :global(.prose-site) {
    counter-reset: sidenote;
  }
  .sidenote-ref {
    counter-increment: sidenote;
    cursor: pointer;
  }
  /* The reference is a small vermilion tab, so it reads as tappable on phones. */
  .sidenote-ref::after {
    content: counter(sidenote);
    display: inline-block;
    min-width: 1.35em;
    margin-inline: 0.15em;
    padding: 0.1em 0.3em;
    font-family: var(--font-mono);
    font-size: 0.62em;
    font-weight: 700;
    line-height: 1.3;
    text-align: center;
    vertical-align: 0.35em;
    background: var(--color-mark);
    color: var(--color-ink);
  }
  .sidenote-toggle {
    display: none;
  }
  .sidenote {
    display: none;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-sheet-muted);
  }
  .sidenote::before {
    content: counter(sidenote, decimal-leading-zero) "  ";
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-accent);
  }
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin: 0.75rem 0;
    padding: 0.75rem 1rem;
    background: var(--color-code-bg);
  }
  @media (min-width: 72rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      width: 15rem;
      margin: 0.3rem -18.5rem 1rem 0;
      padding: 0.6rem 0 0;
      border-top: 1px solid var(--color-mark);
      background: none;
    }
  }
</style>
