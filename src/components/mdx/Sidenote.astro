---
/**
 * A margin note. On wide screens it floats into the right margin; on narrow screens
 * it collapses to a numbered note the reader can toggle. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  :global(.prose-site) {
    counter-reset: sidenote;
  }
  /* The reference: a tiny numbered chip, tactile on phones where it is a toggle. */
  .sidenote-ref {
    counter-increment: sidenote;
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.125rem;
    height: 1.125rem;
    margin-inline: 0.125rem;
    padding-inline: 0.25rem;
    vertical-align: 0.15em;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    line-height: 1;
    color: var(--color-muted);
    background: var(--color-surface);
    box-shadow:
      inset 0 0 0 1px var(--color-border-strong),
      inset 0 1px 0 var(--color-highlight);
    cursor: pointer;
    user-select: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      transform var(--duration-spring) var(--ease-spring);
  }
  .sidenote-ref::after {
    content: counter(sidenote);
  }
  /* 44px tap area around the chip. */
  .sidenote-ref::before {
    content: "";
    position: absolute;
    inset: -0.8125rem;
  }
  .sidenote-ref:active {
    transform: scale(0.88);
  }
  .sidenote-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .sidenote-toggle:focus-visible + .sidenote,
  .sidenote-ref:has(+ .sidenote-toggle:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .sidenote-toggle:checked + .sidenote,
  .sidenote-ref:has(+ .sidenote-toggle:checked) {
    color: var(--color-fg);
  }
  .sidenote-ref:has(+ .sidenote-toggle:checked) {
    background: var(--color-surface-active);
  }

  .sidenote {
    display: none;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-muted);
    letter-spacing: 0;
  }
  .sidenote::before {
    content: counter(sidenote);
    margin-inline-end: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-faint);
  }
  /* Phones: the note opens as an inset card below the line, easing in. */
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin-block: 0.75rem;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-raised);
    transition:
      opacity var(--duration-base) var(--ease-out),
      translate var(--duration-spring) var(--ease-spring);
  }
  @starting-style {
    .sidenote-toggle:checked + .sidenote {
      opacity: 0;
      translate: 0 -0.25rem;
    }
  }

  @media (min-width: 70rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote-ref:active {
      transform: none;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      width: var(--col-margin);
      margin: 0.1875rem calc(-1 * (var(--col-margin) + var(--col-gap))) 1rem 0;
      padding: 0;
      background: none;
      box-shadow: none;
      color: var(--color-muted);
      transition: color var(--duration-fast) var(--ease-out);
    }
    /* Hovering either end of a note lights up the other. */
    .sidenote-ref:hover + .sidenote-toggle + .sidenote,
    .sidenote:hover {
      color: var(--color-fg);
    }
    .sidenote-ref:hover,
    .sidenote-ref:has(+ .sidenote-toggle + .sidenote:hover) {
      color: var(--color-fg);
      background: var(--color-surface-active);
    }
  }
</style>
