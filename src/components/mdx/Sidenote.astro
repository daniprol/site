---
/**
 * A margin note. On wide screens it floats into the right margin; on narrow screens
 * it collapses to a numbered note the reader can toggle. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  :global(.prose-site) {
    counter-reset: sidenote;
  }
  .sidenote-ref {
    counter-increment: sidenote;
    cursor: pointer;
  }
  /* The reference is a small mono number; on phones it is also the tap target that opens the note. */
  .sidenote-ref::after {
    content: counter(sidenote);
    display: inline-block;
    min-width: 1.4em;
    padding: 0 0.15em;
    font-family: var(--font-mono);
    font-size: 0.7em;
    font-weight: 600;
    line-height: 1;
    text-align: center;
    vertical-align: super;
    color: var(--color-accent);
  }
  .sidenote-toggle {
    display: none;
  }
  .sidenote {
    display: none;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .sidenote::before {
    content: counter(sidenote) " ";
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
  }
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin: 0.75rem 0;
    padding: 0.6rem 0.85rem;
    border-left: 2px solid var(--color-accent);
    border-radius: 0 4px 4px 0;
    background: var(--color-surface);
  }
  /* Wide screens: the note sits in the right margin, like virtual text beside the line. */
  @media (min-width: 76rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      width: 13rem;
      margin: 0.3rem -16rem 1rem 0;
      padding: 0 0 0 0.75rem;
      border: 0;
      border-left: 1px solid var(--color-border);
      border-radius: 0;
      background: none;
    }
  }
</style>
