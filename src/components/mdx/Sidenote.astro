---
/**
 * A margin note. On wide screens it sits in the right margin beside the line it belongs to;
 * on narrow screens it collapses to a numbered reference the reader can tap open. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  :global(.prose-site) {
    counter-reset: sidenote;
  }
  .sidenote-ref {
    counter-increment: sidenote;
    position: relative;
    cursor: pointer;
  }
  /* The reference: a small mono numeral, raised. */
  .sidenote-ref::after {
    content: counter(sidenote);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 0;
    vertical-align: 0.6em;
    padding-inline: 0.15em 0.05em;
    color: var(--color-accent);
  }
  /* Enlarge the tap target without moving the text. */
  .sidenote-ref::before {
    content: "";
    position: absolute;
    inset: -14px -12px;
  }
  .sidenote-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .sidenote-toggle:focus-visible + .sidenote,
  .sidenote-ref:has(+ .sidenote-toggle:focus-visible)::after {
    outline: 1.5px solid var(--color-accent);
    outline-offset: 2px;
  }
  .sidenote {
    display: none;
    font-size: 0.9375rem;
    line-height: 1.4375rem;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .sidenote::before {
    content: counter(sidenote);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-accent);
    margin-right: 0.5em;
  }
  /* Phones: tapped open, the note drops in under the line, ruled on the left. */
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin: 0.5rem 0 0.75rem;
    padding: 0.25rem 0 0.25rem 0.875rem;
    border-left: 1px solid var(--color-accent);
  }
  @media (min-width: 64rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote-ref::before {
      content: none;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      position: relative;
      width: var(--spacing-margin);
      margin: 0.3rem calc((var(--spacing-margin) + var(--spacing-gap)) * -1) 1rem 0;
      padding: 0;
      border: 0;
    }
    /* Hanging numeral, so the note's text aligns flush with the margin column. */
    .sidenote::before {
      position: absolute;
      right: calc(100% + 0.5rem);
      margin: 0;
    }
  }
</style>
