---
/**
 * A margin note. On wide screens it floats into the right margin; on narrow screens
 * it collapses to a numbered note the reader can toggle. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  :global(.prose-site) {
    counter-reset: sidenote;
  }
  .sidenote-ref {
    counter-increment: sidenote;
    cursor: pointer;
  }
  /* Note numbers sit in little orange balls. */
  .sidenote-ref::after,
  .sidenote::before {
    content: counter(sidenote);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.35em;
    height: 1.35em;
    border-radius: 50%;
    background: var(--color-ball);
    color: var(--color-seam);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
  }
  .sidenote-ref::after {
    margin-left: 0.15em;
    vertical-align: 0.45em;
    transition: transform 0.3s var(--ease-bounce);
  }
  .sidenote-ref:hover::after {
    transform: translateY(-2px);
  }
  .sidenote::before {
    margin-right: 0.45em;
    vertical-align: 0.1em;
  }
  .sidenote-toggle {
    display: none;
  }
  .sidenote {
    display: none;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin: 0.75rem 0;
    padding: 0.75rem 1rem;
    border-radius: 0.6rem;
    background: var(--color-surface);
  }
  @media (min-width: 72rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      width: 14rem;
      margin: 0.3rem -17rem 1rem 0;
      padding: 0;
      background: none;
      font-size: 0.85rem;
    }
  }
</style>
