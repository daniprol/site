---
/**
 * A margin note. On wide screens it floats into the right-hand columns; on narrow screens
 * it collapses to a numbered note the reader can toggle. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  :global(.prose-site) {
    counter-reset: sidenote;
  }
  .sidenote-ref {
    counter-increment: sidenote;
    cursor: pointer;
  }
  .sidenote-ref::after {
    content: counter(sidenote);
    font-family: var(--font-mono);
    font-size: 0.65em;
    font-weight: 500;
    vertical-align: super;
    line-height: 0;
    color: var(--color-accent);
    padding-inline: 0.15em;
  }
  .sidenote-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .sidenote-toggle:focus-visible + .sidenote,
  .sidenote-ref:has(+ .sidenote-toggle:focus-visible) {
    outline: 2px solid var(--color-accent);
  }
  .sidenote {
    display: none;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .sidenote::before {
    content: counter(sidenote);
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-accent);
    margin-right: 0.6em;
  }
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin: 0.75rem 0 1rem;
    padding: 0.5rem 0 0.5rem 1rem;
    border-left: 2px solid var(--color-accent);
  }
  /* The text column is capped at 38rem; from 84rem there are ≥ 17rem of grid to its right. */
  @media (min-width: 84rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      width: 14rem;
      margin: 0.3rem -17rem 1rem 0;
      padding: 0.5rem 0 0;
      border: 0;
      border-top: 1px solid var(--color-fg);
    }
  }
</style>
