---
/**
 * A margin note. On wide screens it floats into the right margin; on narrow screens
 * it collapses to a numbered note the reader can toggle. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  .sidenote-ref {
    counter-increment: sidenote;
    cursor: pointer;
  }
  /* A small numbered chip, big enough to tap. */
  .sidenote-ref::after {
    content: counter(sidenote);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35em;
    height: 1.35em;
    margin-inline: 0.15em;
    padding-inline: 0.25em;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.68em;
    font-weight: 600;
    vertical-align: 0.45em;
    line-height: 1;
  }
  .sidenote-toggle {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .sidenote-toggle:focus-visible + .sidenote,
  .sidenote-ref:has(+ .sidenote-toggle:focus-visible)::after {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
  .sidenote {
    display: none;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .sidenote::before {
    content: counter(sidenote) ".";
    margin-right: 0.4em;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-accent);
  }
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin: 0.75rem 0;
    padding: 0.6rem 0.85rem;
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface);
    border-radius: 0 0.35rem 0.35rem 0;
  }
  /* Wide screens: the note lives in the right margin, next to its line. */
  @media (min-width: 80rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      width: 14rem;
      margin: 0.3rem -17.5rem 1rem 0;
      padding: 0 0 0 0.85rem;
      border-left: 2px solid var(--color-border);
      background: none;
      border-radius: 0;
    }
  }
</style>
