---
/**
 * A margin note. On wide screens it floats into the right margin; on narrow screens
 * it collapses to a numbered note the reader can toggle. Pure CSS, no JS.
 * Usage in MDX: text<Sidenote>the note</Sidenote>
 */
const id = `sn-${Math.random().toString(36).slice(2, 8)}`;
---

<label for={id} class="sidenote-ref" aria-label="Show note"></label>
<input type="checkbox" id={id} class="sidenote-toggle" />
<span class="sidenote" role="note">
  <slot />
</span>

<style>
  :global(.prose-site) {
    counter-reset: sidenote;
  }
  .sidenote-ref {
    counter-increment: sidenote;
    cursor: pointer;
  }
  .sidenote-ref {
    display: inline-block;
    min-width: 1.6em;
    padding-block: 0.4em;
    margin-block: -0.4em;
    text-align: center;
  }
  .sidenote-ref::after {
    content: counter(sidenote);
    font-family: var(--font-mono);
    font-size: 0.65em;
    font-weight: 600;
    vertical-align: super;
    color: var(--color-accent);
  }
  .sidenote-toggle {
    display: none;
  }
  .sidenote {
    display: none;
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .sidenote::before {
    content: counter(sidenote) "  ";
    font-family: var(--font-mono);
    font-size: 0.75em;
    font-weight: 600;
    color: var(--color-accent);
  }
  .sidenote-toggle:checked + .sidenote {
    display: block;
    margin: 0.75rem 0;
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--color-field);
    background: var(--color-surface);
  }
  @media (min-width: 72rem) {
    .sidenote-ref {
      cursor: default;
    }
    .sidenote,
    .sidenote-toggle:checked + .sidenote {
      display: block;
      float: right;
      clear: right;
      width: 14rem;
      margin: 0.25rem -17rem 1rem 0;
      padding: 0 0 0 0.75rem;
      border: 0;
      border-left: 1px solid var(--color-border);
      background: none;
    }
  }
</style>
