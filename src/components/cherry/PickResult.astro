---
/**
 * How an entry ends: the terminal after `git cherry-pick`. The pros and cons are the + and − lines,
 * and git's answer is the verdict: applied to main (picked), a conflict to come back to (ripening),
 * or an abort (dropped). Git's own words stay in English; the verdict line below is translated.
 * Static by default; PickMotion types the command and reveals the lines when it scrolls into view.
 */
import { useTranslations, type Locale } from "@/i18n";
import type { Pick } from "@/lib/content";

import Cherry from "./Cherry.astro";
import Verdict from "./Verdict.astro";

interface Props {
  pick: Pick;
  locale: Locale;
}
const { pick, locale } = Astro.props;
const t = useTranslations(locale);
const { entry, hash, mainHash, number } = pick;
const { verdict, title, pros, cons, url } = entry.data;
const command = `git cherry-pick ${hash}`;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const stat = [
  pros.length > 0 && `${plural(pros.length, "insertion")}(+)`,
  cons.length > 0 && `${plural(cons.length, "deletion")}(-)`,
]
  .filter(Boolean)
  .join(", ");
const host = url ? new URL(url).hostname.replace(/^www\./, "") : undefined;

/** Lines after the diff, as [kind, text]. */
const outcome: [kind: "out" | "error" | "hint" | "cmd", text: string][] = {
  keep: [["out", `[main ${mainHash}] ${title}`], ...(stat ? ([["out", ` ${stat}`]] as [["out", string]]) : [])],
  maybe: [
    ["error", `error: could not apply ${hash}... ${title}`],
    ["hint", "hint: not ripe yet. Try it for another week, then run"],
    ["hint", 'hint: "git cherry-pick --continue"'],
  ],
  drop: [
    ["cmd", "git cherry-pick --abort"],
    ["out", "# main is unchanged"],
  ],
}[verdict] as [kind: "out" | "error" | "hint" | "cmd", text: string][];

let step = 0;
const next = () => `--s:${step++}`;
---

<aside class="result not-prose" data-pick-result data-verdict={verdict} aria-label={t("picks.result")}>
  <p class="flex items-center justify-between gap-3 border-b border-border px-4 py-2.5">
    <span class="eyebrow">{t("picks.result")}</span>
    <span class="font-mono text-xs text-muted">#{String(number).padStart(3, "0")}</span>
  </p>
  <div class="term" lang="en">
    <p class="tline cmd first">
      <span class="prompt" aria-hidden="true">
        $
      </span>
      <span class="typed" style={`--n:${command.length}`}>
        {command}
      </span>
    </p>
    {(pros.length > 0 || cons.length > 0) && (
      <ul class="diff">
        {pros.map((line) => (
          <li class="tline add" style={next()}>
            <span class="sign" aria-hidden="true">
              +
            </span>
            <span class="sr-only">{t("picks.pro")}: </span>
            <span>{line}</span>
          </li>
        ))}
        {cons.map((line) => (
          <li class="tline del" style={next()}>
            <span class="sign" aria-hidden="true">
              −
            </span>
            <span class="sr-only">{t("picks.con")}: </span>
            <span>{line}</span>
          </li>
        ))}
      </ul>
    )}
    {outcome.map(([kind, text]) => (
      <p class:list={["tline", kind]} style={next()}>
        {kind === "cmd" && (
          <span class="prompt" aria-hidden="true">
            $
          </span>
        )}
        <span>{text}</span>
      </p>
    ))}
    <p class="tline cmd" style={next()} aria-hidden="true">
      <span class="prompt">$</span>
      <span class="caret"></span>
    </p>
  </div>
  <div class="verdict-row tline" style={next()}>
    <Cherry verdict={verdict} class="h-10 w-8 shrink-0" />
    <p class="min-w-0 flex-1">
      <Verdict verdict={verdict} locale={locale} />
      <span class="mt-0.5 block text-[0.97rem] leading-snug">{t(`picks.verdictLine.${verdict}`)}</span>
    </p>
    {url && host && (
      <a href={url} class="visit group" rel="noopener">
        <span class="marker-hover">{host}</span>
        <span aria-hidden="true" class="text-muted">
          ↗
        </span>
        <span class="sr-only">({t("picks.visit", { host })})</span>
      </a>
    )}
  </div>
</aside>

<style>
  .result {
    margin-top: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg);
    overflow: hidden;
  }
  .term {
    padding: 0.9rem 1rem 1rem;
    background: var(--color-code-bg);
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.65;
  }
  .tline {
    display: flex;
    gap: 0.6rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .prompt {
    color: var(--color-accent);
    user-select: none;
  }
  .cmd {
    font-weight: 600;
  }
  .out,
  .hint {
    color: var(--color-muted);
  }
  .error {
    color: var(--color-maybe);
  }
  .diff {
    margin-block: 0.45rem;
    display: grid;
    gap: 2px;
  }
  /* The diff lines are the content here, so they read as text, not as code. */
  .add,
  .del {
    margin-inline: -0.5rem;
    padding: 0.28rem 0.5rem;
    border-radius: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.45;
    white-space: normal;
    color: var(--color-fg);
  }
  .add {
    background: color-mix(in oklch, var(--color-keep) 11%, transparent);
  }
  .del {
    background: color-mix(in oklch, var(--color-drop) 10%, transparent);
  }
  .sign {
    flex: none;
    width: 0.7rem;
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .add .sign {
    color: var(--color-keep);
  }
  .del .sign {
    color: var(--color-drop);
  }
  .caret {
    width: 0.55rem;
    height: 1.05em;
    margin-top: 0.22em;
    background: var(--color-fg);
    opacity: 0.75;
    animation: blink 1.1s steps(2, jump-none) infinite;
  }
  @keyframes blink {
    to {
      opacity: 0;
    }
  }

  .verdict-row {
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-top: 1px solid var(--color-border);
    white-space: normal;
  }
  .visit {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
  }

  /* Played once by PickMotion: the command types itself, then each line lands in turn. */
  .result[data-armed]:not([data-inview]) .tline {
    visibility: hidden;
  }
  @keyframes type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes land {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .result[data-inview] .typed {
    animation: type calc(var(--n) * 32ms) steps(var(--n)) 0.15s backwards;
  }
  .result[data-inview] .tline:not(.first) {
    animation: land 0.32s var(--ease-out-soft) calc(0.95s + var(--s) * 0.11s) backwards;
  }
  @media (prefers-reduced-motion: reduce) {
    .caret {
      animation: none;
    }
  }
</style>
