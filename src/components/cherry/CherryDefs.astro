---
/**
 * The cherry artwork, defined once per page as SVG symbols and gradients; <Cherry /> draws them
 * with <use>. Colours come from the cherry tokens, so the fruit follows light and dark mode.
 *
 * Three fruits, one per verdict:
 *   keep  – a ripe red cherry          maybe – a yellow Rainier with a blush (still ripening)
 *   drop  – a dull one lying on its side, off its stem
 * The small symbols (32×40) hang in the graph; the "-leaf" ones (48×58) head an entry.
 * In every hanging symbol the stem's top is the point it swings from.
 */
---

<svg class="cherry-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="cherry-ripe" cx="0.36" cy="0.3" r="0.8">
      <stop offset="0" style="stop-color: var(--color-cherry-light)"></stop>
      <stop offset="0.5" style="stop-color: var(--color-cherry)"></stop>
      <stop offset="1" style="stop-color: var(--color-cherry-deep)"></stop>
    </radialGradient>
    <radialGradient id="cherry-rainier" cx="0.36" cy="0.3" r="0.8">
      <stop offset="0" style="stop-color: var(--color-rainier)"></stop>
      <stop offset="0.7" style="stop-color: var(--color-rainier)"></stop>
      <stop offset="1" style="stop-color: var(--color-rainier-deep)"></stop>
    </radialGradient>
    <radialGradient id="cherry-blush" cx="0.74" cy="0.7" r="0.62">
      <stop offset="0" style="stop-color: var(--color-cherry); stop-opacity: 0.85"></stop>
      <stop offset="0.55" style="stop-color: var(--color-cherry-light); stop-opacity: 0.45"></stop>
      <stop offset="1" style="stop-color: var(--color-cherry-light); stop-opacity: 0"></stop>
    </radialGradient>
    <linearGradient id="cherry-pit" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--color-pit)"></stop>
      <stop offset="1" style="stop-color: var(--color-pit-deep)"></stop>
    </linearGradient>
    <linearGradient id="cherry-leaf" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--color-leaf)"></stop>
      <stop offset="1" style="stop-color: var(--color-leaf-deep)"></stop>
    </linearGradient>

    <!-- Small fruits: stem top at (4, 2), fruit centred on (19, 28). -->
    <symbol id="cherry-keep" viewBox="0 0 32 40">
      <path
        d="M4 2C5.5 9.5 10.5 15 17.5 18.2"
        fill="none"
        stroke="var(--color-stem)"
        stroke-width="1.7"
        stroke-linecap="round"
      ></path>
      <circle cx="19" cy="28" r="10.5" fill="url(#cherry-ripe)"></circle>
      <ellipse cx="17.6" cy="18.9" rx="3.1" ry="1.3" fill="var(--color-cherry-deep)" opacity="0.55"></ellipse>
      <ellipse
        cx="14.2"
        cy="24.4"
        rx="2.1"
        ry="3.6"
        transform="rotate(34 14.2 24.4)"
        fill="#fff"
        opacity="0.62"
      ></ellipse>
      <circle cx="12.4" cy="30.2" r="0.9" fill="#fff" opacity="0.5"></circle>
    </symbol>
    <symbol id="cherry-maybe" viewBox="0 0 32 40">
      <path
        d="M4 2C5.5 9.5 10.5 15 17.5 18.2"
        fill="none"
        stroke="var(--color-stem)"
        stroke-width="1.7"
        stroke-linecap="round"
      ></path>
      <circle cx="19" cy="28" r="10.5" fill="url(#cherry-rainier)"></circle>
      <circle cx="19" cy="28" r="10.5" fill="url(#cherry-blush)"></circle>
      <ellipse cx="17.6" cy="18.9" rx="3.1" ry="1.3" fill="var(--color-rainier-deep)" opacity="0.7"></ellipse>
      <ellipse
        cx="14.2"
        cy="24.4"
        rx="2.1"
        ry="3.6"
        transform="rotate(34 14.2 24.4)"
        fill="#fff"
        opacity="0.75"
      ></ellipse>
      <circle cx="12.4" cy="30.2" r="0.9" fill="#fff" opacity="0.6"></circle>
    </symbol>
    <!-- Dropped: on the ground, tipped over, its stem beside it. -->
    <symbol id="cherry-drop" viewBox="0 0 32 40">
      <path d="M3 37.5h26" fill="none" stroke="var(--color-border)" stroke-width="1.5" stroke-linecap="round"></path>
      <path
        d="M22.5 21.5C26 19 28.5 15.5 29.5 11.5"
        fill="none"
        stroke="var(--color-pit-deep)"
        stroke-width="1.6"
        stroke-linecap="round"
      ></path>
      <circle cx="14" cy="27" r="10" fill="url(#cherry-pit)"></circle>
      <ellipse
        cx="21.2"
        cy="21.2"
        rx="2.8"
        ry="1.2"
        transform="rotate(42 21.2 21.2)"
        fill="var(--color-pit-deep)"
        opacity="0.6"
      ></ellipse>
      <path
        d="M8.5 24c1.6 1 2.4 2.8 2.2 4.8M12.5 31.5c1.5.4 3 .1 4.2-.8"
        fill="none"
        stroke="var(--color-pit-deep)"
        stroke-width="1.1"
        stroke-linecap="round"
        opacity="0.55"
      ></path>
    </symbol>

    <!-- Entry header fruits: stem top at (12, 8) with a leaf, fruit centred on (29, 42). -->
    <symbol id="cherry-keep-leaf" viewBox="0 0 48 58">
      <path d="M12 8C17 1 28 0.5 35 6.5C29 13.5 18 14 12 8Z" fill="url(#cherry-leaf)"></path>
      <path
        d="M12 8C19 6 26 5.6 33 6.6"
        fill="none"
        stroke="var(--color-bg)"
        stroke-width="0.9"
        stroke-linecap="round"
        opacity="0.7"
      ></path>
      <path
        d="M12 8C13.5 18 19.5 25.5 27.5 29.6"
        fill="none"
        stroke="var(--color-stem)"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
      <circle cx="29" cy="42" r="14" fill="url(#cherry-ripe)"></circle>
      <ellipse cx="27.4" cy="30.2" rx="4.2" ry="1.7" fill="var(--color-cherry-deep)" opacity="0.55"></ellipse>
      <ellipse
        cx="22.6"
        cy="37.2"
        rx="2.8"
        ry="4.9"
        transform="rotate(34 22.6 37.2)"
        fill="#fff"
        opacity="0.62"
      ></ellipse>
      <circle cx="20.2" cy="45" r="1.2" fill="#fff" opacity="0.5"></circle>
    </symbol>
    <symbol id="cherry-maybe-leaf" viewBox="0 0 48 58">
      <path d="M12 8C17 1 28 0.5 35 6.5C29 13.5 18 14 12 8Z" fill="url(#cherry-leaf)"></path>
      <path
        d="M12 8C19 6 26 5.6 33 6.6"
        fill="none"
        stroke="var(--color-bg)"
        stroke-width="0.9"
        stroke-linecap="round"
        opacity="0.7"
      ></path>
      <path
        d="M12 8C13.5 18 19.5 25.5 27.5 29.6"
        fill="none"
        stroke="var(--color-stem)"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
      <circle cx="29" cy="42" r="14" fill="url(#cherry-rainier)"></circle>
      <circle cx="29" cy="42" r="14" fill="url(#cherry-blush)"></circle>
      <ellipse cx="27.4" cy="30.2" rx="4.2" ry="1.7" fill="var(--color-rainier-deep)" opacity="0.7"></ellipse>
      <ellipse
        cx="22.6"
        cy="37.2"
        rx="2.8"
        ry="4.9"
        transform="rotate(34 22.6 37.2)"
        fill="#fff"
        opacity="0.75"
      ></ellipse>
      <circle cx="20.2" cy="45" r="1.2" fill="#fff" opacity="0.6"></circle>
    </symbol>
    <symbol id="cherry-drop-leaf" viewBox="0 0 48 58">
      <path
        d="M12 8C13.5 14 16 18.5 19.5 22"
        fill="none"
        stroke="var(--color-pit-deep)"
        stroke-width="2"
        stroke-linecap="round"
        stroke-dasharray="0.1 4.2"
      ></path>
      <path d="M6 55h38" fill="none" stroke="var(--color-border)" stroke-width="1.8" stroke-linecap="round"></path>
      <path
        d="M35 33.5C39.5 30 42.5 25.5 43.5 20"
        fill="none"
        stroke="var(--color-pit-deep)"
        stroke-width="2"
        stroke-linecap="round"
      ></path>
      <circle cx="24" cy="41" r="13.5" fill="url(#cherry-pit)"></circle>
      <ellipse
        cx="33.6"
        cy="33"
        rx="3.8"
        ry="1.6"
        transform="rotate(42 33.6 33)"
        fill="var(--color-pit-deep)"
        opacity="0.6"
      ></ellipse>
      <path
        d="M16.5 37c2.2 1.4 3.2 3.8 3 6.5M22 47c2 .6 4 .2 5.6-1"
        fill="none"
        stroke="var(--color-pit-deep)"
        stroke-width="1.4"
        stroke-linecap="round"
        opacity="0.55"
      ></path>
    </symbol>
  </defs>
</svg>

<style>
  .cherry-defs {
    position: absolute;
  }
</style>
