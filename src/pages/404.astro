---
import Sheet from "@/components/ui/Sheet.astro";
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <Sheet class="lost">
    <p class="code" aria-hidden="true">
      404
    </p>
    <h1>{t("notFound.title")}</h1>
    <p class="body">{t("notFound.body")}</p>
    <a href="/" class="home">
      ← {t("nav.home")}
    </a>
  </Sheet>
</BaseLayout>

<style>
  :global(.lost) {
    max-width: 30rem;
    margin-top: 3rem;
    rotate: -1.5deg;
  }
  .code {
    font-family: var(--font-display);
    font-size: 7rem;
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.8;
    color: var(--color-stamp);
  }
  h1 {
    margin-top: 1rem;
    font-size: 2rem;
    font-weight: 750;
  }
  .body {
    margin-top: 0.5rem;
    color: var(--color-ink-soft);
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 1rem;
    color: var(--color-link);
  }
</style>
