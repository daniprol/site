---
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <section class="pt-14 sm:pt-20">
    <!-- A shot that sails past the rim. -->
    <svg
      class="airball"
      width="140"
      height="84"
      viewBox="0 0 140 84"
      fill="none"
      stroke="var(--color-muted)"
      stroke-width="1.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M8 76 Q40 -8 70 60" stroke-dasharray="3 5"></path>
      <path d="M84 40h30" stroke="var(--color-ball)" stroke-width="2.5"></path>
      <path d="M87 41l4 16 6-16 6 16 6-16 3 16" stroke-width="1"></path>
      <path d="M114 40V14"></path>
      <circle cx="72" cy="68" r="7" fill="var(--color-ball)" stroke="var(--color-seam)" stroke-width="1"></circle>
    </svg>
    <p class="meta mt-6 font-semibold text-accent uppercase">{t("notFound.kicker")}</p>
    <h1 class="mt-2 text-[2rem] font-[720]">{t("notFound.title")}</h1>
    <p class="mt-2 text-lg text-muted">{t("notFound.body")}</p>
    <p class="mt-8">
      <a href="/" class="link">
        ← {t("nav.home")}
      </a>
    </p>
  </section>
</BaseLayout>
