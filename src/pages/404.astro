---
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <section class="rail-grid pt-16 sm:pt-24">
    <p class="label text-signal lg:pt-3">Err 404</p>
    <div>
      <h1 class="text-title font-semibold tracking-[-0.025em] sm:text-display">{t("notFound.title")}</h1>
      <p class="mt-3 text-muted">{t("notFound.body")}</p>
      <p class="mt-8">
        <a href="/" class="group label inline-flex min-h-11 items-center gap-2 text-fg hover:text-signal">
          <span aria-hidden="true">←</span>
          {t("nav.home")}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
