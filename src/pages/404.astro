---
import DisplayTitle from "@/components/ui/DisplayTitle.astro";
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <section class="flex min-h-[70svh] flex-col justify-end pt-16 pb-10">
    <div class="wrap">
      <p class="label mb-6">{t("notFound.title")}</p>
      <DisplayTitle text="404" stretch={false} />
      <p class="mt-8 max-w-[30ch] text-xl leading-snug">{t("notFound.body")}</p>
      <a href="/" class="label inv mt-6 -ml-2 inline-flex h-11 items-center px-2">
        ← {t("nav.home")}
      </a>
    </div>
  </section>
</BaseLayout>
