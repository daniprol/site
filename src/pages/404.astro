---
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <header class="page-head column">
    <p class="meta">404</p>
    <h1>{t("notFound.title")}</h1>
    <p>{t("notFound.body")}</p>
  </header>
  <p class="column">
    <a href="/" class="link">
      ← {t("nav.home")}
    </a>
  </p>
</BaseLayout>
