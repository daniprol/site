---
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <div class="rail mt-16 rail:mt-24">
    <p class="rail-label meta">404</p>
    <div>
      <h1 class="text-xl font-semibold tracking-[-0.02em]">{t("notFound.title")}</h1>
      <p class="mt-2 text-muted">{t("notFound.body")}</p>
      <p class="mt-6">
        <a href="/" class="more">
          <span aria-hidden="true">←</span>
          {t("nav.home")}
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
