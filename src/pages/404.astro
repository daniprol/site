---
import PageHeader from "@/components/ui/PageHeader.astro";
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <PageHeader title={t("notFound.title")} description={t("notFound.body")} />
  <p>
    <a href="/" class="link">
      ← {t("notFound.home")}
    </a>
  </p>
</BaseLayout>
