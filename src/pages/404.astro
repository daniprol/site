---
import Cover from "@/components/cover/Cover.astro";
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <div class="wrap pt-6">
    <Cover
      slug="404"
      title="404"
      kicker={t("notFound.title")}
      dek={t("notFound.body")}
      lines={[`← ${t("nav.home")}`]}
      href="/"
      variant="spread"
      as="h1"
    />
  </div>
</BaseLayout>
