---
import { DEFAULT_LOCALE, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";

const t = useTranslations(DEFAULT_LOCALE);
---

<BaseLayout locale={DEFAULT_LOCALE} title={t("notFound.title")} description={t("notFound.body")}>
  <section class="mt-16 sm:mt-24">
    <p class="font-mono text-sm text-accent" aria-hidden="true">
      404 ∉ routes
    </p>
    <h1 class="mt-3 text-[1.9rem] font-bold tracking-[-0.02em]">{t("notFound.title")}</h1>
    <p class="mt-2 text-muted">{t("notFound.body")}</p>
    <p class="mt-6">
      <a href="/" class="group inline-flex min-h-11 items-center font-semibold text-accent">
        <span class="marker-hover">← {t("nav.home")}</span>
      </a>
    </p>
  </section>
</BaseLayout>
