---
import PageHead from "@/components/ui/PageHead.astro";
import PostList from "@/components/ui/PostList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getPosts(locale);
const years = Map.groupBy(posts, ({ post }) => post.data.date.getFullYear());
---

<BaseLayout locale={locale} title={t("writing.title")} description={t("writing.description")}>
  <PageHead title={t("writing.title")} description={t("writing.description")} aside={String(posts.length)} />
  {[...years].map(([year, items]) => (
    <section class="wrap mt-10">
      <h2 class="year display">{year}</h2>
      <PostList items={items} locale={locale} />
    </section>
  ))}
</BaseLayout>

<style>
  .year {
    --wdth: 62;
    margin-bottom: 1rem;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent);
  }
</style>
