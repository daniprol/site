---
import PostList from "@/components/ui/PostList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getPosts(locale);
const years = Map.groupBy(posts, ({ post }) => post.data.date.getFullYear());
---

<BaseLayout locale={locale} title={t("writing.title")} description={t("writing.description")}>
  <header class="page-head column">
    <h1>{t("writing.title")}</h1>
    <p>{t("writing.description")}</p>
  </header>
  {[...years].map(([year, items]) => (
    <section class="year column hang">
      <h2 class="hang-label meta">{year}</h2>
      <PostList items={items} locale={locale} />
    </section>
  ))}
</BaseLayout>

<style>
  .year {
    border-top: 1px solid var(--color-border);
  }
  .year + .year {
    margin-top: var(--spacing-line);
  }
  h2 {
    padding-top: 0.25rem;
  }
  @media (min-width: 64rem) {
    h2 {
      padding-top: calc(var(--spacing-line) / 2);
    }
  }
</style>
