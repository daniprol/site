---
import PageHeader from "@/components/ui/PageHeader.astro";
import PostList from "@/components/ui/PostList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getPosts(locale);
const years = Map.groupBy(posts, ({ post }) => post.data.date.getFullYear());
// Index numbers run across years, newest highest.
let remaining = posts.length;
const groups = [...years].map(([year, items]) => {
  const startAt = remaining;
  remaining -= items.length;
  return { year, items, startAt };
});
---

<BaseLayout locale={locale} title={t("writing.title")} description={t("writing.description")}>
  <PageHeader index="01" title={t("writing.title")} description={t("writing.description")} />
  {groups.map(({ year, items, startAt }) => (
    <section class="grid-page">
      <h2 class="pt-5 text-title font-bold tracking-(--tracking-title) tabular-nums md:col-span-3">{year}</h2>
      <div class="md:col-span-9 md:pt-1">
        <PostList items={items} locale={locale} startAt={startAt} />
      </div>
    </section>
  ))}
</BaseLayout>
