---
import PageHead from "@/components/ui/PageHead.astro";
import PostList from "@/components/ui/PostList.astro";
import Sheet from "@/components/ui/Sheet.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getPosts(locale);
const years = Map.groupBy(posts, ({ post }) => post.data.date.getFullYear());
---

<BaseLayout locale={locale} title={t("writing.title")} description={t("writing.description")}>
  <PageHead title={t("writing.title")} description={t("writing.description")} />
  <Sheet>
    {[...years].map(([year, items]) => (
      <section class="year">
        <h2 class="dymo">{year}</h2>
        <PostList items={items} locale={locale} />
      </section>
    ))}
  </Sheet>
</BaseLayout>

<style>
  .year + .year {
    margin-top: 3rem;
  }
  h2 {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    rotate: -1.5deg;
  }
</style>
