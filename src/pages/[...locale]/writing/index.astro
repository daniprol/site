---
import PageHead from "@/components/ui/PageHead.astro";
import PostList from "@/components/ui/PostList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = await getPosts(locale);
const years = Map.groupBy(posts, ({ post }) => post.data.date.getFullYear());
let count = 0;
---

<BaseLayout locale={locale} title={t("writing.title")} description={t("writing.description")}>
  <PageHead title={t("writing.title")} description={t("writing.description")} index="01">
    <span slot="aside">{posts.length}</span>
  </PageHead>
  {[...years].map(([year, items]) => {
    const start = count + 1;
    count += items.length;
    return (
      <section class="pb-10">
        <h2 class="wrap label border-t border-border pt-3 pb-1">{year}</h2>
        <PostList items={items} locale={locale} start={start} />
      </section>
    );
  })}
</BaseLayout>
