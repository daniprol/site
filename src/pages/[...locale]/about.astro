---
import PageHeader from "@/components/ui/PageHeader.astro";
import Section from "@/components/ui/Section.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { education, experience, site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t("about.title")} description={`${site.name}, ${site.role}.`}>
  <PageHeader title={t("about.title")} />
  <div class="rail mt-6">
    <div class="prose-site prose">
      <p>
        I'm a software and AI engineer based in {site.location}. I studied mathematics and economics, then spent the
        last few years building full-stack products and AI systems. TODO: write this in your own words, and translate it
        in a per-locale file if you want.
      </p>
    </div>
  </div>

  <Section title={t("about.experience")}>
    <ul class="rows">
      {experience.map((job) => (
        <li class="reveal grid gap-1 py-3.5 sm:grid-cols-[1fr_auto] sm:gap-6">
          <div>
            <p class="font-medium tracking-[-0.011em]">
              {job.role} <span class="text-faint">·</span> {job.company}
            </p>
            <p class="mt-1 text-[0.9375rem] text-pretty text-muted">{job.summary}</p>
          </div>
          <span class="meta -order-1 sm:order-none sm:pt-1">{job.period}</span>
        </li>
      ))}
    </ul>
  </Section>

  <Section title={t("about.education")}>
    <ul class="rows">
      {education.map((item) => (
        <li class="reveal grid gap-1 py-3.5 sm:grid-cols-[1fr_auto] sm:gap-6">
          <p>
            <span class="font-medium tracking-[-0.011em]">{item.degree}</span>
            <span class="block text-[0.9375rem] text-muted">{item.school}</span>
          </p>
          {item.period && <span class="meta -order-1 sm:order-none sm:pt-1">{item.period}</span>}
        </li>
      ))}
    </ul>
  </Section>

  <Section title={t("about.contact")}>
    <p class="py-3.5">
      <a href={`mailto:${site.email}`} class="link">
        {site.email}
      </a>
    </p>
  </Section>
</BaseLayout>
