---
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { education, experience, site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t("about.title")} description={`${site.name}, ${site.role}.`}>
  <h1 class="mt-12 text-2xl font-semibold">{t("about.title")}</h1>
  <div class="prose-site prose mt-6">
    <p>
      I'm a software and AI engineer based in {site.location}. I studied mathematics and economics, then spent the last
      few years building full-stack products and AI systems. TODO: write this in your own words, and translate it in a
      per-locale file if you want.
    </p>
  </div>

  <section class="mt-14">
    <h2 class="mb-4 text-sm font-medium text-muted">{t("about.experience")}</h2>
    <ul class="divide-y divide-border">
      {experience.map((job) => (
        <li class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <span class="font-mono text-xs text-muted sm:pt-1">{job.period}</span>
          <div>
            <p class="font-medium">
              {job.role} · {job.company}
            </p>
            <p class="mt-1 text-muted">{job.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14">
    <h2 class="mb-4 text-sm font-medium text-muted">{t("about.education")}</h2>
    <ul class="divide-y divide-border">
      {education.map((item) => (
        <li class="grid gap-1 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
          <span class="font-mono text-xs text-muted sm:pt-1">{item.period}</span>
          <p>
            {item.degree} · <span class="text-muted">{item.school}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14">
    <h2 class="mb-4 text-sm font-medium text-muted">{t("about.contact")}</h2>
    <p>
      <a href={`mailto:${site.email}`} class="text-accent">
        {site.email}
      </a>
    </p>
  </section>
</BaseLayout>
