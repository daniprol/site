---
import PageHeader from "@/components/ui/PageHeader.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { education, experience, site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t("about.title")} description={`${site.name}, ${site.role}.`}>
  <PageHeader title={t("about.title")} />
  <div class="frame">
    <div class="prose-site prose md:ml-[11rem]">
      <p>
        I'm a software and AI engineer based in {site.location}. I studied mathematics and economics, then spent the
        last few years building full-stack products and AI systems. TODO: write this in your own words, and translate it
        in a per-locale file if you want.
      </p>
    </div>
  </div>

  <section class="frame mt-20">
    <h2 class="label mb-3 text-accent uppercase">{t("about.experience")}</h2>
    <ul class="border-b border-border">
      {experience.map((job) => (
        <li class="cv-row">
          <span class="label pt-1 text-muted">{job.period}</span>
          <div>
            <p class="cv-title">{job.role}</p>
            <p class="label mt-1 text-accent uppercase">{job.company}</p>
            <p class="mt-3 max-w-xl text-muted">{job.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="frame mt-16">
    <h2 class="label mb-3 text-accent uppercase">{t("about.education")}</h2>
    <ul class="border-b border-border">
      {education.map((item) => (
        <li class="cv-row">
          <span class="label pt-1 text-muted">{item.period}</span>
          <div>
            <p class="cv-title">{item.degree}</p>
            <p class="label mt-1 text-muted uppercase">{item.school}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="frame mt-16">
    <h2 class="label mb-3 text-accent uppercase">{t("about.contact")}</h2>
    <p class="border-t border-border pt-4 md:ml-[11rem]">
      <a href={`mailto:${site.email}`} class="link text-xl">
        {site.email}
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .cv-row {
    display: grid;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 48rem) {
    .cv-row {
      grid-template-columns: 9rem 1fr;
      gap: 2rem;
    }
  }
  .cv-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 750;
    font-stretch: 88%;
    line-height: 1.1;
  }
</style>
