---
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { education, experience, site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t("about.title")} description={`${site.name}, ${site.role}.`}>
  <header class="page-head column">
    <h1>{t("about.title")}</h1>
  </header>
  <div class="prose-site">
    <p>
      I'm a software and AI engineer based in {site.location}. I studied mathematics and economics, then spent the last
      few years building full-stack products and AI systems. TODO: write this in your own words, and translate it in a
      per-locale file if you want.
    </p>
  </div>

  <section class="column block">
    <h2 class="meta">{t("about.experience")}</h2>
    <ul>
      {experience.map((job) => (
        <li class="row hang">
          <span class="hang-label meta">{job.period}</span>
          <p class="what">
            {job.role}, <em>{job.company}</em>
          </p>
          <p class="detail">{job.summary}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="column block">
    <h2 class="meta">{t("about.education")}</h2>
    <ul>
      {education.map((item) => (
        <li class="row hang">
          {item.period && <span class="hang-label meta">{item.period}</span>}
          <p class="what">
            {item.degree}, <em>{item.school}</em>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="column block">
    <h2 class="meta">{t("about.contact")}</h2>
    <p class="contact">
      <a href={`mailto:${site.email}`} class="link">
        {site.email}
      </a>
    </p>
  </section>
</BaseLayout>

<style>
  .block {
    margin-top: calc(var(--spacing-line) * 2);
  }
  h2 {
    border-bottom: 1px solid var(--color-border);
  }
  .row {
    padding-block: calc(var(--spacing-line) / 2);
  }
  .row + .row {
    border-top: 1px solid var(--color-faint);
  }
  .row .hang-label {
    display: block;
  }
  .detail {
    color: var(--color-muted);
  }
  .contact {
    padding-top: calc(var(--spacing-line) / 2);
  }
  @media (min-width: 64rem) {
    .row .hang-label {
      top: calc(var(--spacing-line) / 2);
      width: 8rem;
    }
  }
</style>
