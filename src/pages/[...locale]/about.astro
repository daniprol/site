---
import LogRow from "@/components/ui/LogRow.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import Section from "@/components/ui/Section.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { education, experience, site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t("about.title")} description={`${site.name}, ${site.role}.`}>
  <PageHeader index={4} title={t("about.title")} />

  <!-- The one place the sheet speaks in first person: larger, looser, no apparatus. -->
  <div class="rail-grid">
    <p class="label hidden text-muted lg:block lg:pt-2">{site.shortName}</p>
    <div class="max-w-(--width-content) text-xl leading-normal text-pretty sm:text-[1.375rem]">
      <p>
        I'm a software and AI engineer based in {site.location}. I studied mathematics and economics, then spent the
        last few years building full-stack products and AI systems. TODO: write this in your own words, and translate it
        in a per-locale file if you want.
      </p>
    </div>
  </div>

  <Section index={1} title={t("about.experience")}>
    <ul class="divide-y divide-rule">
      {experience.map((job) => (
        <LogRow period={job.period}>
          <p class="font-medium">
            {job.role} <span class="text-muted">· {job.company}</span>
          </p>
          <p class="mt-1 text-[0.9375rem] text-muted">{job.summary}</p>
        </LogRow>
      ))}
    </ul>
  </Section>

  <Section index={2} title={t("about.education")}>
    <ul class="divide-y divide-rule">
      {education.map((item) => (
        <LogRow period={item.period}>
          <p>
            {item.degree} <span class="text-muted">· {item.school}</span>
          </p>
        </LogRow>
      ))}
    </ul>
  </Section>

  <Section index={3} title={t("about.contact")}>
    <p class="py-4">
      <a
        href={`mailto:${site.email}`}
        class="group inline-flex min-h-11 items-center gap-2 text-lg font-medium break-all underline decoration-signal decoration-1 underline-offset-[0.25em] hover:text-signal sm:text-xl"
      >
        {site.email}
        <span class="step-arrow text-signal" aria-hidden="true">
          →
        </span>
      </a>
    </p>
  </Section>
</BaseLayout>
