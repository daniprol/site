---
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { education, experience, site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout locale={locale} title={t("about.title")} description={`${site.name}, ${site.role}.`}>
  <h1 class="mt-10 text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] sm:mt-16">{t("about.title")}</h1>
  <div class="prose-site prose mt-6">
    <p>
      I'm a software and AI engineer based in {site.location}. I studied mathematics and economics, then spent the last
      few years building full-stack products and AI systems. TODO: write this in your own words, and translate it in a
      per-locale file if you want.
    </p>
  </div>

  <section class="mt-14">
    <h2 class="mb-2 text-[0.9375rem] font-semibold">{t("about.experience")}</h2>
    <ul>
      {experience.map((job) => (
        <li class="grid gap-1 border-t border-border py-4 first:border-t-0 sm:grid-cols-[6.5rem_1fr] sm:gap-4">
          <span class="meta sm:pt-[0.3rem]">{job.period}</span>
          <div>
            <p class="font-semibold">
              {job.role} · {job.company}
            </p>
            <p class="mt-1 text-[0.9375rem] leading-relaxed text-muted">{job.summary}</p>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14">
    <h2 class="mb-2 text-[0.9375rem] font-semibold">{t("about.education")}</h2>
    <ul>
      {education.map((item) => (
        <li class="grid gap-1 border-t border-border py-4 first:border-t-0 sm:grid-cols-[6.5rem_1fr] sm:gap-4">
          <span class="meta sm:pt-[0.3rem]">{item.period}</span>
          <p>
            {item.degree} · <span class="text-muted">{item.school}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-14">
    <h2 class="mb-2 text-[0.9375rem] font-semibold">{t("about.contact")}</h2>
    <p>
      <a href={`mailto:${site.email}`} class="link">
        {site.email}
      </a>
    </p>
  </section>
</BaseLayout>
