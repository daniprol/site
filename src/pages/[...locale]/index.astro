---
import PostList from "@/components/ui/PostList.astro";
import ProjectList from "@/components/ui/ProjectList.astro";
import Section from "@/components/ui/Section.astro";
import SnackList from "@/components/ui/SnackList.astro";
import { localeParams, localePath, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getProjects, getSnacks } from "@/lib/content";
import { site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).slice(0, 3);
const snacks = (await getSnacks()).slice(0, 3);
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout locale={locale} description={`${site.name}, ${site.role}.`}>
  <section class="intro">
    <div class="column">
      <h1>{site.name}</h1>
      <p class="meta role">
        {site.role} · {site.location}
      </p>
      <p class="lead">{t("home.intro")}</p>
    </div>
    <aside class="now" aria-label={t("home.now")}>
      <p class="meta">{t("home.now")}</p>
      <p>{site.now}</p>
    </aside>
  </section>

  <Section title={t("home.latestWriting")} href={localePath(locale, "/writing")} linkLabel={t("home.viewAll")}>
    <PostList items={posts} locale={locale} />
  </Section>

  <Section title={t("home.latestSnacks")} href={localePath(locale, "/snacks")} linkLabel={t("home.viewAll")}>
    <SnackList items={snacks} locale={locale} />
  </Section>

  <Section title={t("home.selectedProjects")} href={localePath(locale, "/projects")} linkLabel={t("home.viewAll")}>
    <ProjectList items={projects} locale={locale} />
  </Section>
</BaseLayout>

<style>
  .intro {
    padding-top: calc(var(--spacing-line) * 2);
  }
  h1 {
    font-size: var(--text-title);
    line-height: 1.1;
    letter-spacing: -0.014em;
  }
  .role {
    margin-top: 0.25rem;
    line-height: 1.25rem;
  }
  .lead {
    margin-top: var(--spacing-line);
    font-size: var(--text-lead);
    line-height: 2rem;
    text-wrap: pretty;
  }
  /* "Now" is a note in the writer's margin: under the intro on phones, beside it on wide screens. */
  .now {
    margin-top: var(--spacing-line);
    padding-left: 0.875rem;
    border-left: 1px solid var(--color-accent);
    font-size: 0.9375rem;
    line-height: 1.4375rem;
    color: var(--color-muted);
  }
  .now .meta {
    line-height: 1.4375rem;
    color: var(--color-fg);
  }
  @media (min-width: 40rem) {
    h1 {
      font-size: 3.25rem;
    }
  }
  @media (min-width: 64rem) {
    .intro {
      display: grid;
      grid-template-columns: var(--spacing-measure) var(--spacing-margin);
      column-gap: var(--spacing-gap);
      align-items: end;
    }
    .now {
      margin-top: 0;
      margin-bottom: 0.25rem;
    }
  }
</style>
