---
import Hero from "@/components/site/Hero.astro";
import PostList from "@/components/ui/PostList.astro";
import ProjectList from "@/components/ui/ProjectList.astro";
import Section from "@/components/ui/Section.astro";
import SnackList from "@/components/ui/SnackList.astro";
import Ticker from "@/components/ui/Ticker.astro";
import { localeParams, localePath, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getProjects, getSnacks } from "@/lib/content";
import { site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).slice(0, 3);
const allSnacks = await getSnacks();
const snacks = allSnacks.slice(0, 5);
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
const ticker = allSnacks.map((s) => ({ text: s.data.title, tag: t(`verdict.${s.data.verdict}`) }));
---

<BaseLayout locale={locale} description={`${site.name}, ${site.role}.`}>
  <Hero locale={locale} />
  <Ticker items={ticker} label={t("nav.snacks")} />

  <Section title={t("nav.writing")} index="01" href={localePath(locale, "/writing")} linkLabel={t("home.viewAll")}>
    <PostList items={posts} locale={locale} />
  </Section>

  <Section
    title={t("nav.projects")}
    index="02"
    href={localePath(locale, "/projects")}
    linkLabel={t("home.viewAll")}
    tone="band"
  >
    <ProjectList items={projects} locale={locale} />
  </Section>

  <Section title={t("nav.snacks")} index="03" href={localePath(locale, "/snacks")} linkLabel={t("home.viewAll")}>
    <SnackList items={snacks} locale={locale} />
  </Section>
</BaseLayout>
