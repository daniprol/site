---
import PostList from "@/components/ui/PostList.astro";
import ProjectList from "@/components/ui/ProjectList.astro";
import Section from "@/components/ui/Section.astro";
import SnackList from "@/components/ui/SnackList.astro";
import { localeParams, localePath, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getProjects, getSnacks } from "@/lib/content";
import { site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).slice(0, 3);
const snacks = (await getSnacks()).slice(0, 5);
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout locale={locale} description={`${site.name}, ${site.role}.`}>
  <section class="rail intro">
    <div>
      <h1 class="text-xl font-semibold tracking-[-0.02em]">{site.name}</h1>
      <p class="text-muted">{site.role}</p>
      <p class="meta mt-1">{site.location}</p>
    </div>
  </section>

  <section class="rail mt-8 rail:mt-10">
    <h2 class="rail-label eyebrow now-label">
      <span class="now-dot" aria-hidden="true"></span>
      {t("home.now")}
    </h2>
    <p class="max-w-[34rem] text-pretty">{site.now}</p>
  </section>

  <Section title={t("home.latestWriting")} href={localePath(locale, "/writing")} linkLabel={t("home.viewAll")}>
    <PostList items={posts} locale={locale} />
  </Section>

  <Section title={t("home.latestSnacks")} href={localePath(locale, "/snacks")} linkLabel={t("home.viewAll")}>
    <SnackList items={snacks} locale={locale} />
  </Section>

  <Section title={t("home.selectedProjects")} href={localePath(locale, "/projects")} linkLabel={t("home.viewAll")}>
    <ProjectList items={projects} locale={locale} />
  </Section>
</BaseLayout>

<style>
  .intro {
    margin-top: 2.5rem;
  }
  @media (min-width: 70rem) {
    .intro {
      margin-top: 4rem;
    }
  }
  .now-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* A slow "live" pulse: the only animated thing at rest on the site. */
  .now-dot {
    position: relative;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-accent);
  }
  .now-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-accent);
    animation: pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes pulse {
    from {
      opacity: 0.6;
      transform: scale(1);
    }
    70%,
    to {
      opacity: 0;
      transform: scale(3);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-dot::after {
      animation: none;
      opacity: 0;
    }
  }
</style>
