---
import FieldHero from "@/components/field/FieldHero.astro";
import PostList from "@/components/ui/PostList.astro";
import ProjectList from "@/components/ui/ProjectList.astro";
import Section from "@/components/ui/Section.astro";
import SnackList from "@/components/ui/SnackList.astro";
import { localeParams, localePath, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getProjects, getSnacks } from "@/lib/content";
import { site } from "@/site.config";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const posts = (await getPosts(locale)).slice(0, 3);
const snacks = (await getSnacks()).slice(0, 5);
const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 3);
---

<BaseLayout locale={locale} description={`${site.name}, ${site.role}.`} overlay>
  <h1 class="sr-only">{site.name}</h1>
  <FieldHero name={site.shortName} caption={t("hero.caption")} hint={t("hero.hint")}>
    <p class="max-w-md text-lg leading-snug font-medium md:text-xl">
      {site.role} <span class="opacity-75">— {site.location}</span>
    </p>
  </FieldHero>

  <section class="frame mt-16 grid gap-3 md:mt-28 md:grid-cols-[9rem_1fr] md:gap-8">
    <p class="label pt-2 text-accent uppercase">{t("home.now")}</p>
    <p class="max-w-4xl text-2xl leading-tight font-medium text-balance md:text-5xl md:leading-[1.08]">{site.now}</p>
  </section>

  <Section title={t("nav.writing")} index={1} href={localePath(locale, "/writing")} linkLabel={t("home.viewAll")}>
    <PostList items={posts} locale={locale} />
  </Section>

  <Section title={t("nav.snacks")} index={2} href={localePath(locale, "/snacks")} linkLabel={t("home.viewAll")}>
    <SnackList items={snacks} locale={locale} />
  </Section>

  <Section title={t("nav.projects")} index={3} href={localePath(locale, "/projects")} linkLabel={t("home.viewAll")}>
    <ProjectList items={projects} locale={locale} />
  </Section>
</BaseLayout>
