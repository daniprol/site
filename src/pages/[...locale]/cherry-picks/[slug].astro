---
import { render } from "astro:content";

import Cherry from "@/components/cherry/Cherry.astro";
import CherryDefs from "@/components/cherry/CherryDefs.astro";
import PickMotion from "@/components/cherry/PickMotion.astro";
import PickResult from "@/components/cherry/PickResult.astro";
import Verdict from "@/components/cherry/Verdict.astro";
import DateTime from "@/components/ui/DateTime.astro";
import { DEFAULT_LOCALE, LOCALES, localePath, useTranslations, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPicks, type Pick } from "@/lib/content";

export async function getStaticPaths() {
  const picks = await getPicks();
  return LOCALES.flatMap((locale) =>
    picks.map((pick, index) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: pick.slug },
      // The list is newest first, so the newer pick is the one before.
      props: { locale, pick, newer: picks[index - 1], older: picks[index + 1] },
    })),
  );
}

interface Props {
  locale: Locale;
  pick: Pick;
  newer?: Pick;
  older?: Pick;
}
const { locale, pick, newer, older } = Astro.props;
const t = useTranslations(locale);
const { entry, slug, hash, mainHash, seconds, number } = pick;
const { title, take, verdict, kind, date } = entry.data;
const { Content } = await render(entry);
const neighbours = [
  { pick: newer, label: `← ${t("picks.newer")}`, align: "" },
  { pick: older, label: `${t("picks.older")} →`, align: "sm:text-right sm:flex-row-reverse" },
];
---

<BaseLayout
  locale={locale}
  title={title}
  description={take ?? t("picks.description")}
  canonicalPath={localePath(DEFAULT_LOCALE, `/cherry-picks/${slug}`)}
>
  <CherryDefs />
  <article class="mt-6 sm:mt-12" data-verdict={verdict}>
    <p class="flex items-center justify-between font-mono text-xs">
      <a
        href={localePath(locale, "/cherry-picks")}
        class="group -ml-2 inline-flex min-h-11 items-center gap-1.5 px-2 text-muted hover:text-fg"
      >
        <span aria-hidden="true" class="transition-transform group-hover:-translate-x-0.5">
          ←
        </span>
        <span class="marker-hover">{t("picks.title")}</span>
      </a>
      <span class="text-muted">#{String(number).padStart(3, "0")}</span>
    </p>

    <header class="mb-9 sm:mb-10">
      <!-- The cherry hangs from the branch it is on: main once picked, upstream otherwise. -->
      <div class="bough">
        <span class="hero-hang" style={`view-transition-name: pick-cherry-${slug}`}>
          <Cherry verdict={verdict} leaf />
        </span>
        <p class="refs">
          <span class="ref">
            <span class="text-muted">upstream</span> {hash}
          </span>
          {verdict === "keep" && (
            <>
              <span aria-hidden="true" class="text-cherry">
                →
              </span>
              <span class="ref ref-main">
                <span class="opacity-70">main</span> {mainHash}
              </span>
            </>
          )}
        </p>
      </div>
      <h1 class="text-[1.9rem] leading-[1.15] font-bold tracking-[-0.02em] text-balance sm:text-[2.4rem]" lang="en">
        <span style={`view-transition-name: pick-title-${slug}`} class="inline-block">
          {title}
        </span>
      </h1>
      {take && (
        <p class="mt-3 text-[1.12rem] leading-relaxed text-pretty text-muted" lang="en">
          {take}
        </p>
      )}
      <p class="mt-4 flex flex-wrap items-baseline gap-x-2 font-mono text-xs text-muted">
        <Verdict verdict={verdict} locale={locale} />
        <span aria-hidden="true">·</span>
        <span>{kind}</span>
        <span aria-hidden="true">·</span>
        <DateTime date={date} locale={locale} />
        <span aria-hidden="true">·</span>
        <span>{t("picks.readSeconds", { n: seconds })}</span>
      </p>
    </header>

    <div class="pick-prose prose-site prose" lang="en">
      <Content />
    </div>

    <PickResult pick={pick} locale={locale} />

    {(newer || older) && (
      <nav class="mt-10 grid gap-2 sm:grid-cols-2" aria-label={t("picks.more")}>
        {neighbours.map(({ pick: other, label, align }) =>
          other ? (
            <a
              href={localePath(locale, `/cherry-picks/${other.slug}`)}
              class:list={[
                "group flex items-center gap-3 rounded-lg border border-border px-4 py-3 transition-colors hover:bg-surface",
                align,
              ]}
              data-pick-link
            >
              <span class="hang shrink-0" style={`view-transition-name: pick-cherry-${other.slug}`}>
                <Cherry verdict={other.entry.data.verdict} class="h-10 w-8" />
              </span>
              <span class="min-w-0">
                <span class="block font-mono text-xs text-muted">{label}</span>
                <span class="marker-hover mt-0.5 inline font-semibold" lang="en">
                  {other.entry.data.title}
                </span>
              </span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          ),
        )}
      </nav>
    )}
  </article>
  <PickMotion />
</BaseLayout>

<style>
  .bough {
    position: relative;
    height: 4.5rem;
    margin-top: 0.5rem;
    margin-bottom: 0.6rem;
    border-top: 2px solid var(--color-fg);
  }
  /* Not picked: the cherry is still on upstream, the dashed line. */
  article:not([data-verdict="keep"]) .bough {
    border-top-color: transparent;
    background: repeating-linear-gradient(
        to right,
        color-mix(in oklch, var(--color-muted) 60%, transparent) 0 5px,
        transparent 5px 9px
      )
      top / 100% 2px no-repeat;
  }
  /* The node the stem grows from. */
  .bough::before {
    content: "";
    position: absolute;
    top: -7px;
    left: 6px;
    z-index: 1;
    width: 12px;
    height: 12px;
    border: 2px solid var(--color-bg);
    border-radius: 999px;
    background: var(--color-fg);
  }
  article[data-verdict="maybe"] .bough::before {
    background: var(--color-rainier-deep);
  }
  article[data-verdict="drop"] .bough::before {
    border-color: var(--color-muted);
    border-style: dashed;
    border-width: 1.5px;
    background: var(--color-bg);
  }
  .hero-hang {
    position: absolute;
    top: -9px;
    left: 0;
    display: block;
    transform-origin: 12px 8px;
    view-transition-class: pick-cherry;
  }
  .hang {
    display: block;
    view-transition-class: pick-cherry;
  }
  .refs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.45rem;
    padding-top: 0.7rem;
    padding-left: 3.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .ref {
    padding: 0.12rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: var(--color-surface);
    white-space: nowrap;
  }
  .ref-main {
    border-color: transparent;
    background: var(--color-fg);
    color: var(--color-bg);
  }

  /* Arriving: the cherry lands on its branch and swings to rest. */
  @keyframes land-swing {
    0% {
      transform: rotate(0deg);
    }
    20% {
      transform: rotate(13deg);
    }
    45% {
      transform: rotate(-8deg);
    }
    68% {
      transform: rotate(4deg);
    }
    86% {
      transform: rotate(-1.5deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    article:not([data-verdict="drop"]) .hero-hang {
      animation: land-swing 1.5s ease-in-out 0.5s;
    }
  }

  /* Pictures sit in the column like prints: rounded, with a hairline. */
  .pick-prose :global(img) {
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    margin-block: 1.6em;
  }
</style>
