---
import Machine from "@/components/snacks/Machine.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import SnackList from "@/components/ui/SnackList.astro";
import Verdict from "@/components/ui/Verdict.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { MACHINE_SLOTS, getShelvedSnacks } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const snacks = await getShelvedSnacks();
const older = snacks.slice(MACHINE_SLOTS);
const VERDICTS = ["keep", "maybe", "drop"] as const;
---

<BaseLayout locale={locale} title={t("snacks.title")} description={t("snacks.description")}>
  <PageHeader title={t("snacks.title")} description={t("snacks.description")}>
    <!-- Legend: the verdicts as set membership. -->
    <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm">
      {VERDICTS.map((verdict) => (
        <span class="inline-flex items-center gap-2">
          <Verdict verdict={verdict} locale={locale} variant="symbol" srLabel={false} />
          <Verdict verdict={verdict} locale={locale} />
        </span>
      ))}
    </p>
  </PageHeader>

  <Machine items={snacks} locale={locale} />

  {older.length > 0 && (
    <section aria-labelledby="older-snacks" data-pagefind-ignore>
      <h2 id="older-snacks" class="mb-1 text-[1.05rem] font-bold tracking-tight">
        {t("snacks.older")}
      </h2>
      <SnackList items={older} locale={locale} />
    </section>
  )}
</BaseLayout>
