---
import PageHeader from "@/components/ui/PageHeader.astro";
import SnackList from "@/components/ui/SnackList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSnacks } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const snacks = await getSnacks();
---

<BaseLayout locale={locale} title={t("snacks.title")} description={t("snacks.description")}>
  <PageHeader index={2} title={t("snacks.title")} description={t("snacks.description")} count={snacks.length} />
  <div class="border-t border-rule-strong">
    <SnackList items={snacks} locale={locale} header />
  </div>
</BaseLayout>
