---
import PageHead from "@/components/ui/PageHead.astro";
import SnackList from "@/components/ui/SnackList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSnacks } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const snacks = await getSnacks();
---

<BaseLayout locale={locale} title={t("snacks.title")} description={t("snacks.description")}>
  <PageHead title={t("snacks.title")} description={t("snacks.description")} aside={String(snacks.length)} />
  <div class="wrap">
    <SnackList items={snacks} locale={locale} />
  </div>
</BaseLayout>
