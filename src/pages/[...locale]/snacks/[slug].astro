---
/**
 * /snacks/<slug> (and /es/…, /gl/…): one entry, laid out like a pull request. From top to bottom: a strip
 * of the history on its side (GraphStrip), title and state, the review as the opening comment
 * (TimelineComment), pros and cons as a diff (DiffBlock), the first verdict and every later change as
 * timeline events, visitors' comments, the verdict as the merge box (MergeBox), and links to the older and
 * newer entries (EntryNav). The CSS for all of it is the .pr-* part of styles/commits.css.
 *
 * Plain HTML first; the script at the bottom adds swipe, keys, the picture viewer and the sliding strip.
 */
import { render } from "astro:content";

import DiffBlock from "@/components/commits/DiffBlock.astro";
import EntryNav from "@/components/commits/EntryNav.astro";
import GraphStrip from "@/components/commits/GraphStrip.astro";
import Lightbox from "@/components/commits/Lightbox.astro";
import MergeBox from "@/components/commits/MergeBox.astro";
import StatePill from "@/components/commits/StatePill.astro";
import TimelineComment from "@/components/commits/TimelineComment.astro";
import TimelineEvent from "@/components/commits/TimelineEvent.astro";
import ZoomImage from "@/components/commits/ZoomImage.astro";
import CommentsSection from "@/components/site/CommentsSection.astro";
import ShareButton from "@/components/site/ShareButton.astro";
import { DEFAULT_LOCALE, LOCALES, localePath, useTranslations, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  BASE_BRANCH,
  COMPARE_PATH,
  SECTION_PATH,
  commitPath,
  fillHtml,
  getCommits,
  laterLabel,
  refHtml,
  type Commit,
} from "@/lib/commits";
import { readingSeconds } from "@/lib/content";
import { formatDate, isoDate } from "@/lib/format";
import { site } from "@/site.config";

/**
 * Astro builds one HTML file per entry and language. getStaticPaths lists them all at build time: `params`
 * fills the [...locale] and [slug] parts of the URL (undefined locale = English, no prefix), and `props` is
 * what the page below receives as Astro.props.
 */
export async function getStaticPaths() {
  const commits = await getCommits();
  return LOCALES.flatMap((locale) =>
    commits.map((commit, index) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: commit.slug },
      props: { locale, commit, commits, newer: commits[index - 1], older: commits[index + 1] },
    })),
  );
}

interface Props {
  locale: Locale;
  commit: Commit;
  commits: Commit[];
  newer: Commit | undefined;
  older: Commit | undefined;
}
const { locale, commit, commits, newer, older } = Astro.props;
const t = useTranslations(locale);
const { snack, slug, number, sha, branch, host, verdict, firstVerdict, updates } = commit;
const { title, take, kind, date, pros, cons, cover, gallery, url } = snack.data;
const { Content } = await render(snack);

const who = site.socials.github.split("/").at(-1) ?? site.shortName;
// Pieces of HTML the translated headlines are built from ("{who} merged 1 commit into {base} from {head}").
const headlineParts = {
  who: `<b>${who}</b>`,
  base: refHtml(BASE_BRANCH),
  head: refHtml(branch),
  sha: refHtml(sha),
  date: `<time datetime="${isoDate(date)}">${formatDate(date, locale, "short")}</time>`,
};
const compareHref = `${localePath(locale, COMPARE_PATH)}?a=${slug}`;
const hasDiff = pros.length + cons.length > 0;
const description = take ?? `${title}: ${t(`commits.state.${verdict}`)}.`;
const listHref = localePath(locale, SECTION_PATH);
---

<BaseLayout
  locale={locale}
  title={`${title} · ${t("commits.title")}`}
  description={description}
  canonicalPath={locale === DEFAULT_LOCALE ? undefined : localePath(DEFAULT_LOCALE, commitPath(slug))}
  image={`${SECTION_PATH}/og/${slug}.png`}
>
  <article class="pr mt-6 sm:mt-12" data-verdict={verdict} data-cm-entry>
    <nav class="pr-crumb" aria-label={t("commits.title")}>
      <a
        href={listHref}
        class="group -ml-2 inline-flex min-h-11 items-center gap-2 px-2 hover:text-fg"
        data-cm-nav="up"
      >
        <span aria-hidden="true">←</span>
        <span class="marker-hover">{t("commits.back")}</span>
        <kbd class="kbd" aria-hidden="true">
          esc
        </kbd>
      </a>
      <span aria-hidden="true">
        {BASE_BRANCH} / #{number}
      </span>
    </nav>

    <GraphStrip commits={commits} current={commit} locale={locale} />

    <div class="pr-panel">
      <header>
        <h1 class="pr-title">
          <span data-cm-vt style={`view-transition-name:cm-title-${slug}`}>
            {title}
          </span>{" "}
          <span class="pr-num">#{number}</span>
        </h1>
        {take && <p class="pr-take">{take}</p>}
        <p class="pr-status">
          <StatePill verdict={verdict} locale={locale} variant="solid" />
          <span set:html={fillHtml(t(`commits.headline.${verdict}`), headlineParts)} />
        </p>
        <nav class="pr-tabs" aria-label={title}>
          <a href="#conversation" aria-current="true">
            {t("commits.tab.conversation")}
          </a>
          {hasDiff && (
            <a href="#files">
              {t("commits.tab.files")}
              <span class="pr-count">{pros.length + cons.length}</span>
            </a>
          )}
          <span class="pr-share">
            <ShareButton locale={locale} title={title} variant="snack" diffId={hasDiff ? "files" : undefined} />
          </span>
        </nav>
      </header>

      <div class="pr-timeline">
        <TimelineComment id="conversation" headHtml={fillHtml(t("commits.commented"), headlineParts)} label={kind}>
          {cover && (
            <figure class="pr-cover">
              <ZoomImage src={cover.src} alt={cover.alt} caption={cover.caption} width={640} />
              {cover.caption && <figcaption>{cover.caption}</figcaption>}
            </figure>
          )}
          <div class="prose-site prose" lang="en">
            <Content />
          </div>
          {gallery.length > 0 && (
            <ul class="pr-gallery" aria-label={t("commits.gallery")}>
              {gallery.map((picture) => (
                <li>
                  <ZoomImage src={picture.src} alt={picture.alt} caption={picture.caption} width={220} aspect={4 / 3} />
                </li>
              ))}
            </ul>
          )}
        </TimelineComment>

        {hasDiff && (
          <DiffBlock file={`${BASE_BRANCH}/${slug}.md`} hunk={title} pros={pros} cons={cons} locale={locale} />
        )}

        <TimelineEvent
          verdict={firstVerdict}
          sentenceHtml={fillHtml(t(`commits.event.${firstVerdict}`), headlineParts)}
          date={date}
          locale={locale}
          extra={t("commits.readTime", { n: readingSeconds(snack.body) })}
        />

        {/* Each later change of verdict: a follow-up comment explaining why, then the event itself. */}
        {updates.map((update) => (
          <>
            <TimelineComment
              id={update.anchor}
              class="pr-update"
              headHtml={fillHtml(t("commits.followedUp"), { ...headlineParts, when: laterLabel(update.days, t) })}
            >
              <p class="pr-note">{update.note}</p>
            </TimelineComment>
            <TimelineEvent
              verdict={update.verdict}
              sentenceHtml={fillHtml(t(`commits.event.${update.verdict}`), headlineParts)}
              date={update.date}
              locale={locale}
            />
          </>
        ))}

        <CommentsSection locale={locale} layout="timeline" composerSlot="comments-composer" />

        <MergeBox verdict={verdict} locale={locale} url={url} host={host} />
        {hasDiff && (
          <p class="pr-compare">
            <a class="cm-textlink" href={compareHref} data-astro-prefetch="false">
              {t("compare.with")}
            </a>
          </p>
        )}
        <div id="comments-composer" />
      </div>

      <EntryNav older={older} newer={newer} locale={locale} />
    </div>
  </article>
  <Lightbox locale={locale} />
</BaseLayout>

<script>
  import "@/scripts/commits/setup";
</script>
