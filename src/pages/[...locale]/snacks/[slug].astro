---
/**
 * One entry, laid out like a pull request: a strip of the history on its side, title and state,
 * the review as the opening comment, pros and cons as a diff, and the verdict as the merge box.
 * Plain HTML first; the script at the bottom adds swipe, keys and the sliding strip.
 */
import { render } from "astro:content";

import DiffBlock from "@/components/commits/DiffBlock.astro";
import GraphStrip from "@/components/commits/GraphStrip.astro";
import Lightbox from "@/components/commits/Lightbox.astro";
import StateIcon from "@/components/commits/StateIcon.astro";
import StatePill from "@/components/commits/StatePill.astro";
import ZoomImage from "@/components/commits/ZoomImage.astro";
import CommentsSection from "@/components/site/CommentsSection.astro";
import Logo from "@/components/site/Logo.astro";
import ShareButton from "@/components/site/ShareButton.astro";
import DateTime from "@/components/ui/DateTime.astro";
import { DEFAULT_LOCALE, LOCALES, localePath, useTranslations, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  BASE_BRANCH,
  COMPARE_PATH,
  SECTION_PATH,
  TOOLBOX_PATH,
  commitPath,
  fillHtml,
  getCommits,
  laterLabel,
  readingSeconds,
  refHtml,
  type Commit,
} from "@/lib/commits";
import { formatDate, isoDate } from "@/lib/format";
import { site } from "@/site.config";

export async function getStaticPaths() {
  const commits = await getCommits();
  return LOCALES.flatMap((locale) =>
    commits.map((commit, index) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: commit.slug },
      props: { locale, commit, commits, newer: commits[index - 1], older: commits[index + 1] },
    })),
  );
}

interface Props {
  locale: Locale;
  commit: Commit;
  commits: Commit[];
  newer: Commit | undefined;
  older: Commit | undefined;
}
const { locale, commit, commits, newer, older } = Astro.props;
const t = useTranslations(locale);
const { snack, slug, number, sha, branch, host, verdict, firstVerdict, updates } = commit;
const { title, take, kind, date, pros, cons, cover, gallery, url } = snack.data;
const { Content } = await render(snack);

const who = site.socials.github.split("/").at(-1) ?? site.shortName;
const parts = {
  who: `<b>${who}</b>`,
  base: refHtml(BASE_BRANCH),
  head: refHtml(branch),
  sha: refHtml(sha),
  date: `<time datetime="${isoDate(date)}">${formatDate(date, locale, "short")}</time>`,
};
const compareHref = `${localePath(locale, COMPARE_PATH)}?a=${slug}`;
const hasDiff = pros.length + cons.length > 0;
const description = take ?? `${title}: ${t(`commits.state.${verdict}`)}.`;
const listHref = localePath(locale, SECTION_PATH);
---

<BaseLayout
  locale={locale}
  title={`${title} · ${t("commits.title")}`}
  description={description}
  canonicalPath={locale === DEFAULT_LOCALE ? undefined : localePath(DEFAULT_LOCALE, commitPath(slug))}
  image={`${SECTION_PATH}/og/${slug}.png`}
>
  <article class="pr mt-6 sm:mt-12" data-verdict={verdict} data-cm-entry>
    <nav class="pr-crumb" aria-label={t("commits.title")}>
      <a
        href={listHref}
        class="group -ml-2 inline-flex min-h-11 items-center gap-2 px-2 hover:text-fg"
        data-cm-nav="up"
      >
        <span aria-hidden="true">←</span>
        <span class="marker-hover">{t("commits.back")}</span>
        <kbd class="kbd" aria-hidden="true">
          esc
        </kbd>
      </a>
      <span aria-hidden="true">
        {BASE_BRANCH} / #{number}
      </span>
    </nav>

    <GraphStrip commits={commits} current={commit} locale={locale} />

    <div class="pr-panel">
      <header>
        <h1 class="pr-title">
          <span data-cm-vt style={`view-transition-name:cm-title-${slug}`}>
            {title}
          </span>{" "}
          <span class="pr-num">#{number}</span>
        </h1>
        {take && <p class="pr-take">{take}</p>}
        <p class="pr-status">
          <StatePill verdict={verdict} locale={locale} variant="solid" />
          <span set:html={fillHtml(t(`commits.headline.${verdict}`), parts)} />
        </p>
        <nav class="pr-tabs" aria-label={title}>
          <a href="#conversation" aria-current="true">
            {t("commits.tab.conversation")}
          </a>
          {hasDiff && (
            <a href="#files">
              {t("commits.tab.files")}
              <span class="pr-count">{pros.length + cons.length}</span>
            </a>
          )}
          <span class="pr-share">
            <ShareButton locale={locale} title={title} variant="snack" diffId={hasDiff ? "files" : undefined} />
          </span>
        </nav>
      </header>

      <div class="pr-timeline">
        <section id="conversation" class="pr-comment">
          <span class="pr-avatar" aria-hidden="true">
            <Logo markOnly />
          </span>
          <div class="pr-box">
            <p class="pr-comment-head">
              <span class="pr-mini" aria-hidden="true">
                <Logo markOnly class="h-full w-full" />
              </span>
              <span class="who" set:html={fillHtml(t("commits.commented"), parts)} />
              <span class="pr-label">{kind}</span>
            </p>
            <div class="pr-body">
              {cover && (
                <figure class="pr-cover">
                  <ZoomImage src={cover.src} alt={cover.alt} caption={cover.caption} width={640} />
                  {cover.caption && <figcaption>{cover.caption}</figcaption>}
                </figure>
              )}
              <div class="prose-site prose" lang="en">
                <Content />
              </div>
              {gallery.length > 0 && (
                <ul class="pr-gallery" aria-label={t("commits.gallery")}>
                  {gallery.map((picture) => (
                    <li>
                      <ZoomImage
                        src={picture.src}
                        alt={picture.alt}
                        caption={picture.caption}
                        width={220}
                        aspect={4 / 3}
                      />
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </section>

        {hasDiff && (
          <DiffBlock file={`${BASE_BRANCH}/${slug}.md`} hunk={title} pros={pros} cons={cons} locale={locale} />
        )}

        <p class="pr-event" data-verdict={firstVerdict}>
          <span class="pr-badge" aria-hidden="true">
            <StateIcon verdict={firstVerdict} />
          </span>
          <span>
            <Fragment set:html={fillHtml(t(`commits.event.${firstVerdict}`), parts)} />
            <span aria-hidden="true"> · </span>
            <DateTime date={date} locale={locale} format="short" />
            <span aria-hidden="true"> · </span>
            {t("commits.readTime", { n: readingSeconds(snack.body) })}
          </span>
        </p>

        {updates.map((update) => (
          <>
            <section id={update.anchor} class="pr-comment pr-update">
              <span class="pr-avatar" aria-hidden="true">
                <Logo markOnly />
              </span>
              <div class="pr-box">
                <p class="pr-comment-head">
                  <span class="pr-mini" aria-hidden="true">
                    <Logo markOnly class="h-full w-full" />
                  </span>
                  <span
                    class="who"
                    set:html={fillHtml(t("commits.followedUp"), { ...parts, when: laterLabel(update.days, t) })}
                  />
                </p>
                <div class="pr-body">
                  <p class="pr-note">{update.note}</p>
                </div>
              </div>
            </section>
            <p class="pr-event" data-verdict={update.verdict}>
              <span class="pr-badge" aria-hidden="true">
                <StateIcon verdict={update.verdict} />
              </span>
              <span>
                <Fragment set:html={fillHtml(t(`commits.event.${update.verdict}`), parts)} />
                <span aria-hidden="true"> · </span>
                <DateTime date={update.date} locale={locale} format="short" />
              </span>
            </p>
          </>
        ))}

        <CommentsSection locale={locale} layout="timeline" composerSlot="comments-composer" />

        <aside class="pr-box pr-merge" aria-label={t(`commits.state.${verdict}`)}>
          <span class="pr-merge-tile" aria-hidden="true">
            <StateIcon verdict={verdict} />
          </span>
          <p>
            <strong class="pr-merge-title block">{t(`commits.state.${verdict}`)}</strong>
            <span class="pr-merge-text block">
              {t(`commits.box.${verdict}`)}{" "}
              {verdict === "keep" && (
                <a class="cm-textlink" href={localePath(locale, TOOLBOX_PATH)}>
                  {t("toolbox.link")}
                </a>
              )}
            </span>
          </p>
          {url && host && (
            <a class="pr-visit" href={url} rel="noopener">
              {t("commits.visit", { host })}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </aside>
        {hasDiff && (
          <p class="pr-compare">
            <a class="cm-textlink" href={compareHref} data-astro-prefetch="false">
              {t("compare.with")}
            </a>
          </p>
        )}
        <div id="comments-composer" />
      </div>

      {(older || newer) && (
        <nav class="pr-nav" aria-label={t("commits.title")}>
          {older ? (
            <a href={localePath(locale, commitPath(older.slug))} class="group" data-cm-nav="older">
              <span class="dir">
                <span aria-hidden="true">←</span> {t("commits.older")} · #{older.number}
                <kbd class="kbd" aria-hidden="true">
                  j
                </kbd>
              </span>
              <span class="marker-hover mt-1 inline font-semibold">{older.snack.data.title}</span>
            </a>
          ) : (
            <span class="hidden sm:block" />
          )}
          {newer && (
            <a href={localePath(locale, commitPath(newer.slug))} class="group newer" data-cm-nav="newer">
              <span class="dir">
                <kbd class="kbd" aria-hidden="true">
                  k
                </kbd>
                {t("commits.newer")} · #{newer.number} <span aria-hidden="true">→</span>
              </span>
              <span class="marker-hover mt-1 inline font-semibold">{newer.snack.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </article>
  <Lightbox locale={locale} />
</BaseLayout>

<script>
  import "@/scripts/commit-entry";
</script>
