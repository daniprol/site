---
import { render } from "astro:content";

import CutoutArt from "@/components/desk/CutoutArt.astro";
import Sheet from "@/components/ui/Sheet.astro";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects, type Project } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return LOCALES.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const { Content } = await render(project);
const { title, summary, stack, repo, url, year } = project.data;
---

<BaseLayout locale={locale} title={title} description={summary} canonicalPath={`/projects/${project.id}`}>
  <Sheet as="article" margin>
    <div class="art">
      <CutoutArt seed={project.id} />
    </div>
    <header class="head">
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <p class="meta label">
        <span>{year}</span>
        <span>{stack.join(" · ")}</span>
        {repo && <a href={repo}>Source ↗</a>}
        {url && <a href={url}>Live ↗</a>}
      </p>
    </header>
    <div class="prose-site prose" lang="en">
      <Content />
    </div>
  </Sheet>
</BaseLayout>

<style>
  .art {
    margin-bottom: 2rem;
    box-shadow: var(--shadow-paper);
    rotate: -0.6deg;
  }
  .head {
    margin-bottom: 2.5rem;
  }
  h1 {
    font-size: clamp(3rem, 14vw, 6rem);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.88;
    letter-spacing: -0.04em;
  }
  .summary {
    max-width: 36rem;
    margin-top: 1rem;
    font-size: 1.1875rem;
    color: var(--color-ink-soft);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: 1rem;
    color: var(--color-ink-soft);
  }
  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-link);
  }
</style>
