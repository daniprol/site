---
import { render } from "astro:content";

import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects, type Project } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return LOCALES.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const { Content } = await render(project);
const { title, summary, stack, repo, url, year } = project.data;
---

<BaseLayout locale={locale} title={title} description={summary} canonicalPath={`/projects/${project.id}`}>
  <article class="mt-10 sm:mt-16">
    <header class="mb-10 sm:mb-12">
      <p class="flex flex-wrap gap-x-2 font-mono text-xs text-muted">
        <span>{year}</span>
        <span aria-hidden="true">·</span>
        <span class="text-accent">{stack.join(" · ")}</span>
      </p>
      <h1 class="mt-3 font-mono text-[2rem] leading-tight font-semibold tracking-[-0.02em] sm:text-[2.4rem]">
        {title}
      </h1>
      <p class="mt-4 text-[1.1rem] leading-relaxed text-pretty text-muted">{summary}</p>
      {(repo || url) && (
        <p class="mt-3 -ml-2 flex flex-wrap text-sm font-semibold">
          {repo && (
            <a href={repo} class="group inline-flex min-h-11 items-center px-2 text-accent">
              <span class="marker-hover">Source ↗</span>
            </a>
          )}
          {url && (
            <a href={url} class="group inline-flex min-h-11 items-center px-2 text-accent">
              <span class="marker-hover">Live ↗</span>
            </a>
          )}
        </p>
      )}
    </header>
    <div class="prose-site prose" lang="en">
      <Content />
    </div>
  </article>
</BaseLayout>
