---
import { render } from "astro:content";

import ArticleBody from "@/components/ui/ArticleBody.astro";
import ArticleHeader from "@/components/ui/ArticleHeader.astro";
import { DEFAULT_LOCALE, LOCALES, localePath, useTranslations, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects, type Project } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return LOCALES.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const t = useTranslations(locale);
const { Content } = await render(project);
const { title, summary, stack, repo, url, year } = project.data;
const links = [
  repo && { label: t("projects.source"), href: repo },
  url && { label: t("projects.live"), href: url },
].filter((l) => !!l);
---

<BaseLayout locale={locale} title={title} description={summary} canonicalPath={`/projects/${project.id}`}>
  <article>
    <ArticleHeader
      title={title}
      standfirst={summary}
      backHref={localePath(locale, "/projects")}
      backLabel={t("nav.projects")}
      transitionName={`project-title-${project.id}`}
    />
    <ArticleBody lang="en">
      <ul
        slot="aside"
        class="label grid grid-cols-2 gap-x-(--grid-gutter) text-muted lg:grid-cols-1 lg:border-t lg:border-fg"
      >
        <li class="border-b border-border py-2.5 tabular-nums">{year}</li>
        <li class="border-b border-border py-2.5">{stack.join(" / ")}</li>
        {links.map(({ label, href }) => (
          <li class="border-b border-border">
            <a href={href} class="group flex h-11 items-center gap-2 text-fg">
              <span class="wipe group-hover:text-accent">{label}</span>
              <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
      <Content />
    </ArticleBody>
  </article>
</BaseLayout>
