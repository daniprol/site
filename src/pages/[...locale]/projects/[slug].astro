---
import { render } from "astro:content";

import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects, type Project } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return LOCALES.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const { Content } = await render(project);
const { title, summary, stack, repo, url, year } = project.data;
---

<BaseLayout locale={locale} title={title} description={summary} canonicalPath={`/projects/${project.id}`}>
  <article>
    <header class="head column">
      <p class="meta facts">
        <span>{year}</span>
        <span>{stack.join(" · ")}</span>
      </p>
      <h1 transition:name={`project-title-${project.id}`}>{title}</h1>
      <p class="standfirst">{summary}</p>
      {(repo || url) && (
        <p class="meta links">
          {repo && (
            <a href={repo} class="link">
              Source ↗
            </a>
          )}
          {url && (
            <a href={url} class="link">
              Live ↗
            </a>
          )}
        </p>
      )}
    </header>
    <div class="prose-site" lang="en">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: calc(var(--spacing-line) * 2) calc(var(--spacing-line) * 1.5);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
  }
  h1 {
    margin-top: 0.5rem;
    font-size: var(--text-title);
    line-height: 1.1;
    font-style: italic;
    letter-spacing: -0.01em;
  }
  .standfirst {
    margin-top: 1rem;
    font-size: var(--text-lead);
    line-height: 1.95rem;
    color: var(--color-muted);
    text-wrap: pretty;
  }
  .links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.75rem;
  }
  .links a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  @media (min-width: 40rem) {
    h1 {
      font-size: 2.875rem;
    }
  }
</style>
