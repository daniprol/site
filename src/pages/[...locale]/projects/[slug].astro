---
import { render } from "astro:content";

import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects, type Project } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return LOCALES.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const { Content } = await render(project);
const { title, summary, stack, repo, url, year } = project.data;
---

<BaseLayout locale={locale} title={title} description={summary} canonicalPath={`/projects/${project.id}`}>
  <article class="pt-8 sm:pt-14">
    <header class="mb-10 max-w-[40rem]">
      <p class="meta">{year}</p>
      <h1 class="mt-2 text-[2.05rem] leading-[1.12] font-[720] sm:text-[2.6rem]">{title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted sm:text-xl">{summary}</p>
      <p class="meta mt-5 flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>{stack.join(" · ")}</span>
        {repo && (
          <a href={repo} class="link inline-flex min-h-11 items-center">
            Source ↗
          </a>
        )}
        {url && (
          <a href={url} class="link inline-flex min-h-11 items-center">
            Live ↗
          </a>
        )}
      </p>
    </header>
    <div class="prose-site prose" lang="en">
      <Content />
    </div>
  </article>
</BaseLayout>
