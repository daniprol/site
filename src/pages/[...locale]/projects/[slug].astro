---
import { render } from "astro:content";

import { DEFAULT_LOCALE, LOCALES, localePath, useTranslations, type Locale } from "@/i18n";
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import { getProjects, type Project } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return LOCALES.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const { Content } = await render(project);
const { title, summary, stack, repo, url, year } = project.data;
const t = useTranslations(locale);
---

<ReadingLayout
  locale={locale}
  title={title}
  description={summary}
  canonicalPath={`/projects/${project.id}`}
  back={{ href: localePath(locale, "/projects"), label: t("nav.projects") }}
  lang="en"
>
  <Fragment slot="meta">
    <span>{year}</span>
    {stack.map((tech) => (
      <span>/ {tech}</span>
    ))}
  </Fragment>
  <div slot="notice" class="flex flex-col gap-5">
    <p class="max-w-[34ch] text-lg leading-snug">{summary}</p>
    {(repo || url) && (
      <p class="-ml-2 flex">
        {repo && (
          <a href={repo} class="label inv px-2 py-3">
            Source ↗
          </a>
        )}
        {url && (
          <a href={url} class="label inv px-2 py-3">
            Live ↗
          </a>
        )}
      </p>
    )}
  </div>
  <Content />
</ReadingLayout>
