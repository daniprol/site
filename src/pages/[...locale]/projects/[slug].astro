---
import { render } from "astro:content";

import Cover from "@/components/cover/Cover.astro";
import { DEFAULT_LOCALE, LOCALES, useTranslations, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects, type Project } from "@/lib/content";
import { makeCover } from "@/lib/cover";

export async function getStaticPaths() {
  const projects = await getProjects();
  return LOCALES.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const t = useTranslations(locale);
const { Content } = await render(project);
const { title, summary, stack, repo, url, year, order } = project.data;
const { palette } = makeCover(project.id, title);
const links = [
  ...(repo ? [{ label: t("project.source"), href: repo }] : []),
  ...(url ? [{ label: t("project.live"), href: url }] : []),
];
---

<BaseLayout locale={locale} title={title} description={summary} canonicalPath={`/projects/${project.id}`}>
  <article data-palette={palette}>
    <div class="wrap pt-4 md:pt-6">
      <Cover
        slug={project.id}
        title={title}
        kicker={t("cover.project")}
        issue={`${t("cover.issue", { n: String(order).padStart(2, "0") })} · ${year}`}
        dek={summary}
        lines={[stack.join(" · ")]}
        variant="spread"
        as="h1"
        transitionName={`cover-${project.id}`}
      />
    </div>
    <div class="wrap">
      <div class="project-column">
        {links.length > 0 && (
          <ul class="mb-8 flex flex-wrap gap-2">
            {links.map((link) => (
              <li>
                <a href={link.href} class="project-link">
                  {link.label} ↗
                </a>
              </li>
            ))}
          </ul>
        )}
        <div class="prose-site prose" lang="en">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-column {
    max-width: 42rem;
    margin-inline: auto;
    padding-top: 2rem;
  }
  .project-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding-inline: 1.1rem;
    background: var(--field);
    color: var(--ink);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: translate 0.3s var(--ease-out-expo);
  }
  .project-link:hover {
    translate: 0 -3px;
  }
</style>
