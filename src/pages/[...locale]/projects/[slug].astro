---
import { render } from "astro:content";

import { DEFAULT_LOCALE, LOCALES, type Locale } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects, type Project } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getProjects();
  return LOCALES.flatMap((locale) =>
    projects.map((project) => ({
      params: { locale: locale === DEFAULT_LOCALE ? undefined : locale, slug: project.id },
      props: { locale, project },
    })),
  );
}

const { locale, project } = Astro.props as { locale: Locale; project: Project };
const { Content } = await render(project);
const { title, summary, stack, repo, url, year } = project.data;
---

<BaseLayout locale={locale} title={title} description={summary} canonicalPath={`/projects/${project.id}`}>
  <article class="mt-10 sm:mt-16">
    <header class="mb-10">
      <h1 class="text-[2rem] leading-tight font-semibold tracking-[-0.02em] text-balance sm:text-[2.25rem]">{title}</h1>
      <p class="mt-3 text-[1.125rem] leading-relaxed text-pretty text-muted">{summary}</p>
      <p class="meta mt-4 flex flex-wrap gap-x-4 gap-y-1" data-pagefind-ignore>
        <span>{year}</span>
        <span>{stack.join(" · ")}</span>
        {repo && (
          <a href={repo} class="text-accent hover:underline">
            Source ↗
          </a>
        )}
        {url && (
          <a href={url} class="text-accent hover:underline">
            Live ↗
          </a>
        )}
      </p>
    </header>
    <div class="prose-site prose" lang="en">
      <Content />
    </div>
  </article>
</BaseLayout>
