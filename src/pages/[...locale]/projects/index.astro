---
import ProjectList from "@/components/ui/ProjectList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects();
---

<BaseLayout locale={locale} title={t("projects.title")} description={t("projects.description")}>
  <h1 class="mt-10 text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] sm:mt-16">{t("projects.title")}</h1>
  <p class="mt-3 text-pretty text-muted">{t("projects.description")}</p>
  <div class="mt-10">
    <ProjectList items={projects} locale={locale} />
  </div>
</BaseLayout>
