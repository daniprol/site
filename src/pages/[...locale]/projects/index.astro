---
import PageHeader from "@/components/ui/PageHeader.astro";
import ProjectList from "@/components/ui/ProjectList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects();
---

<BaseLayout locale={locale} title={t("projects.title")} description={t("projects.description")}>
  <PageHeader title={t("projects.title")} description={t("projects.description")} />
  <div class="rail mt-8 rail:mt-12">
    <ProjectList items={projects} locale={locale} />
  </div>
</BaseLayout>
