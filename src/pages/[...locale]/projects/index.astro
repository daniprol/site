---
import PageHead from "@/components/ui/PageHead.astro";
import ProjectList from "@/components/ui/ProjectList.astro";
import { localeParams, useTranslations } from "@/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getProjects } from "@/lib/content";

export const getStaticPaths = localeParams;

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = await getProjects();
---

<BaseLayout locale={locale} title={t("projects.title")} description={t("projects.description")}>
  <PageHead title={t("projects.title")} description={t("projects.description")} index="02">
    <span slot="aside">{projects.length}</span>
  </PageHead>
  <div class="tone-band">
    <ProjectList items={projects} locale={locale} />
  </div>
</BaseLayout>
