---
/**
 * The page shell every route uses: <head> (SEO tags, fonts, theme), the header, the page's own content in
 * <slot /> (whatever the page puts between <BaseLayout> and </BaseLayout>), the footer and the search dialog.
 *
 * <ClientRouter /> turns on Astro's client-side navigation: links fetch the next page and swap it in with a
 * view transition instead of a full reload. Scripts therefore run once and must listen for Astro's
 * navigation events (astro:page-load, astro:after-swap) to set up each new page.
 *
 * `data-pagefind-body` on <main> keeps the header, footer and dialogs out of the search index.
 */
import "@/styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Footer from "@/components/site/Footer.astro";
import Header from "@/components/site/Header.astro";
import SearchDialog from "@/components/site/SearchDialog.astro";
import Seo from "@/components/site/Seo.astro";
import ThemeScript from "@/components/site/ThemeScript.astro";
import { withBase, type Locale } from "@/i18n";

interface Props {
  locale: Locale;
  title?: string;
  description: string;
  canonicalPath?: string;
  image?: string;
}

const { locale, ...seo } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="32x32" />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/manifest.webmanifest")} />
    <!-- Browser bar matches the page background. ThemeScript keeps it in sync with the toggle. -->
    <meta name="theme-color" content="#fbfdfe" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f131b" media="(prefers-color-scheme: dark)" />
    <Seo locale={locale} {...seo} />
    <Font cssVariable="--font-atkinson" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-atkinson-mono" />
    <ThemeScript />
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only rounded-md bg-fg px-3 py-2 text-bg focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50"
    >
      Skip to content
    </a>
    <Header locale={locale} />
    <main id="main" class="mx-auto w-full max-w-column flex-1 px-4 sm:px-6" data-pagefind-body>
      <slot />
    </main>
    <Footer locale={locale} />
    <SearchDialog locale={locale} />
  </body>
</html>
