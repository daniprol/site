---
/** The page shell every route uses: <head>, header, main, footer. */
import "@/styles/global.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Footer from "@/components/site/Footer.astro";
import Header from "@/components/site/Header.astro";
import Seo from "@/components/site/Seo.astro";
import ThemeScript from "@/components/site/ThemeScript.astro";
import type { Locale } from "@/i18n";

interface Props {
  locale: Locale;
  title?: string;
  description: string;
  canonicalPath?: string;
}

const { locale, ...seo } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1c1a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-source-serif" preload={[{ style: "normal" }]} />
    <Font cssVariable="--font-plex-mono" />
    <Seo locale={locale} {...seo} />
    <ThemeScript />
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="skip-link meta sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:bg-bg focus:p-2"
    >
      Skip to content
    </a>
    <Header locale={locale} />
    <main id="main" class="sheet" data-pagefind-body>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
