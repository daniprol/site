---
// KaTeX styles only load on pages that can contain math.
import "katex/dist/katex.min.css";
import ArticleBody from "@/components/ui/ArticleBody.astro";
import ArticleHeader from "@/components/ui/ArticleHeader.astro";
import DateTime from "@/components/ui/DateTime.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { getSeries, postSlug, readingTime, type Post } from "@/lib/content";

import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: Locale;
  post: Post;
  slug: string;
  isFallback: boolean;
  canonicalPath?: string | undefined;
}

const { locale, post, slug, isFallback, canonicalPath } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, series } = post.data;
const parts = series ? await getSeries(series) : [];
const index = parts.findIndex((p) => postSlug(p) === slug);
const previous = index > 0 ? parts[index - 1] : undefined;
const next = index >= 0 ? parts[index + 1] : undefined;
const siblings = [
  previous && { label: t("post.previous"), post: previous, arrow: "←" },
  next && { label: t("post.next"), post: next, arrow: "→" },
].filter((s) => !!s);
---

<BaseLayout locale={locale} title={title} description={description} canonicalPath={canonicalPath}>
  <article>
    <ArticleHeader
      title={title}
      standfirst={description}
      backHref={localePath(locale, "/writing")}
      backLabel={t("nav.writing")}
      transitionName={`post-title-${slug}`}
    />
    <ArticleBody lang={post.data.lang}>
      <ul
        slot="aside"
        class="label grid grid-cols-2 gap-x-(--grid-gutter) text-muted lg:grid-cols-1 lg:border-t lg:border-fg"
      >
        <li class="border-b border-border py-2.5">
          <DateTime date={date} locale={locale} />
        </li>
        <li class="border-b border-border py-2.5">{t("post.readingTime", { n: readingTime(post.body) })}</li>
        {series && (
          <li class="col-span-2 border-b border-border py-2.5 text-accent lg:col-span-1">
            {t("post.series", { n: index + 1 })}
          </li>
        )}
        {isFallback && (
          <li class="col-span-2 border-b border-border py-2.5 normal-case lg:col-span-1" lang={locale}>
            {t("post.onlyInEnglish")}
          </li>
        )}
      </ul>
      <slot />
      {siblings.length > 0 && (
        <nav slot="after" aria-label={t("post.series", { n: index + 1 })} class="mt-20 md:col-span-12">
          <ul class="grid border-t-2 border-fg md:grid-cols-2 md:gap-x-(--grid-gutter)">
            {siblings.map(({ label, post: sibling, arrow }) => (
              <li
                class:list={["border-b border-border md:border-b-0", arrow === "→" && "md:col-start-2 md:text-right"]}
              >
                <a href={localePath(locale, `/writing/${postSlug(sibling)}`)} class="group block py-6">
                  <span class="label text-muted">{arrow === "←" ? `${arrow} ${label}` : `${label} ${arrow}`}</span>
                  <span class="mt-2 block text-title font-semibold tracking-(--tracking-title) text-balance transition-colors group-hover:text-accent">
                    {sibling.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </ArticleBody>
  </article>
</BaseLayout>
