---
// KaTeX styles only load on pages that can contain math.
import "katex/dist/katex.min.css";
import DateTime from "@/components/ui/DateTime.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { getSeries, postSlug, readingTime, type Post } from "@/lib/content";

import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: Locale;
  post: Post;
  slug: string;
  isFallback: boolean;
  canonicalPath?: string | undefined;
}

const { locale, post, slug, isFallback, canonicalPath } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, series } = post.data;
const parts = series ? await getSeries(series) : [];
const index = parts.findIndex((p) => postSlug(p) === slug);
const previous = index > 0 ? parts[index - 1] : undefined;
const next = index >= 0 ? parts[index + 1] : undefined;
---

<BaseLayout locale={locale} title={title} description={description} canonicalPath={canonicalPath}>
  <article class="mt-10 sm:mt-16">
    <header class="mb-10">
      <p class="meta flex flex-wrap gap-x-2" data-pagefind-ignore>
        <DateTime date={date} locale={locale} />
        <span aria-hidden="true">·</span>
        <span>{t("post.readingTime", { n: readingTime(post.body) })}</span>
        {series && (
          <>
            <span aria-hidden="true">·</span>
            <span>{t("post.series", { n: index + 1 })}</span>
          </>
        )}
      </p>
      <h1
        class="mt-3 text-[2rem] leading-[1.15] font-semibold tracking-[-0.025em] text-balance sm:text-[2.5rem]"
        transition:name={`post-title-${slug}`}
      >
        {title}
      </h1>
      <p class="mt-4 text-[1.125rem] leading-relaxed text-pretty text-muted">{description}</p>
      {isFallback && (
        <p class="mt-5 border-l-2 border-ochre pl-3 text-[0.9375rem] text-muted" lang={locale}>
          {t("post.onlyInEnglish")}
        </p>
      )}
    </header>
    <div class="prose-site prose" lang={post.data.lang}>
      <slot />
    </div>
    {(previous || next) && (
      <nav class="mt-16 grid gap-2 border-t border-border pt-4 sm:grid-cols-2">
        {previous ? (
          <a href={localePath(locale, `/writing/${postSlug(previous)}`)} class="cursorline py-3">
            <span class="meta block">← {t("post.previous")}</span>
            <span class="font-semibold">{previous.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={localePath(locale, `/writing/${postSlug(next)}`)} class="cursorline py-3 sm:text-right">
            <span class="meta block">{t("post.next")} →</span>
            <span class="font-semibold">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
