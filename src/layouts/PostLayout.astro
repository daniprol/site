---
// KaTeX styles only load on pages that can contain math.
import "katex/dist/katex.min.css";
import DateTime from "@/components/ui/DateTime.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { getSeries, postSlug, readingTime, type Post } from "@/lib/content";

import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: Locale;
  post: Post;
  slug: string;
  isFallback: boolean;
  canonicalPath?: string | undefined;
}

const { locale, post, slug, isFallback, canonicalPath } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, series } = post.data;
const parts = series ? await getSeries(series) : [];
const index = parts.findIndex((p) => postSlug(p) === slug);
const previous = index > 0 ? parts[index - 1] : undefined;
const next = index >= 0 ? parts[index + 1] : undefined;
---

<BaseLayout locale={locale} title={title} description={description} canonicalPath={canonicalPath}>
  <article class="rail article">
    <header class="article-title">
      <h1
        class="text-xl font-semibold tracking-[-0.022em] text-balance sm:text-2xl"
        transition:name={`post-title-${slug}`}
      >
        {title}
      </h1>
      {isFallback && (
        <p class="notice" lang={locale}>
          {t("post.onlyInEnglish")}
        </p>
      )}
    </header>

    <!-- Metadata: a line under the title on phones, a sticky column in the left rail on wide screens. -->
    <p class="rail-label article-meta meta">
      <DateTime date={date} locale={locale} />
      <span>{t("post.readingTime", { n: readingTime(post.body) })}</span>
      {series && <span>{t("post.series", { n: index + 1 })}</span>}
    </p>

    <div class="prose-site prose" lang={post.data.lang}>
      <slot />
    </div>

    {(previous || next) && (
      <nav class="pager" aria-label={t("post.series", { n: index + 1 })}>
        {previous ? (
          <a href={localePath(locale, `/writing/${postSlug(previous)}`)} class="row pager-link">
            <span class="meta block">← {t("post.previous")}</span>
            <span class="mt-1 block font-medium">{previous.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a href={localePath(locale, `/writing/${postSlug(next)}`)} class="row pager-link text-right">
            <span class="meta block">{t("post.next")} →</span>
            <span class="mt-1 block font-medium">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    margin-top: 2.5rem;
    counter-reset: figure;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1rem;
    row-gap: 0.25rem;
    margin-block: 0.75rem 2.5rem;
  }
  .notice {
    margin-top: 1rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
    background: var(--color-surface-sunken);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .pager-link {
    padding-inline: 0;
  }

  @media (min-width: 70rem) {
    .article {
      margin-top: 4rem;
    }
    .article-title {
      grid-row: 1;
      margin-bottom: 2.5rem;
    }
    /* The rail column: date, reading time, series, stacked and sticky. */
    .rail > .article-meta {
      grid-row: 1 / span 3;
      flex-direction: column;
      margin: 0;
      padding-top: 0.5rem;
    }
  }
</style>
