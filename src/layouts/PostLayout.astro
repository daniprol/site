---
// KaTeX styles only load on pages that can contain math.
import "katex/dist/katex.min.css";
import Ball from "@/components/ui/Ball.astro";
import DateTime from "@/components/ui/DateTime.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { getSeries, postSlug, readingTime, type Post } from "@/lib/content";

import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: Locale;
  post: Post;
  slug: string;
  isFallback: boolean;
  canonicalPath?: string | undefined;
}

const { locale, post, slug, isFallback, canonicalPath } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, series } = post.data;
const parts = series ? await getSeries(series) : [];
const index = parts.findIndex((p) => postSlug(p) === slug);
const previous = index > 0 ? parts[index - 1] : undefined;
const next = index >= 0 ? parts[index + 1] : undefined;
---

<BaseLayout locale={locale} title={title} description={description} canonicalPath={canonicalPath}>
  <article class="pt-8 sm:pt-14">
    <header class="mb-10 max-w-[40rem]">
      <a
        href={localePath(locale, "/writing")}
        class="group -my-2 inline-flex min-h-11 items-center gap-1.5 text-[0.95rem] text-muted hover:text-fg"
      >
        <span class="transition-transform duration-300 ease-bounce group-hover:-translate-x-1" aria-hidden="true">
          ←
        </span>
        {t("post.backToWriting")}
      </a>
      <h1
        class="mt-4 text-[2.05rem] leading-[1.12] font-[720] text-balance sm:text-[2.6rem]"
        transition:name={`post-title-${slug}`}
      >
        {title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted sm:text-xl">{description}</p>
      <p class="meta mt-5 flex flex-wrap items-center gap-x-2 gap-y-1">
        <DateTime date={date} locale={locale} />
        <span aria-hidden="true">·</span>
        <span>{t("post.readingTime", { n: readingTime(post.body) })}</span>
        {series && (
          <>
            <span aria-hidden="true">·</span>
            <span class="text-accent">{t("post.series", { n: index + 1 })}</span>
          </>
        )}
      </p>
      {isFallback && (
        <p class="mt-5 rounded-lg bg-surface px-4 py-3 text-[0.95rem] text-muted" lang={locale}>
          {t("post.onlyInEnglish")}
        </p>
      )}
    </header>
    <div class="prose-site prose" lang={post.data.lang}>
      <slot />
    </div>
    <!-- End mark: the ball comes to rest. -->
    <p class="mt-14 flex max-w-[40rem] justify-center">
      <Ball size={14} />
      <span class="sr-only">{t("post.end")}</span>
    </p>
    {(previous || next) && (
      <nav class="mt-8 grid gap-3 sm:grid-cols-2">
        {previous && (
          <a
            href={localePath(locale, `/writing/${postSlug(previous)}`)}
            class="group rounded-xl border border-border p-4 hover:border-(--color-ball)"
          >
            <span class="meta">← {t("post.previous")}</span>
            <span class="mt-1 block font-[620]" style="font-family: var(--font-display)">
              {previous.data.title}
            </span>
          </a>
        )}
        {next && (
          <a
            href={localePath(locale, `/writing/${postSlug(next)}`)}
            class="group rounded-xl border border-border p-4 text-right hover:border-(--color-ball) sm:col-start-2"
          >
            <span class="meta">{t("post.next")} →</span>
            <span class="mt-1 block font-[620]" style="font-family: var(--font-display)">
              {next.data.title}
            </span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
