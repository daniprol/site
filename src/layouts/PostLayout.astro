---
// KaTeX styles only load on pages that can contain math.
import "katex/dist/katex.min.css";
import DateTime from "@/components/ui/DateTime.astro";
import MetaList from "@/components/ui/MetaList.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { getSeries, postSlug, readingTime, type Post } from "@/lib/content";

import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: Locale;
  post: Post;
  slug: string;
  isFallback: boolean;
  canonicalPath?: string | undefined;
}

const { locale, post, slug, isFallback, canonicalPath } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, series, tags } = post.data;
const parts = series ? await getSeries(series) : [];
const index = parts.findIndex((p) => postSlug(p) === slug);
const previous = index > 0 ? parts[index - 1] : undefined;
const next = index >= 0 ? parts[index + 1] : undefined;
---

<BaseLayout locale={locale} title={title} description={description} canonicalPath={canonicalPath}>
  <article class="pt-10 sm:pt-16">
    <header class="rail-grid gap-6 border-b border-rule-strong pb-8 sm:pb-10 lg:gap-8">
      <MetaList class="order-2 lg:order-1 lg:pt-3">
        <li>
          <DateTime date={date} locale={locale} format="iso" />
        </li>
        <li>{t("post.readingTime", { n: readingTime(post.body) })}</li>
        {series && <li class="text-signal">{t("post.series", { n: index + 1 })}</li>}
      </MetaList>
      <div class="order-1 lg:order-2">
        <h1
          class="max-w-[22ch] text-title font-semibold tracking-[-0.025em] text-balance sm:text-display"
          transition:name={`post-title-${slug}`}
        >
          {title}
        </h1>
        <p class="mt-4 max-w-(--width-content) text-muted sm:text-lg">{description}</p>
        {isFallback && (
          <p class="mt-5 border-l-2 border-signal pl-3 font-mono text-data text-muted" lang={locale}>
            {t("post.onlyInEnglish")}
          </p>
        )}
      </div>
    </header>

    <div class="rail-grid mt-8 sm:mt-10">
      <aside class="hidden lg:block">
        {tags.length > 0 && (
          <ul class="flex flex-col gap-1 pt-1.5 font-mono text-data text-muted">
            {tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )}
      </aside>
      <div class="prose-site prose" lang={post.data.lang}>
        <slot />
      </div>
    </div>

    {(previous || next) && (
      <nav class="mt-16 grid border-y border-rule-strong sm:grid-cols-2 lg:ml-[calc(var(--width-rail)+2rem)]">
        {previous ? (
          <a
            href={localePath(locale, `/writing/${postSlug(previous)}`)}
            class="group tick-row flex flex-col gap-1 py-4 hover:bg-surface sm:px-4"
          >
            <span class="label text-muted">← {t("post.previous")}</span>
            <span class="font-medium group-hover:text-signal">{previous.data.title}</span>
          </a>
        ) : (
          <span class="hidden sm:block" />
        )}
        {next && (
          <a
            href={localePath(locale, `/writing/${postSlug(next)}`)}
            class="group tick-row flex flex-col gap-1 border-rule py-4 not-first:border-t hover:bg-surface sm:items-end sm:px-4 sm:text-right sm:not-first:border-t-0 sm:not-first:border-l"
          >
            <span class="label text-muted">{t("post.next")} →</span>
            <span class="font-medium group-hover:text-signal">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>
