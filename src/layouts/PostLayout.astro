---
// KaTeX styles only load on pages that can contain math.
import "katex/dist/katex.min.css";
import DateTime from "@/components/ui/DateTime.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { getSeries, postSlug, readingTime, type Post } from "@/lib/content";

import ReadingLayout from "./ReadingLayout.astro";

interface Props {
  locale: Locale;
  post: Post;
  slug: string;
  isFallback: boolean;
  canonicalPath?: string | undefined;
}

const { locale, post, slug, isFallback, canonicalPath } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, series } = post.data;
const parts = series ? await getSeries(series) : [];
const index = parts.findIndex((p) => postSlug(p) === slug);
const previous = index > 0 ? parts[index - 1] : undefined;
const next = index >= 0 ? parts[index + 1] : undefined;
---

<ReadingLayout
  locale={locale}
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  back={{ href: localePath(locale, "/writing"), label: t("nav.writing") }}
  transitionName={`post-title-${slug}`}
  lang={post.data.lang}
>
  <Fragment slot="meta">
    <DateTime date={date} locale={locale} />
    <span>{t("post.readingTime", { n: readingTime(post.body) })}</span>
    {series && <span>{t("post.series", { n: index + 1 })}</span>}
  </Fragment>
  {isFallback && (
    <p slot="notice" class="label" lang={locale}>
      {t("post.onlyInEnglish")}
    </p>
  )}
  <slot />
  {(previous || next) && (
    <nav slot="after" class="series-nav grid sm:grid-cols-2">
      {previous ? (
        <a href={localePath(locale, `/writing/${postSlug(previous)}`)} class="inv block p-5 sm:p-6">
          <span class="label block">← {t("post.previous")}</span>
          <span class="series-title">{previous.data.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a href={localePath(locale, `/writing/${postSlug(next)}`)} class="inv block p-5 sm:p-6 sm:text-right">
          <span class="label block">{t("post.next")} →</span>
          <span class="series-title">{next.data.title}</span>
        </a>
      )}
    </nav>
  )}
</ReadingLayout>

<style>
  .series-nav {
    border-block: 1px solid var(--color-rule);
  }
  .series-nav a {
    --color-invert: var(--color-mark);
    --color-invert-fg: var(--color-ink);
  }
  .series-title {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 90%;
    font-size: 1.375rem;
    line-height: 1.05;
  }
</style>
