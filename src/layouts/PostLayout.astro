---
// KaTeX styles only load on pages that can contain math.
import "katex/dist/katex.min.css";
import DateTime from "@/components/ui/DateTime.astro";
import FieldBanner from "@/components/ui/FieldBanner.astro";
import { localePath, useTranslations, type Locale } from "@/i18n";
import { getSeries, postSlug, readingTime, type Post } from "@/lib/content";

import BaseLayout from "./BaseLayout.astro";

interface Props {
  locale: Locale;
  post: Post;
  slug: string;
  isFallback: boolean;
  canonicalPath?: string | undefined;
}

const { locale, post, slug, isFallback, canonicalPath } = Astro.props;
const t = useTranslations(locale);
const { title, description, date, series } = post.data;
const parts = series ? await getSeries(series) : [];
const index = parts.findIndex((p) => postSlug(p) === slug);
const previous = index > 0 ? parts[index - 1] : undefined;
const next = index >= 0 ? parts[index + 1] : undefined;
---

<BaseLayout locale={locale} title={title} description={description} canonicalPath={canonicalPath}>
  <article>
    <FieldBanner seed={slug} locale={locale} />
    <header class="frame pt-10 pb-10 md:pt-16 md:pb-14">
      <div class="article-offset">
        <p class="label flex flex-wrap gap-x-4 gap-y-1 text-muted uppercase">
          <DateTime date={date} locale={locale} />
          <span>{t("post.readingTime", { n: readingTime(post.body) })}</span>
          {series && <span class="text-accent">{t("post.series", { n: index + 1 })}</span>}
        </p>
        <h1 class="post-heading mt-5" transition:name={`post-title-${slug}`}>
          {title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-muted md:text-xl">{description}</p>
        {isFallback && (
          <p class="label mt-6 inline-block border border-border px-3 py-2" lang={locale}>
            {t("post.onlyInEnglish")}
          </p>
        )}
      </div>
    </header>
    <div class="frame">
      <div class="article-offset prose-site prose" lang={post.data.lang}>
        <slot />
      </div>
    </div>
    {(previous || next) && (
      <nav class="frame mt-20">
        <div class="article-offset grid gap-px border-y border-border sm:grid-cols-2">
          {previous ? (
            <a href={localePath(locale, `/writing/${postSlug(previous)}`)} class="series-link">
              <span class="label text-muted uppercase">← {t("post.previous")}</span>
              <span>{previous.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={localePath(locale, `/writing/${postSlug(next)}`)} class="series-link sm:text-right">
              <span class="label text-muted uppercase">{t("post.next")} →</span>
              <span>{next.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .post-heading {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 10vw, 5.25rem);
    font-weight: 800;
    font-stretch: 82%;
    line-height: 0.98;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  @media (min-width: 64rem) {
    .article-offset {
      margin-left: 11rem;
    }
  }
  .series-link {
    display: grid;
    gap: 0.4rem;
    padding: 1.25rem 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 90%;
    font-size: 1.125rem;
    line-height: 1.15;
  }
  .series-link:hover {
    color: var(--color-accent);
  }
</style>
